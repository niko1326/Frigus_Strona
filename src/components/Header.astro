---
import { BRANDS } from '../config/brands';
import { SITE, PHONE_TEL } from '../config/site';
import { labels, navLinks, routes } from '../i18n/content';
import IconPhone from './icons/IconPhone.astro';
import IconWrench from './icons/IconWrench.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const normalize = (path: string): string => {
  if (path !== '/' && path.endsWith('/')) {
    return path.slice(0, -1);
  }

  return path;
};

const current = normalize(currentPath);

// Pozycja "Narzędzia" rozwija panel z markami i samą stroną narzędzi.
const menuItems = [
  ...BRANDS.map((brand) => ({
    href: brand.href,
    wordmark: brand.name,
    label: brand.linkLabel,
    icon: false
  })),
  {
    href: routes.tools,
    wordmark: null,
    label: 'Narzędzia',
    icon: true
  }
];

const menuPaths = menuItems.map((item) => normalize(item.href));
const menuActive = menuPaths.includes(current);
---

<header class="site-header">
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <div class="container header-bar">
    <a class="brand" href="/" aria-label={`${SITE.brandName} - strona główna`}>
      {SITE.brandName}<span class="brand-dot" aria-hidden="true"></span>
    </a>
    <nav class="site-nav" aria-label={labels.navAria}>
      <ul>
        {
          navLinks.map((link) => {
            const active = current === normalize(link.href);

            if (link.href === routes.tools) {
              return (
                <li class="nav-has-menu">
                  <button
                    type="button"
                    class={`nav-trigger${menuActive ? ' is-active' : ''}`}
                    id="nav-tools-trigger"
                    aria-expanded="false"
                    aria-controls="nav-tools-menu"
                    aria-haspopup="true"
                    data-nav-trigger
                  >
                    {link.label}
                    <svg class="nav-caret" viewBox="0 0 16 16" aria-hidden="true">
                      <path
                        d="M4 6.5 8 10.5 12 6.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                </li>
              );
            }

            return (
              <li>
                <a class={active ? 'is-active' : ''} href={link.href}>
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a class="header-cta" href={`tel:${PHONE_TEL}`} aria-label={labels.phoneAria}>
        <IconPhone class="icon" />
        <span>{labels.freeQuote}</span>
      </a>
    </div>
  </div>

  <div
    class="nav-menu"
    id="nav-tools-menu"
    role="group"
    aria-labelledby="nav-tools-trigger"
    data-nav-menu
    hidden
  >
    <ul>
      {
        menuItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav-menu-link${current === normalize(item.href) ? ' is-active' : ''}`}
              aria-label={item.label}
            >
              <span class="nav-menu-mark">
                {item.icon ? (
                  <>
                    <IconWrench class="nav-menu-icon" />
                    <span class="nav-menu-text">{item.label}</span>
                  </>
                ) : (
                  <span class="nav-menu-wordmark">{item.wordmark}</span>
                )}
              </span>
              <svg class="nav-menu-arrow" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M4 12h15M13 6l6 6-6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-nav-trigger]');
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]');

  if (trigger && menu) {
    const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a'));

    /*
      Pasek nawigacji przewija się poziomo (overflow-x), więc panel osadzony
      w środku byłby przycięty. Trzymamy go poza paskiem i pozycjonujemy
      na sztywno względem okna, przyklejony do przycisku.
    */
    const place = () => {
      const box = trigger.getBoundingClientRect();
      const width = menu.offsetWidth;
      const margin = 12;
      const maxLeft = window.innerWidth - width - margin;
      const left = Math.max(margin, Math.min(box.left, maxLeft));

      menu.style.top = `${box.bottom + 8}px`;
      menu.style.left = `${left}px`;
    };

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    const open = () => {
      menu.hidden = false;
      place();
      // klasa dopiero po ustawieniu pozycji, żeby animacja startowała w miejscu
      requestAnimationFrame(() => menu.classList.add('is-open'));
      trigger.setAttribute('aria-expanded', 'true');
    };

    const close = (returnFocus = false) => {
      menu.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      window.setTimeout(() => {
        if (!isOpen()) menu.hidden = true;
      }, 160);
      if (returnFocus) trigger.focus();
    };

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      if (isOpen()) close();
      else open();
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (!isOpen()) open();
        links[0]?.focus();
      }
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close(true);
        return;
      }

      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      const index = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next =
        event.key === 'ArrowDown'
          ? (index + 1) % links.length
          : (index - 1 + links.length) % links.length;
      links[next]?.focus();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) close(true);
    });

    document.addEventListener('click', (event) => {
      if (!isOpen()) return;
      const target = event.target as Node;
      if (!menu.contains(target) && !trigger.contains(target)) close();
    });

    // Panel jest przyklejony do przycisku, więc musi nadążać za układem.
    window.addEventListener('resize', () => (isOpen() ? place() : undefined));
    window.addEventListener('scroll', () => (isOpen() ? place() : undefined), { passive: true });
    document
      .querySelector('.site-nav ul')
      ?.addEventListener('scroll', () => (isOpen() ? place() : undefined), { passive: true });
  }
</script>
