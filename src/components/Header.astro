---
import { CONTACT_PHONE, SITE } from '../config/site';
import { commonLabels, getAlternatePath, routeMap, type Locale } from '../i18n/content';
import IconPhone from './icons/IconPhone.astro';
import NavigationLinks from './NavigationLinks.astro';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const labels = commonLabels[lang];
const altPath = getAlternatePath(currentPath, lang);
const homeHref = routeMap.home[lang];

---

<header class="site-header">
  <a class="skip-link" href="#main">{labels.skipLink}</a>
  <div class="container header-bar">
    <a class="brand" href={homeHref}>{SITE.brandName}</a>
    <nav class="site-nav site-nav-desktop" aria-label={labels.navAria}>
      <NavigationLinks lang={lang} currentPath={currentPath} />
    </nav>
    <details class="mobile-nav-disclosure">
      <summary class="mobile-nav-toggle">
        <span>{labels.menu}</span>
        <span class="mobile-nav-toggle-icon" aria-hidden="true"></span>
      </summary>
      <nav class="site-nav mobile-nav-panel" aria-label={labels.navAria}>
        <NavigationLinks lang={lang} currentPath={currentPath} />
      </nav>
    </details>
    <div class="header-actions">
      <a class="lang-toggle" href={altPath} lang={lang === 'pl' ? 'en' : 'pl'} aria-label={labels.languageSwitch}>
        {labels.languageShort}
      </a>
      <a class="icon-link" href={CONTACT_PHONE.href} aria-label={labels.phoneAria}>
        <IconPhone class="icon" />
      </a>
    </div>
  </div>
</header>
