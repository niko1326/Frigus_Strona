---
import { CONTACT_PHONE, SITE } from '../config/site';
import { commonLabels, getAlternatePath, navLinks, type Locale } from '../i18n/content';
import IconPhone from './icons/IconPhone.astro';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const labels = commonLabels[lang];
const altPath = getAlternatePath(currentPath, lang);
const homeHref = lang === 'pl' ? '/' : '/en/';

const normalize = (path: string): string => {
  if (path !== '/' && path.endsWith('/')) {
    return path.slice(0, -1);
  }

  return path;
};

const current = normalize(currentPath);
---

<header class="site-header">
  <a class="skip-link" href="#main">{lang === 'pl' ? 'Przejdź do treści' : 'Skip to content'}</a>
  <div class="container header-bar">
    <a class="brand" href={homeHref}>{SITE.brandName}</a>
    <nav class="site-nav" aria-label={labels.navAria}>
      <ul>
        {
          navLinks[lang].map((link) => {
            const active = current === normalize(link.href);

            return (
              <li>
                <a class={active ? 'is-active' : ''} href={link.href}>
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a class="lang-toggle" href={altPath} lang={lang === 'pl' ? 'en' : 'pl'} aria-label={labels.languageSwitch}>
        {labels.languageShort}
      </a>
      <a class="icon-link" href={CONTACT_PHONE.href} aria-label={labels.phoneAria}>
        <IconPhone class="icon" />
      </a>
    </div>
  </div>
</header>
