---
import { CONTACT_PHONE, SITE } from '../config/site';
import { EQUIPMENT, type EquipmentBrand } from '../config/equipment';
import { commonLabels, getAlternatePath, navLinks, routeMap, type Locale } from '../i18n/content';
import IconPhone from './icons/IconPhone.astro';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const labels = commonLabels[lang];
const altPath = getAlternatePath(currentPath, lang);
const homeHref = routeMap.home[lang];

const normalize = (path: string): string => {
  if (path !== '/' && path.endsWith('/')) {
    return path.slice(0, -1);
  }

  return path;
};

const current = normalize(currentPath);
const equipmentNavItems: readonly Readonly<{ brand: EquipmentBrand; href: string }>[] = [
  { brand: EQUIPMENT.brands.gree, href: routeMap.gree[lang] },
  { brand: EQUIPMENT.brands.kaisai, href: routeMap.kaisai[lang] }
];
---

<header class="site-header">
  <a class="skip-link" href="#main">{labels.skipLink}</a>
  <div class="container header-bar">
    <a class="brand" href={homeHref}>{SITE.brandName}</a>
    <nav class="site-nav" aria-label={labels.navAria}>
      <ul>
        {
          navLinks[lang].map((link) => {
            const normalizedHref = normalize(link.href);
            const isCurrentPage = current === normalizedHref;
            const isEquipmentLink = normalizedHref === normalize(routeMap.airConditioners[lang]);
            const isEquipmentChild = isEquipmentLink && current.startsWith(`${normalizedHref}/`);
            const active = isCurrentPage || isEquipmentChild;

            if (isEquipmentLink) {
              return (
                <li class="nav-dropdown">
                  <a
                    class={active ? 'is-active' : ''}
                    href={link.href}
                    aria-current={isCurrentPage ? 'page' : undefined}
                  >
                    {link.label}
                    <span class="nav-dropdown-chevron" aria-hidden="true">⌄</span>
                  </a>
                  <ul class="nav-dropdown-menu" aria-label={labels.equipmentBrandsAria}>
                    {equipmentNavItems.map(({ brand, href }) => {
                      const isBrandCurrent = current === normalize(href);
                      const image = brand.navigationImage;

                      return (
                        <li>
                          <a
                            class:list={[{ 'has-image': Boolean(image), 'is-current': isBrandCurrent }]}
                            href={href}
                            aria-current={isBrandCurrent ? 'page' : undefined}
                          >
                            {image && (
                              <span class="nav-dropdown-image" aria-hidden="true">
                                <img
                                  src={image.src}
                                  alt=""
                                  width={image.width}
                                  height={image.height}
                                  loading="lazy"
                                  decoding="async"
                                />
                              </span>
                            )}
                            <span class="nav-dropdown-brand">{brand.name}</span>
                            <span class="nav-dropdown-arrow" aria-hidden="true">→</span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </li>
              );
            }

            return (
              <li>
                <a class={active ? 'is-active' : ''} href={link.href} aria-current={isCurrentPage ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="header-actions">
      <a class="lang-toggle" href={altPath} lang={lang === 'pl' ? 'en' : 'pl'} aria-label={labels.languageSwitch}>
        {labels.languageShort}
      </a>
      <a class="icon-link" href={CONTACT_PHONE.href} aria-label={labels.phoneAria}>
        <IconPhone class="icon" />
      </a>
    </div>
  </div>
</header>
