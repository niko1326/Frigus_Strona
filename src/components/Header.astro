---
import { SITE, PHONE_TEL } from '../config/site';
import { labels, navLinks, routes } from '../i18n/content';
import IconPhone from './icons/IconPhone.astro';

interface Props { currentPath: string }
const { currentPath } = Astro.props;
const current = currentPath.replace(/\/$/, '') || '/';
type Item = { label: string; href?: string; id?: string; children?: { label: string; href: string }[] };
const items: Item[] = [
  ...navLinks.slice(0, 2),
  { label: 'Klimatyzatory', id: 'air-conditioners', children: [
    { label: 'Klimatyzatory GREE', href: routes.gree },
    { label: 'Klimatyzatory KAISAI', href: routes.kaisai }
  ] },
  { label: 'Kalkulatory', id: 'calculators', children: [
    { label: 'Kalkulator mocy klimatyzacji', href: routes.calcPower },
    { label: 'Kalkulator kosztu klimatyzacji', href: routes.calcCost }
  ] },
  ...navLinks.slice(2)
];
---

<header class="site-header">
  <a class="skip-link" href="#main">Przejdź do treści</a>
  <div class="container header-bar">
    <a class="brand" href="/" aria-label={`${SITE.brandName} - strona główna`}>
      <img class="brand-lockup" src="/brand/frigac-logo.svg" width="144" height="44" alt={SITE.brandName} />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Otwórz menu">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path class="hamburger" d="M4 6h16M4 12h16M4 18h16" /><path class="close-icon" d="m6 6 12 12M6 18 18 6" /></svg>
    </button>
    <nav class="site-nav" id="primary-navigation" aria-label={labels.navAria}>
      <ul class="nav-list">
        {items.map((item) => (
          <li class={item.children ? 'nav-has-menu' : undefined}>
            {item.children ? <>
              <button type="button" class:list={['nav-trigger', { 'is-active': item.children.some(link => link.href === current) }]}
                id={`nav-${item.id}-trigger`} aria-expanded="false" aria-controls={`nav-${item.id}-menu`} aria-haspopup="true">
                {item.label}
                <svg class="nav-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <div class="nav-menu" id={`nav-${item.id}-menu`} hidden>
                <ul>
                  {item.children.map(link => <li><a href={link.href} class:list={{ 'is-active': current === link.href }} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a></li>)}
                </ul>
              </div>
            </> : <a href={item.href} class:list={{ 'is-active': current === item.href }} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>}
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="header-cta" href={`tel:${PHONE_TEL}`} aria-label={labels.phoneAria}>
        <IconPhone class="icon" /><span>{labels.freeQuote}</span>
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const nav = header.querySelector<HTMLElement>('.site-nav')!;
  const toggle = header.querySelector<HTMLButtonElement>('.nav-toggle')!;
  const mobile = window.matchMedia('(max-width: 1199.98px)');
  const groups = Array.from(header.querySelectorAll<HTMLElement>('.nav-has-menu')).map(element => ({
    element,
    button: element.querySelector<HTMLButtonElement>('.nav-trigger')!,
    panel: element.querySelector<HTMLElement>('.nav-menu')!
  }));
  const setGroup = (group: typeof groups[number], open: boolean) => {
    group.button.setAttribute('aria-expanded', String(open));
    group.panel.hidden = !open;
  };
  const closeGroups = () => groups.forEach(group => setGroup(group, false));
  const setMobile = (open: boolean, restoreFocus = false) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
    nav.classList.toggle('is-open', open);
    nav.hidden = mobile.matches && !open;
    if (!open) closeGroups();
    if (restoreFocus) toggle.focus();
  };
  toggle.addEventListener('click', () => setMobile(toggle.getAttribute('aria-expanded') !== 'true'));
  groups.forEach(group => {
    const open = () => { closeGroups(); setGroup(group, true); };
    group.button.addEventListener('click', () => {
      if (group.button.getAttribute('aria-expanded') === 'true') setGroup(group, false);
      else open();
    });
    group.element.addEventListener('pointerenter', event => {
      if (!mobile.matches && event.pointerType === 'mouse') open();
    });
    group.element.addEventListener('pointerleave', () => {
      if (!mobile.matches && !group.element.contains(document.activeElement)) setGroup(group, false);
    });
    group.button.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault(); open();
        const links = group.panel.querySelectorAll<HTMLAnchorElement>('a');
        links[event.key === 'ArrowDown' ? 0 : links.length - 1]?.focus();
      }
    });
    group.panel.addEventListener('keydown', event => {
      if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const links = Array.from(group.panel.querySelectorAll<HTMLAnchorElement>('a'));
      const index = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? links.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
      links[next]?.focus();
    });
    group.element.addEventListener('focusout', event => {
      if (!group.element.contains(event.relatedTarget as Node | null)) setGroup(group, false);
    });
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const opened = groups.find(group => group.button.getAttribute('aria-expanded') === 'true');
    if (opened) { event.preventDefault(); setGroup(opened, false); opened.button.focus(); }
    else if (mobile.matches && toggle.getAttribute('aria-expanded') === 'true') { event.preventDefault(); setMobile(false, true); }
  });
  document.addEventListener('click', event => {
    if (!header.contains(event.target as Node)) setMobile(false);
  });
  header.addEventListener('focusout', event => {
    if (!header.contains(event.relatedTarget as Node | null)) setMobile(false);
  });
  nav.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMobile(false)));
  mobile.addEventListener('change', () => {
    const focusInNav = nav.contains(document.activeElement);
    setMobile(false, mobile.matches && focusInNav);
  });
  window.addEventListener('pageshow', () => setMobile(false));
  setMobile(false);
</script>
