---
import Breadcrumbs from './Breadcrumbs.astro';
import CTAButton from './CTAButton.astro';
import Layout from './Layout.astro';
import type { ProductLineupModel } from '../config/lineups';
import { PHONE_TEL, SITE } from '../config/site';
import { routes } from '../i18n/content';
import {
  buildEnergyCalculatorHref,
  buildEnergyCalculatorLabel
} from '../utils/product-energy-link.mjs';
import { buildProductStructuredData } from '../utils/product-structured-data';
import { toColorParam, toPowerParam } from '../utils/product-variant-url.mjs';

interface Props {
  brand: string;
  categoryLabel: string;
  categoryPath: string;
  model: ProductLineupModel;
}

const { brand, categoryLabel, categoryPath, model } = Astro.props;
const productName = `${brand} ${model.name}`;
const isConsoleModel = model.slug === 'kaisai-konsola';
const energyCtaModelName = model.product.ctaName ?? model.name;
const currentPath = `${categoryPath}/${model.product.slug}`;
const priceFormatter = new Intl.NumberFormat('pl-PL', { useGrouping: 'always' });
const hasPricing = model.variants.some((variant) => typeof variant.priceFromPLN === 'number');
const minimumPrice = typeof model.product.priceFromPLN === 'number'
  ? priceFormatter.format(model.product.priceFromPLN)
  : null;
const formatNumber = (value: number) => new Intl.NumberFormat('pl-PL', {
  minimumFractionDigits: Number.isInteger(value) ? 0 : 1,
  maximumFractionDigits: 2
}).format(value);
const powerLabels = model.variants.map((variant) => `${variant.label} kW`).join(', ');
const maxSeer = Math.max(...model.variants.map((variant) => variant.seer));
const maxScop = Math.max(...model.variants.map((variant) => variant.scop));
const title = hasPricing
  ? `${productName} z montażem - cena i dane techniczne | FRIGAC`
  : `${productName} z montażem - dane techniczne | FRIGAC`;
const description = hasPricing && minimumPrice
  ? `${productName}: moce ${powerLabels}, SEER do ${formatNumber(maxSeer)} i SCOP do ${formatNumber(maxScop)}. Cena z montażem od ${minimumPrice} zł. Sprawdź parametry i poproś o wycenę.`
  : `${productName}: moce ${powerLabels}, SEER do ${formatNumber(maxSeer)} i SCOP do ${formatNumber(maxScop)}. Sprawdź funkcje, parametry i poproś o wycenę montażu.`;
const colorOptions = model.product.colors ?? [];
const colorTierOptions = colorOptions.filter((color) => color.priceTier === 'color');
const colorTierLabel = colorTierOptions.length === 1 ? colorTierOptions[0].name : 'Kolor';
const hasColorTier = colorTierOptions.length > 0;
const firstColor = colorOptions.find((color) => color.name === 'Biały') ?? colorOptions[0];
const productImage = firstColor?.image ?? model.image;
const productImageAlt = firstColor?.alt ?? model.alt;
const firstVariant = model.variants[0];
const firstVariantPrice = firstColor?.priceTier === 'color'
  ? firstVariant.colorPriceFromPLN ?? firstVariant.priceFromPLN
  : firstVariant.priceFromPLN;
const initialPriceValue = firstVariantPrice ?? model.product.priceFromPLN;
const initialPrice = typeof initialPriceValue === 'number'
  ? priceFormatter.format(initialPriceValue)
  : null;
const initialEnergyCtaHref = buildEnergyCalculatorHref(routes.calcEnergy, model.slug, firstVariant.powerKw);
const initialEnergyCtaLabel = buildEnergyCalculatorLabel(brand, energyCtaModelName, firstVariant.label);
const productSchema = buildProductStructuredData({
  brand,
  category: isConsoleModel
    ? 'Klimatyzator konsolowy split z montażem'
    : 'Klimatyzator ścienny split z montażem',
  model,
  pageUrl: new URL(currentPath, SITE.siteUrl).toString()
});

---

<Layout
  title={title}
  description={description}
  keywords={[
    ...(hasPricing ? [`${productName} cena z montażem`] : []),
    `${productName} dane techniczne`,
    `${productName} montaż`,
    ...model.variants.map((variant) => `${productName} ${variant.label} kW`)
  ]}
  currentPath={currentPath}
  ogImage={productImage}
  ogImageAlt={productImageAlt}
  ogImageWidth={870}
  ogImageHeight={326}
  extraSchema={[productSchema]}
>
  <Breadcrumbs
    items={[
      { label: categoryLabel, href: categoryPath },
      { label: productName }
    ]}
  />

  <section class="product-hero section-gray">
    <div class="container product-hero-grid" data-reveal>
      <figure class="product-hero-media">
        {model.badge && <span class="lineup-badge">{model.badge}</span>}
        <img
          src={productImage}
          alt={productImageAlt}
          width="870"
          height="326"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          data-product-color-image
        />
      </figure>

      <div class="product-hero-copy">
        <p class="eyebrow">{isConsoleModel ? 'Klimatyzator konsolowy z montażem' : 'Klimatyzator ścienny z montażem'}</p>
        <h1>{productName}</h1>
        <p class="product-lead">{model.tagline}</p>

        {colorOptions.length > 1 && (
          <fieldset class="product-color-block">
            <legend class="product-field-label">
              Wybierz kolor: <strong data-product-color-label>{firstColor?.name}</strong>
            </legend>
            <div class="product-color-options">
              {colorOptions.map((color) => (
                <button
                  type="button"
                  class:list={['product-color-option', { 'is-selected': color === firstColor }]}
                  aria-label={`Pokaż ${productName} w kolorze ${color.name}`}
                  aria-pressed={color === firstColor ? 'true' : 'false'}
                  data-product-color
                  data-image={color.image}
                  data-alt={color.alt}
                  data-color-name={color.name}
                  data-color-param={toColorParam(color.name)}
                  data-price-tier={color.priceTier ?? 'standard'}
                >
                  <span
                    class="product-color-swatch"
                    style={`--product-swatch: ${color.swatch}`}
                    aria-hidden="true"
                  ></span>
                  <span>{color.name}</span>
                </button>
              ))}
            </div>
          </fieldset>
        )}

        <div class="product-power-block">
          <p class="product-field-label">Wybierz wariant mocy</p>
          <div class="product-power-options" aria-label={`Warianty mocy ${productName}`}>
            {
              model.variants.map((variant, index) => (
                <button
                  type="button"
                  class:list={['product-power-option', { 'is-selected': index === 0 }]}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  data-product-variant
                  data-index={index}
                  data-cooling={formatNumber(variant.coolingCapacityKw)}
                  data-heating={formatNumber(variant.heatingCapacityKw)}
                  data-seer={formatNumber(variant.seer)}
                  data-scop={formatNumber(variant.scop)}
                  data-power={variant.powerKw}
                  data-power-param={toPowerParam(variant.label)}
                  data-power-label={variant.label}
                  data-price={variant.priceFromPLN}
                  data-color-price={variant.colorPriceFromPLN}
                >
                  {variant.label} kW
                </button>
              ))
            }
          </div>
        </div>

        <dl class="product-quick-specs" aria-live="polite">
          <div>
            <dt>Chłodzenie</dt>
            <dd><span data-spec="cooling">{formatNumber(firstVariant.coolingCapacityKw)}</span> kW</dd>
          </div>
          <div>
            <dt>Grzanie</dt>
            <dd><span data-spec="heating">{formatNumber(firstVariant.heatingCapacityKw)}</span> kW</dd>
          </div>
          <div>
            <dt>SEER</dt>
            <dd data-spec="seer">{formatNumber(firstVariant.seer)}</dd>
          </div>
          <div>
            <dt>SCOP</dt>
            <dd data-spec="scop">{formatNumber(firstVariant.scop)}</dd>
          </div>
        </dl>

        <a
          class="product-energy-cta"
          href={initialEnergyCtaHref}
          data-energy-calculator-cta
          data-energy-base-path={routes.calcEnergy}
          data-energy-model={model.slug}
          data-energy-brand={brand}
          data-energy-name={energyCtaModelName}
        >
          <span data-energy-cta-label>{initialEnergyCtaLabel}</span>
          <span aria-hidden="true">→</span>
        </a>

        {hasPricing && initialPrice && (
          <div class="product-price-block" aria-live="polite">
            <span data-product-price-label>Cena brutto z urządzeniem i montażem do 3 mb</span>
            <strong data-product-price>{initialPrice} zł</strong>
            <small>
              Pokazana cena odpowiada wybranej mocy i kolorowi oraz obejmuje urządzenie i standardowy montaż do 3 mb.
              Dodatkowe metry i usługi rozliczamy zgodnie z cennikiem; finalny zakres i cenę
              potwierdzamy przed rozpoczęciem prac.
            </small>
            <a class="inline-link" href={routes.pricing}>Sprawdź, co obejmuje standardowy montaż</a>
          </div>
        )}

        <div class="hero-actions">
          <CTAButton href={routes.contact} label="Skonsultuj ten model" />
          <CTAButton
            href={`tel:${PHONE_TEL}`}
            label="Zadzwoń i skonsultuj"
            ariaLabel={`Zadzwoń i skonsultuj model ${productName}`}
            variant="secondary"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Najważniejsze cechy</p>
        <h2>Co wyróżnia {productName}</h2>
      </div>
      <ul class="product-feature-grid" role="list">
        {
          model.features.map((feature) => (
            <li>
              <span class="product-feature-check" aria-hidden="true">✓</span>
              <strong>{feature}</strong>
            </li>
          ))
        }
        {model.connectivityLabel && (
          <li>
            <span class="product-feature-check" aria-hidden="true">✓</span>
            <span><strong>Sterowanie Wi-Fi</strong><small>{model.connectivityLabel.replace('Sterowanie Wi-Fi / ', '')}</small></span>
          </li>
        )}
        {model.energyClass && (
          <li>
            <span class="product-feature-check" aria-hidden="true">✓</span>
            <span><strong>Klasa energetyczna</strong><small>{model.energyClass}</small></span>
          </li>
        )}
      </ul>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container product-audience-grid" data-reveal>
      <div class="section-head product-section-head">
        <p class="eyebrow">Dobór modelu</p>
        <h2>Dla kogo jest {productName}?</h2>
        <p>{model.product.description}</p>
      </div>
      <div class="product-audience-card">
        <h3>{productName} sprawdzi się szczególnie:</h3>
        <ul class="check-list">
          {model.product.recommendedFor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Dane techniczne</p>
        <h2>Porównanie wariantów mocy</h2>
        <p>
          Wartości znamionowe i współczynniki sezonowe dla poszczególnych wariantów. Wybór mocy
          potwierdzamy po sprawdzeniu metrażu, nasłonecznienia i układu pomieszczenia.
        </p>
      </div>
      <div class="product-table-wrap">
        <table class="product-spec-table">
          <thead>
            <tr>
              <th scope="col">Wariant</th>
              <th scope="col">Moc chłodnicza</th>
              <th scope="col">Moc grzewcza</th>
              <th scope="col">SEER</th>
              <th scope="col">SCOP</th>
              {hasPricing && <th scope="col">Cena brutto z urządzeniem i montażem do 3 mb</th>}
            </tr>
          </thead>
          <tbody>
            {
              model.variants.map((variant, index) => (
                <tr class:list={{ 'is-selected': index === 0 }} data-variant-row data-index={index}>
                  <th scope="row">{variant.label} kW</th>
                  <td data-label="Chłodzenie">{formatNumber(variant.coolingCapacityKw)} kW</td>
                  <td data-label="Grzanie">{formatNumber(variant.heatingCapacityKw)} kW</td>
                  <td data-label="SEER">{formatNumber(variant.seer)}</td>
                  <td data-label="SCOP">{formatNumber(variant.scop)}</td>
                  {hasPricing && (
                    <td class="product-table-price" data-label="Cena brutto z urządzeniem i montażem do 3 mb">
                      {variant.priceFromPLN ? (
                        hasColorTier ? (
                          <>
                            <span>Biały: {priceFormatter.format(variant.priceFromPLN)} zł</span>
                            <small>
                              {colorTierLabel}:{' '}
                              {variant.colorPriceFromPLN
                                ? `${priceFormatter.format(variant.colorPriceFromPLN)} zł`
                                : 'niedostępny'}
                            </small>
                          </>
                        ) : (
                          <strong>{priceFormatter.format(variant.priceFromPLN)} zł</strong>
                        )
                      ) : (
                        <span>Wycena indywidualna</span>
                      )}
                    </td>
                  )}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="tiny-note">
        Dane pochodzą z kart produktowych producenta. Etykieta wariantu może być zaokrągloną nazwą
        handlową; tabela pokazuje dokładną moc znamionową.
      </p>
      <p class="product-shared-specs">
        {model.energyClass && <span><strong>Klasa energetyczna:</strong> {model.energyClass}</span>}
        {model.noise && <span><strong>Głośność:</strong> {model.noise}</span>}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band product-bottom-cta" data-reveal>
      <div>
        <p class="eyebrow">Konsultacja modelu</p>
        <h2>Chcesz zamontować {productName}?</h2>
        <p>
          Powiedz nam, gdzie ma pracować klimatyzator. Dobierzemy odpowiednią moc, a po sprawdzeniu
          warunków potwierdzimy zakres i cenę montażu.
        </p>
      </div>
      <div class="product-cta-actions">
        <CTAButton href={routes.contact} label="Skonsultuj ten model" />
        <CTAButton href={`tel:${PHONE_TEL}`} label="Umów bezpłatną wizytę" variant="secondary" />
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Zobacz też:</p>
      <a class="text-link" href={categoryPath}>Wszystkie klimatyzatory {brand}</a>
      <a class="text-link" href={routes.calcPower}>Kalkulator mocy klimatyzacji</a>
      <a class="text-link" href={routes.pricing}>Cennik montażu klimatyzacji</a>
    </div>
  </section>

  <script>
    import {
      buildEnergyCalculatorHref,
      buildEnergyCalculatorLabel
    } from '../utils/product-energy-link.mjs';
    import {
      buildVariantUrl,
      resolveVariantSelection
    } from '../utils/product-variant-url.mjs';

    const colorButtons = document.querySelectorAll<HTMLButtonElement>('[data-product-color]');
    const colorImage = document.querySelector('[data-product-color-image]');
    const colorLabel = document.querySelector('[data-product-color-label]');
    const variantButtons = document.querySelectorAll<HTMLButtonElement>('[data-product-variant]');
    const variantRows = document.querySelectorAll('[data-variant-row]');
    const priceLabel = document.querySelector('[data-product-price-label]');
    const priceValue = document.querySelector('[data-product-price]');
    const energyCta = document.querySelector<HTMLAnchorElement>('[data-energy-calculator-cta]');
    const energyCtaLabel = document.querySelector<HTMLElement>('[data-energy-cta-label]');
    const formatPrice = new Intl.NumberFormat('pl-PL', { useGrouping: 'always' });

    const updatePrice = () => {
      const selectedVariant = document.querySelector<HTMLButtonElement>('[data-product-variant].is-selected');
      const selectedColor = document.querySelector<HTMLButtonElement>('[data-product-color].is-selected');
      if (!selectedVariant || !priceLabel || !priceValue) return;

      const usesColorPrice = selectedColor?.dataset.priceTier === 'color';
      const rawPrice = usesColorPrice
        ? selectedVariant.dataset.colorPrice
        : selectedVariant.dataset.price;

      if (rawPrice) {
        priceLabel.textContent = 'Cena brutto z urządzeniem i montażem do 3 mb';
        priceValue.textContent = `${formatPrice.format(Number(rawPrice))} zł`;
      } else if (usesColorPrice) {
        priceLabel.textContent = 'Wybrany wariant';
        priceValue.textContent = 'Niedostępny';
      } else {
        priceLabel.textContent = 'Cena z montażem';
        priceValue.textContent = 'Zapytaj o wycenę';
      }
    };

    const selectColor = (button: HTMLButtonElement) => {
      colorButtons.forEach((item) => {
        item.classList.toggle('is-selected', item === button);
        item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
      });

      if (colorImage instanceof HTMLImageElement) {
        if (button.dataset.image) colorImage.src = button.dataset.image;
        if (button.dataset.alt) colorImage.alt = button.dataset.alt;
      }
      if (colorLabel && button.dataset.colorName) colorLabel.textContent = button.dataset.colorName;
      updatePrice();
    };

    const syncVariantUrl = () => {
      const selectedVariant = document.querySelector<HTMLButtonElement>('[data-product-variant].is-selected');
      const selectedColor = document.querySelector<HTMLButtonElement>('[data-product-color].is-selected');
      if (!selectedVariant?.dataset.powerParam) return;

      const nextUrl = buildVariantUrl(window.location.href, {
        power: selectedVariant.dataset.powerParam,
        color: selectedColor?.dataset.colorParam,
        hasColorVariants: colorButtons.length > 1
      });
      window.history.replaceState(window.history.state, '', nextUrl);
    };

    const setText = (name: string, value: string | undefined) => {
      const target = document.querySelector(`[data-spec="${name}"]`);
      if (target && value) target.textContent = value;
    };

    const updateEnergyCta = (button: HTMLButtonElement) => {
      if (!energyCta || !energyCtaLabel) return;
      const { energyBasePath, energyModel, energyBrand, energyName } = energyCta.dataset;
      const power = Number(button.dataset.power);
      if (!energyBasePath || !energyModel || !energyBrand || !energyName || !Number.isFinite(power)) return;
      energyCta.href = buildEnergyCalculatorHref(energyBasePath, energyModel, power);
      energyCtaLabel.textContent = buildEnergyCalculatorLabel(
        energyBrand,
        energyName,
        button.dataset.powerLabel
      );
    };

    const selectVariant = (button: HTMLButtonElement) => {
      const index = button.dataset.index;

      variantButtons.forEach((item) => {
        item.classList.toggle('is-selected', item === button);
        item.setAttribute('aria-pressed', item === button ? 'true' : 'false');
      });
      variantRows.forEach((row) => row.classList.toggle('is-selected', row.getAttribute('data-index') === index));

      setText('cooling', button.dataset.cooling);
      setText('heating', button.dataset.heating);
      setText('seer', button.dataset.seer);
      setText('scop', button.dataset.scop);
      updateEnergyCta(button);
      updatePrice();
    };

    colorButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectColor(button);
        syncVariantUrl();
      });
    });

    variantButtons.forEach((button) => {
      button.addEventListener('click', () => {
        selectVariant(button);
        syncVariantUrl();
      });
    });

    const initialSelection = resolveVariantSelection({
      search: window.location.search,
      powers: Array.from(variantButtons, (button) => button.dataset.powerParam ?? ''),
      colors: Array.from(colorButtons, (button) => button.dataset.colorParam ?? '')
    });
    const initialVariant = Array.from(variantButtons)
      .find((button) => button.dataset.powerParam === initialSelection.power);
    const initialColor = Array.from(colorButtons)
      .find((button) => button.dataset.colorParam === initialSelection.color);

    if (initialVariant) selectVariant(initialVariant);
    if (initialColor) selectColor(initialColor);
  </script>
</Layout>
