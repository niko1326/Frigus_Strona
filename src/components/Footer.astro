---
import { HOURS, PHONE_DISPLAY, PHONE_TEL, SITE } from '../config/site';
import { commonLabels, getAlternatePath, getPathByPage, type Locale } from '../i18n/content';

interface Props {
  lang: Locale;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const labels = commonLabels[lang];
const altPath = getAlternatePath(currentPath, lang);
const privacyLink = getPathByPage('privacy', lang);
---

<footer class="site-footer" data-reveal>
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{SITE.brandName}</p>
      <p>{labels.footerInfo}</p>
      <a href={`tel:${PHONE_TEL}`} class="footer-phone" aria-label={labels.phoneAria}>
        {PHONE_DISPLAY}
      </a>
    </div>

    <div>
      <p class="footer-heading">{labels.footerHours}</p>
      <p>{lang === 'pl' ? 'Pon.-Pt.' : 'Mon-Fri'} {HOURS.weekdays}</p>
      <p>{lang === 'pl' ? 'Sobota' : 'Saturday'} {HOURS.saturday}</p>
      <p>{lang === 'pl' ? 'Niedziela' : 'Sunday'} {lang === 'pl' ? HOURS.sundayPL : HOURS.sundayEN}</p>
    </div>

    <div>
      <p class="footer-heading">{lang === 'pl' ? 'Informacje' : 'Info'}</p>
      <a href={privacyLink}>{labels.privacy}</a>
      <a href={altPath}>{labels.languageSwitch}</a>
      <p class="footer-small">{lang === 'pl' ? 'Bydgoszcz + Trójmiasto' : 'Bydgoszcz + Tri-City'}</p>
    </div>
  </div>
</footer>
