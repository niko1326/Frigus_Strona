---
import Footer from './Footer.astro';
import Header from './Header.astro';
import StickyCallBar from './StickyCallBar.astro';
import {
  ANALYTICS,
  BUSINESS,
  CONTACT_PHONE,
  CONTACT_PHONES,
  SITE
} from '../config/site';
import { commonLabels, getLocalizedPaths, type Locale } from '../i18n/content';
import '../styles/global.css';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  currentPath: string;
  socialImageAlt?: string;
  breadcrumbs?: readonly Readonly<{
    name: string;
    path: string;
  }>[];
}

const {
  lang,
  title,
  description,
  currentPath,
  socialImageAlt = SITE.defaultSocialImage.alt[lang],
  breadcrumbs = []
} = Astro.props;

const localizedPaths = getLocalizedPaths(currentPath);
const localizedUrls: Record<Locale, string> = {
  pl: new URL(localizedPaths.pl, SITE.siteUrl).toString(),
  en: new URL(localizedPaths.en, SITE.siteUrl).toString()
};
const canonicalUrl = localizedUrls[lang];
const xDefaultUrl = localizedUrls[SITE.defaultLocale];
const siteRootUrl = new URL('/', SITE.siteUrl).toString();
const socialImageUrl = new URL(SITE.defaultSocialImage.src, SITE.siteUrl).toString();
const businessEntityId = `${siteRootUrl}#business`;
const websiteEntityId = `${siteRootUrl}#website`;
const webPageEntityId = `${canonicalUrl}#webpage`;
const breadcrumbEntityId = breadcrumbs.length > 0 ? `${canonicalUrl}#breadcrumb` : undefined;
const openGraphLocales = {
  pl: 'pl_PL',
  en: 'en_US'
} as const satisfies Record<Locale, string>;
const alternateLocale: Locale = lang === 'pl' ? 'en' : 'pl';
const labels = commonLabels[lang];
const areaServed = BUSINESS.serviceArea.regions.map((region) => region.label[lang]);

const localBusinessSchema = {
  '@type': 'LocalBusiness',
  '@id': businessEntityId,
  name: SITE.brandName,
  legalName: BUSINESS.legalName,
  description: lang === 'pl'
    ? `Montaż klimatyzacji — ${BUSINESS.serviceArea.summary.pl}`
    : `Air conditioning installation — ${BUSINESS.serviceArea.summary.en}`,
  telephone: CONTACT_PHONES.map((phone) => phone.tel),
  email: BUSINESS.contact.email.address,
  areaServed,
  url: siteRootUrl
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteEntityId,
  url: siteRootUrl,
  name: SITE.brandName,
  inLanguage: ['pl', 'en'],
  publisher: {
    '@id': businessEntityId
  }
};

const webPageSchema = {
  '@type': 'WebPage',
  '@id': webPageEntityId,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: {
    '@id': websiteEntityId
  },
  about: {
    '@id': businessEntityId
  },
  ...(breadcrumbEntityId ? { breadcrumb: { '@id': breadcrumbEntityId } } : {})
};

const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      '@type': 'BreadcrumbList',
      '@id': breadcrumbEntityId,
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, SITE.siteUrl).toString()
      }))
    }
  : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [localBusinessSchema, websiteSchema, webPageSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])]
};

const cloudflareBeaconData = JSON.stringify({ token: ANALYTICS.cloudflare.token });
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pl" href={localizedUrls.pl} />
    <link rel="alternate" hreflang="en" href={localizedUrls.en} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocales[lang]} />
    <meta property="og:locale:alternate" content={openGraphLocales[alternateLocale]} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content={SITE.defaultSocialImage.mimeType} />
    <meta property="og:image:width" content={String(SITE.defaultSocialImage.width)} />
    <meta property="og:image:height" content={String(SITE.defaultSocialImage.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <script is:inline>document.documentElement.classList.add('reveal-enabled');</script>
    {
      ANALYTICS.cloudflare.enabled && ANALYTICS.cloudflare.token && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={cloudflareBeaconData}
        ></script>
      )
    }
  </head>
  <body>
    <Header lang={lang} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} currentPath={currentPath} />
    <StickyCallBar phoneHref={CONTACT_PHONE.href} label={labels.stickyCall} />

    <script is:inline>
      (() => {
        const revealNodes = document.querySelectorAll('[data-reveal]');
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealAll = () => {
          revealNodes.forEach((node) => node.classList.add('is-visible'));
          document.documentElement.classList.remove('reveal-enabled');
        };

        if (prefersReduced || !('IntersectionObserver' in window)) {
          revealAll();
          return;
        }

        try {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.18, rootMargin: '0px 0px -40px 0px' }
          );

          revealNodes.forEach((node) => observer.observe(node));
        } catch {
          revealAll();
        }
      })();
    </script>
  </body>
</html>
