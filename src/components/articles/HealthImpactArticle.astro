            <span class="bar-row-label">{range.label}</span>
            <div class="bar-track" title={`${range.label}: ${range.from}-${range.to}°C`}>
              <span
                class="bar-fill"
                style={`left:${tempPos(range.from)}%;width:${tempPos(range.to) - tempPos(range.from)}%`}
              >
                <span class="bar-value">{range.from}-{range.to}°C</span>
              </span>
            </div>
          </div>
        ))
