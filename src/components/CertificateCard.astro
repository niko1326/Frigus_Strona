---
import type { Certificate } from '../config/certificates';
interface Props { certificate: Certificate }
const { certificate } = Astro.props;
---

<figure class="document-card">
  <a class:list={['document-preview', { 'document-preview-portrait': certificate.height > certificate.width }]} href={certificate.document} target="_blank" rel="noopener noreferrer"
    aria-label={`Otwórz dokument: ${certificate.title} – ${certificate.holder} (nowa karta)`}>
    <img src={certificate.image} alt={certificate.alt} width={certificate.width} height={certificate.height}
      loading="lazy" decoding="async" />
  </a>
  <figcaption>
    <strong>{certificate.holder}</strong>
    <span>{certificate.title}</span>
    <a href={certificate.document} target="_blank" rel="noopener noreferrer"
      aria-label={`Zobacz pełny dokument: ${certificate.title} – ${certificate.holder} (nowa karta)`}>
      Zobacz dokument <span aria-hidden="true">↗</span>
    </a>
  </figcaption>
</figure>

<style>
  .document-card {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--canvas);
    display: flex;
    flex-direction: column;
  }
  .document-preview {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(0.65rem, 2vw, 1.2rem);
    aspect-ratio: 1.414;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .document-preview img {
    position: absolute;
    inset: 0;
    padding: inherit;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .document-preview-portrait { aspect-ratio: 1; }
  figcaption { display: grid; gap: 0.4rem; padding: 1.1rem 1.25rem; }
  figcaption strong { font-weight: 600; }
  figcaption > span { font-size: 0.88rem; color: var(--muted); }
  figcaption > a { width: fit-content; color: var(--accent); font-size: 0.88rem; padding-block: 0.4rem; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: -3px; }
</style>
