---
import { BUSINESS } from '../../../config/site';
import type { Locale } from '../../../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isPL = lang === 'pl';
const pricingPath = isPL ? '/cennik' : '/en/pricing';
---

<section class="section" data-reveal>
  <div class="container">
    <div class="plain-stack">
      <p class="eyebrow">{isPL ? 'Cennik' : 'Pricing'}</p>
      <p class="plain-highlight">
        {isPL
          ? `Cena montażu: ${BUSINESS.pricing.label.pl}`
          : `Installation price: ${BUSINESS.pricing.label.en}`}
      </p>
      <p>{BUSINESS.pricing.includedInstallation.description[lang]}</p>
      <p>{BUSINESS.travel.note[lang]}</p>
      <a class="text-link" href={pricingPath}>{isPL ? 'Sprawdź szczegóły cennika' : 'See pricing details'}</a>
    </div>
  </div>
</section>
