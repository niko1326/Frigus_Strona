---
import { BUSINESS } from '../../../config/site';
import { routeMap, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.pricing;
---

<section class="section" data-reveal>
  <div class="container">
    <div class="plain-stack">
      <p class="eyebrow">{copy.eyebrow}</p>
      <p class="plain-highlight">{BUSINESS.pricing.installationService.fullDescription[lang]}</p>
      <p>{BUSINESS.travel.note[lang]}</p>
      <a class="text-link" href={routeMap.pricing[lang]}>{copy.linkLabel}</a>
    </div>
  </div>
</section>
