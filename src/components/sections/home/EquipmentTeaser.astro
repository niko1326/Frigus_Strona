---
import { EQUIPMENT, type EquipmentModel, type ShowcaseEquipmentModel } from '../../../config/equipment';
import { routeMap, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.equipment;
const isShowcaseModel = (model: EquipmentModel): model is ShowcaseEquipmentModel =>
  model.group === 'recommended' && Boolean(model.colorVariants?.length);
const getModelImage = (models: readonly EquipmentModel[], modelId: string) =>
  models.filter(isShowcaseModel).find((model) => model.id === modelId)?.colorVariants[0].image;
const brands = [
  {
    brand: EQUIPMENT.brands.gree,
    href: routeMap.gree[lang],
    image: getModelImage(EQUIPMENT.brands.gree.models as readonly EquipmentModel[], 'pular')
  },
  {
    brand: EQUIPMENT.brands.kaisai,
    href: routeMap.kaisai[lang],
    image: getModelImage(EQUIPMENT.brands.kaisai.models as readonly EquipmentModel[], 'art')
  }
] as const;
---

<section class="section home-equipment" aria-labelledby="home-equipment-title" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="home-equipment-title">{copy.title}</h2>
    </div>
    <div class="home-brand-grid">
      {
        brands.map(({ brand, href, image }) => (
          <a class:list={['home-brand-card', `home-brand-${brand.id}`]} href={href}>
            <div class="home-brand-visual">
              {image && (
                <img
                  class="home-brand-unit"
                  src={image.src}
                  alt={image.alt[lang]}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
              {brand.overviewImage && (
                <img
                  class="home-brand-logo"
                  src={brand.overviewImage.src}
                  alt={brand.overviewImage.alt[lang]}
                  width={brand.overviewImage.width}
                  height={brand.overviewImage.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div class="home-brand-copy">
              <p>{brand.description[lang].split('.')[0]}.</p>
              <span>{brand.ctaLabel[lang]} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))
      }
    </div>
    <a class="text-link home-equipment-link" href={routeMap.airConditioners[lang]}>
      {copy.linkLabel} <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
