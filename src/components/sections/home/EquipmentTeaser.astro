---
import { routeMap, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.equipment;
---

<section class="section-sm" data-reveal>
  <div class="container plain-stack">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
    <p>{copy.description}</p>
    <a class="text-link" href={routeMap.airConditioners[lang]}>{copy.linkLabel} <span aria-hidden="true">→</span></a>
  </div>
</section>
