---
import type { Locale } from '../../../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isPL = lang === 'pl';

const steps = isPL
  ? [
      { title: 'Telefon', description: 'Krótka rozmowa, orientacyjny zakres i termin wizji lub montażu.' },
      { title: 'Wycena', description: 'Wycena telefoniczna lub na miejscu, zależnie od układu mieszkania.' },
      { title: 'Montaż', description: 'Montaż zwykle trwa około 1 dnia, z zachowaniem porządku.' }
    ]
  : [
      { title: 'Call', description: 'Short call to understand scope and propose a timeline.' },
      { title: 'Quote', description: 'Phone quote or on-site quote depending on layout complexity.' },
      { title: 'Install', description: 'Installation usually takes about one day with a clean finish.' }
    ];
---

<section class="section" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{isPL ? 'Jak to działa' : 'How it works'}</p>
      <h2>{isPL ? 'Prosto: 3 kroki do gotowej klimatyzacji' : 'Simple: 3 steps to working AC'}</h2>
    </div>

    <ol class="steps-plain-list">
      {
        steps.map((step, index) => (
          <li>
            <span class="step-index">0{index + 1}</span>
            <div>
              <h3 class="plain-list-title">{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
