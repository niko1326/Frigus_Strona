---
import type { Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.howItWorks;
---

<section class="section" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
    </div>

    <ol class="steps-plain-list">
      {
        copy.steps.map((step, index) => (
          <li>
            <span class="step-index">0{index + 1}</span>
            <div>
              <h3 class="plain-list-title">{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
