---
const steps = [
  {
    title: 'Rozmowa i wycena',
    description:
      'Dzwonisz, opisujesz mieszkanie lub dom, a my w kilka minut podajemy orientacyjną cenę i proponujemy termin.'
  },
  {
    title: 'Dobór urządzenia',
    description:
      'Dobieramy moc i model klimatyzatora do metrażu, nasłonecznienia i budżetu. Doradzamy, nie sprzedajemy na siłę.'
  },
  {
    title: 'Montaż w 1 dzień',
    description:
      'Montujemy jednostkę wewnętrzną i zewnętrzną, wykonujemy próżnię, uruchamiamy układ i sprzątamy po pracy.'
  },
  {
    title: 'Gwarancja i serwis',
    description:
      'Otrzymujesz 5 lat gwarancji na montaż. W kolejnych sezonach zadbamy też o przeglądy i czyszczenie.'
  }
];
---

<section class="section section-gray" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Jak działamy</p>
      <h2>Od telefonu do chłodu w 4 krokach</h2>
    </div>

    <ol class="timeline">
      {
        steps.map((step, index) => (
          <li class="timeline-item">
            <span class="timeline-marker">{index + 1}</span>
            <div class="timeline-body">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
