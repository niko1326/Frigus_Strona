---
import CTAButton from '../../CTAButton.astro';
import { CONTACTS, PHONE_TEL } from '../../../config/site';
import { labels } from '../../../i18n/content';
---

<section class="section" data-reveal>
  <div class="container cta-band">
    <div>
      <h2>Umów bezpłatną wizytę</h2>
      <p>
        Zadzwoń: {CONTACTS[0].display} ({CONTACTS[0].name}) lub {CONTACTS[1].display} ({CONTACTS[1].name}).
        Opowiedz krótko o pomieszczeniu. Pomożemy dobrać urządzenie i ustalimy dogodny termin wizyty.
      </p>
    </div>
    <CTAButton
      href={`tel:${PHONE_TEL}`}
      label={labels.scheduleVisit}
      ariaLabel={labels.scheduleVisit}
      variant="inverse"
    />
  </div>
</section>
