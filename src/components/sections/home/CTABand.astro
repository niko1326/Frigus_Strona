---
import CTAButton from '../../CTAButton.astro';
import { CONTACT_PHONE } from '../../../config/site';
import { commonLabels, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.cta;
const labels = commonLabels[lang];
---

<section class="section" data-reveal>
  <div class="container cta-inline">
    <p class="plain-highlight plain-highlight-sm">{copy.headline}</p>
    <CTAButton
      href={CONTACT_PHONE.href}
      label={labels.callNow}
      ariaLabel={labels.callNow}
    />
  </div>
</section>
