---
import CTAButton from '../../CTAButton.astro';
import { PHONE_TEL } from '../../../config/site';
import type { Locale } from '../../../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isPL = lang === 'pl';
---

<section class="section" data-reveal>
  <div class="container cta-inline">
    <p class="plain-highlight plain-highlight-sm">{isPL ? 'Zadzwoń i umów wycenę' : 'Call and schedule your quote'}</p>
    <CTAButton
      href={`tel:${PHONE_TEL}`}
      label={isPL ? 'Zadzwoń po darmową wycenę' : 'Call for a free quote'}
      ariaLabel={isPL ? 'Zadzwoń po darmową wycenę' : 'Call for a free quote'}
    />
  </div>
</section>
