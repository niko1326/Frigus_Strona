---
import CTAButton from '../../CTAButton.astro';
import { EQUIPMENT, type EquipmentModel, type ShowcaseEquipmentModel } from '../../../config/equipment';
import { BUSINESS, CONTACT_PHONE } from '../../../config/site';
import { commonLabels, routeMap, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.hero;
const labels = commonLabels[lang];
const pricingText = BUSINESS.pricing.label[lang];
const installationService = BUSINESS.pricing.installationService;
const pricingContext = installationService.name[lang];
const heroTitle = lang === 'pl'
  ? { service: 'Montaż klimatyzacji', separator: ' – ', location: 'Bydgoszcz i okolice' }
  : { service: 'Air conditioning installation', separator: ' in ', location: 'Bydgoszcz & nearby areas' };
const isShowcaseModel = (model: EquipmentModel): model is ShowcaseEquipmentModel =>
  model.group === 'recommended' && Boolean(model.colorVariants?.length);
const greeModels: readonly EquipmentModel[] = EQUIPMENT.brands.gree.models;
const showcaseModels = greeModels.filter(isShowcaseModel);
const heroSelections = [
  {
    modelId: 'pular',
    variantId: 'matt',
    backgroundStart: '#8fb6c0',
    backgroundEnd: '#cbe3df',
    glow: '#ffffff',
    gradientWidth: '94%',
    gradientHeight: '60%',
    gradientOpacity: '0.74'
  },
  {
    modelId: 'pular-pro',
    variantId: 'dark',
    backgroundStart: '#eff9fa',
    backgroundEnd: '#a9dcd7',
    glow: '#ffffff',
    gradientWidth: '110%',
    gradientHeight: '72%',
    gradientOpacity: '0.86'
  },
  {
    modelId: 'clivia',
    variantId: 'navy-blue',
    backgroundStart: '#edf9f8',
    backgroundEnd: '#a8d7e2',
    glow: '#ffffff',
    gradientWidth: '110%',
    gradientHeight: '72%',
    gradientOpacity: '0.86'
  }
] as const;
const heroItems = heroSelections.flatMap((selection) => {
  const model = showcaseModels.find((item) => item.id === selection.modelId);
  const variant = model?.colorVariants.find((item) => item.id === selection.variantId);

  return variant
    ? [
        {
          image: variant.image,
          backgroundStart: selection.backgroundStart,
          backgroundEnd: selection.backgroundEnd,
          glow: selection.glow,
          gradientWidth: selection.gradientWidth,
          gradientHeight: selection.gradientHeight,
          gradientOpacity: selection.gradientOpacity
        }
      ]
    : [];
});
const defaultHeroItem = heroItems[0];
---

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow hero-eyebrow">
        {copy.eyebrow}
      </p>
      <h1 class:list={['hero-title', `hero-title-${lang}`]} aria-label={BUSINESS.serviceType[lang]}>
        <span class="hero-title-part">{heroTitle.service}</span>
        <span class="hero-title-separator" aria-hidden="true">{heroTitle.separator}</span>
        <span class="hero-title-part">{heroTitle.location}</span>
      </h1>

      <div class="hero-price" aria-label={`${pricingContext}: ${pricingText}`}>
        <span>{pricingContext}</span>
        <strong>{pricingText}</strong>
      </div>
      <p class="hero-price-note">{installationService.complexPriceDescription[lang]}</p>

      <div class="hero-actions">
        <CTAButton
          size="sm"
          href={CONTACT_PHONE.href}
          label={labels.callNow}
          ariaLabel={labels.callNow}
        />
        <CTAButton
          size="sm"
          href={routeMap.services[lang]}
          label={labels.seeServices}
          variant="secondary"
        />
      </div>
    </div>

    <a
      class="hero-product-panel"
      href={routeMap.gree[lang]}
      data-reveal
      style={`--hero-bg-start: ${defaultHeroItem.backgroundStart}; --hero-bg-end: ${defaultHeroItem.backgroundEnd}; --hero-glow: ${defaultHeroItem.glow}; --hero-gradient-width: ${defaultHeroItem.gradientWidth}; --hero-gradient-height: ${defaultHeroItem.gradientHeight}; --hero-gradient-opacity: ${defaultHeroItem.gradientOpacity}`}
      data-hero-images={JSON.stringify(
        heroItems.map((item) => ({
          src: item.image.src,
          alt: item.image.alt[lang],
          width: item.image.width,
          height: item.image.height,
          backgroundStart: item.backgroundStart,
          backgroundEnd: item.backgroundEnd,
          glow: item.glow,
          gradientWidth: item.gradientWidth,
          gradientHeight: item.gradientHeight,
          gradientOpacity: item.gradientOpacity
        }))
      )}
      aria-label={lang === 'pl' ? 'Zobacz klimatyzatory GREE' : 'Explore GREE air conditioners'}
    >
      <img
        src={defaultHeroItem.image.src}
        alt={defaultHeroItem.image.alt[lang]}
        width={defaultHeroItem.image.width}
        height={defaultHeroItem.image.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        data-random-hero-image
      />
    </a>
  </div>
</section>

<script>
  const panel = document.querySelector('[data-hero-images]');
  const image = panel?.querySelector('[data-random-hero-image]');

  if (panel instanceof HTMLElement && image instanceof HTMLImageElement) {
    try {
      const images = JSON.parse(panel.dataset.heroImages ?? '[]') as Array<{
        src: string;
        alt: string;
        width: number;
        height: number;
        backgroundStart: string;
        backgroundEnd: string;
        glow: string;
        gradientWidth: string;
        gradientHeight: string;
        gradientOpacity: string;
      }>;

      if (images.length > 1) {
        const randomValues = new Uint32Array(1);
        crypto.getRandomValues(randomValues);
        const selected = images[randomValues[0] % images.length];

        image.src = selected.src;
        image.alt = selected.alt;
        image.width = selected.width;
        image.height = selected.height;
        panel.style.setProperty('--hero-bg-start', selected.backgroundStart);
        panel.style.setProperty('--hero-bg-end', selected.backgroundEnd);
        panel.style.setProperty('--hero-glow', selected.glow);
        panel.style.setProperty('--hero-gradient-width', selected.gradientWidth);
        panel.style.setProperty('--hero-gradient-height', selected.gradientHeight);
        panel.style.setProperty('--hero-gradient-opacity', selected.gradientOpacity);
      }
    } catch {
      // The server-rendered default image remains available if the data cannot be read.
    }
  }
</script>
