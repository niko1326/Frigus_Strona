---
import CTAButton from '../../CTAButton.astro';
import { BUSINESS, PRIMARY_PHONE } from '../../../config/site';
import type { Locale } from '../../../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isPL = lang === 'pl';
const pricingText = BUSINESS.pricing.label[lang];
---

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">
        {BUSINESS.serviceArea.summary[lang]}
      </p>
      <h1>{BUSINESS.serviceType[lang]}</h1>

      <div class="hero-price" aria-label={pricingText}>
        <span>{isPL ? 'Cena montażu' : 'Installation price'}</span>
        <strong>{pricingText}</strong>
      </div>

      <div class="hero-actions">
        <CTAButton
          size="sm"
          href={PRIMARY_PHONE.href}
          label={isPL ? 'Zadzwoń po darmową wycenę' : 'Call for a free quote'}
          ariaLabel={isPL ? 'Zadzwoń po darmową wycenę' : 'Call for a free quote'}
        />
        <CTAButton
          size="sm"
          href={isPL ? '/uslugi' : '/en/services'}
          label={isPL ? 'Zobacz usługi' : 'See services'}
          variant="secondary"
        />
      </div>
    </div>

    <div class="hero-visual" data-reveal>
      <img
        class="hero-photo-img"
        src="/photos/klimatyzator-scienny-haier.png"
        alt={isPL ? 'Klimatyzacja po montażu' : 'Installed air conditioner'}
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>
