---
import CTAButton from '../../CTAButton.astro';
import { BRANDS } from '../../../config/brands';
import { PHONE_TEL, PRICING } from '../../../config/site';
import { labels, routes } from '../../../i18n/content';

const marqueeCities = [
  'Bydgoszcz',
  'Toruń',
  'Gdańsk',
  'Gdynia',
  'Sopot',
  'Osielsko',
  'Białe Błota',
  'Rumia',
  'Reda',
  'Wejherowo',
  'Pruszcz Gdański',
  'Solec Kujawski'
];
---

<section class="hero" data-hero>
  <div class="hero-stage" data-hero-stage aria-hidden="true"></div>

  <div class="hero-fallback" aria-hidden="true">
    <div class="fallback-unit">
      <div class="fallback-glow"></div>
    </div>
  </div>

  <div class="hero-veil" aria-hidden="true"></div>

  <div class="container hero-content">
    <div class="hero-inner">
      <p class="eyebrow">Klimatyzacja. Komfort. Frigac.</p>
      <h1>Montaż klimatyzacji <strong>Bydgoszcz, Toruń i Trójmiasto</strong></h1>
      <p class="hero-lead">
        <span class="hero-lead-lead">Idealna temperatura przez cały rok.</span> Dobieramy i montujemy klimatyzację
        w mieszkaniach i domach - czysto, sprawnie i zwykle w jeden dzień. Pracujemy zgodnie
        z najwyższymi standardami, posiadamy certyfikaty F-gazowe, a na montaż dajemy
        5 lat gwarancji.
      </p>

      <div class="hero-price">
        <span>Klimatyzator z montażem od</span>
        <strong>{PRICING.installFromPLN} zł</strong>
        <span class="hero-price-note">brutto</span>
      </div>

      <div class="hero-actions">
        <CTAButton href={`tel:${PHONE_TEL}`} label={labels.callNow} ariaLabel={labels.callNow} />
        <CTAButton href={routes.pricing} label={labels.readPricing} variant="secondary" />
      </div>

      <ul class="hero-trust">
        <li>5 lat gwarancji</li>
        <li>Certyfikaty F-gazowe</li>
        <li>Dojazd w cenie</li>
      </ul>
    </div>
  </div>

  <a class="brand-chip" data-brand-link href={BRANDS[0].href} data-brands={JSON.stringify(BRANDS)}>
    <span class="brand-chip-label">Na ścianie:</span>
    <strong data-brand-name>{BRANDS[0].name}</strong>
    <span class="brand-chip-cta">zobacz modele</span>
  </a>

  <button
    type="button"
    class="motion-toggle"
    data-motion-toggle
    aria-pressed="false"
    aria-label="Wstrzymaj animacje"
    hidden
  >
    <svg viewBox="0 0 16 16" aria-hidden="true" class="motion-icon-pause">
      <rect x="3.5" y="2.5" width="3" height="11" rx="1" fill="currentColor" />
      <rect x="9.5" y="2.5" width="3" height="11" rx="1" fill="currentColor" />
    </svg>
    <svg viewBox="0 0 16 16" aria-hidden="true" class="motion-icon-play">
      <path d="M4.5 2.8v10.4c0 .8.9 1.3 1.6.9l8-5.2a1 1 0 0 0 0-1.8l-8-5.2a1.05 1.05 0 0 0-1.6.9Z" fill="currentColor" />
    </svg>
  </button>
</section>

<div class="city-marquee" aria-hidden="true">
  <div class="city-viewport">
    <div class="city-track">
      {[...marqueeCities, ...marqueeCities].map((city) => <span>{city}</span>)}
    </div>
  </div>
</div>

<script>
  const hero = document.querySelector('[data-hero]');
  const stage = document.querySelector('[data-hero-stage]');
  const toggle = document.querySelector('[data-motion-toggle]');
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Naprzemienny branding jednostki: co odświeżenie inna marka z naszej oferty.
  type HeroBrand = { name: string; href: string };
  const chip = document.querySelector('[data-brand-link]');
  const brandList: HeroBrand[] = (() => {
    try {
      return JSON.parse(chip?.getAttribute('data-brands') ?? '[]');
    } catch {
      return [];
    }
  })();

  let activeBrand: HeroBrand = brandList[0] ?? { name: 'GREE', href: '/klimatyzatory-gree' };
  if (brandList.length > 1) {
    let index = Math.floor(Math.random() * brandList.length);
    try {
      const previous = Number(localStorage.getItem('frigac-hero-brand'));
      index = Number.isInteger(previous) ? (previous + 1) % brandList.length : index;
      localStorage.setItem('frigac-hero-brand', String(index));
    } catch {
      /* prywatny tryb przeglądarki - zostaje losowa marka */
    }
    activeBrand = brandList[index];
  }

  if (chip instanceof HTMLAnchorElement) {
    chip.href = activeBrand.href;
    const nameEl = chip.querySelector('[data-brand-name]');
    if (nameEl) nameEl.textContent = activeBrand.name;
  }

  if (hero instanceof HTMLElement && stage instanceof HTMLElement) {
    const start = () => {
      import('../../../scripts/hero3d.js')
        .then(({ initHero3D }) => {
          const scene = initHero3D(stage, { brand: activeBrand.name });
          hero.classList.add('is-3d');

          /*
            Kliknięcie w samą jednostkę prowadzi na podstronę marki,
            która akurat jest na scenie. Trafienie liczy raycaster,
            więc klik w puste tło hero nic nie robi.
          */
          stage.addEventListener('pointermove', (event) => {
            stage.classList.toggle('is-hot', scene.hitTest(event.clientX, event.clientY));
          });
          stage.addEventListener('pointerleave', () => stage.classList.remove('is-hot'));
          stage.addEventListener('click', (event) => {
            if (scene.hitTest(event.clientX, event.clientY)) {
              window.location.href = activeBrand.href;
            }
          });

          if (toggle instanceof HTMLButtonElement && !prefersReduced) {
            toggle.hidden = false;
            toggle.addEventListener('click', () => {
              const paused = toggle.getAttribute('aria-pressed') !== 'true';
              toggle.setAttribute('aria-pressed', String(paused));
              toggle.setAttribute(
                'aria-label',
                paused ? 'Wznów animacje' : 'Wstrzymaj animacje'
              );
              scene.setPaused(paused);
              document
                .querySelectorAll('.city-track')
                .forEach((track) => track.classList.toggle('is-paused', paused));
            });
          }
        })
        .catch(() => {
          /* WebGL niedostępny - zostaje statyczny fallback */
        });
    };

    if ('requestIdleCallback' in window) {
      requestIdleCallback(start, { timeout: 1200 });
    } else {
      setTimeout(start, 200);
    }
  }
</script>
