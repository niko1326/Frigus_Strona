---
import CTAButton from '../../CTAButton.astro';
import { BUSINESS, CONTACT_PHONE } from '../../../config/site';
import { commonLabels, routeMap, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.hero;
const labels = commonLabels[lang];
const pricingText = BUSINESS.pricing.label[lang];
const installationService = BUSINESS.pricing.installationService;
const pricingContext = `${installationService.name[lang]} — ${installationService.baseVariantLabel[lang]}`;
---

<section class="hero section">
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">
        {copy.eyebrow}
      </p>
      <h1>{BUSINESS.serviceType[lang]}</h1>

      <div class="hero-price" aria-label={`${pricingContext}: ${pricingText}`}>
        <span>{pricingContext}</span>
        <strong>{pricingText}</strong>
      </div>

      <div class="hero-actions">
        <CTAButton
          size="sm"
          href={CONTACT_PHONE.href}
          label={labels.callNow}
          ariaLabel={labels.callNow}
        />
        <CTAButton
          size="sm"
          href={routeMap.services[lang]}
          label={labels.seeServices}
          variant="secondary"
        />
      </div>
    </div>

    <div class="hero-brand-panel" data-reveal>
      <p class="eyebrow">{copy.visualEyebrow}</p>
      <p class="hero-panel-title">{copy.visualTitle}</p>
      <p>{copy.visualDescription}</p>
    </div>
  </div>
</section>
