---
import { PRICING } from '../../../config/site';
import { routes } from '../../../i18n/content';

const faqItems = [
  {
    question: 'Ile kosztuje montaż klimatyzacji w Gdańsku?',
    answer: `Klimatyzacja z montażem w Gdańsku zaczyna się od ${PRICING.installFromPLN} zł. Inne moce i kolory mogą mieć inne ceny. Dojazd w Gdańsku, Gdyni i Sopocie jest w cenie; realizacje w okolicach uzgadniamy wcześniej. Montujemy na wszystkich osiedlach - od Wrzeszcza i Przymorza po Jasień i Ujeścisko.`,
    priceDetailsLink: true
  },
  {
    question: 'Dlaczego Gdańsk i Trójmiasto?',
    answer:
      'Kilka lat temu przeprowadziliśmy się z Nikodemem Hirschem na studia i wybór padł na Gdańsk - przepiękne miasto nad morzem, które od tamtej pory jest naszym domem i głównym obszarem działania. Gdańsk to też świetne miejsce na rozwój firmy: prawie pół miliona mieszkańców, ponad milion w całej aglomeracji trójmiejskiej i tysiące nowych mieszkań oddawanych co roku na Jasieniu, Ujeścisku, Letnicy czy w Oliwie. Coraz cieplejsze lata i nadmorska wilgotność sprawiają, że zapotrzebowanie na klimatyzację w Gdańsku rośnie z sezonu na sezon - dlatego klimatyzacja Gdańsk, Gdynia i Sopot to dziś zdecydowana większość naszych montaży, od Wrzeszcza i Przymorza po Osową.'
  },
  {
    question: 'Jak szybko może odbyć się montaż klimatyzacji w Gdyni lub Sopocie?',
    answer:
      'Montaż klimatyzacji w Gdyni i Sopocie umawiamy zwykle w ciągu kilku dni od wyceny telefonicznej. Standardowy montaż klimatyzatora split w mieszkaniu lub domu trwa 1 dzień. Tak samo szybko działamy w Bydgoszczy i Toruniu.'
  },
  {
    question: 'Jaka klimatyzacja do mieszkania 50m2?',
    answer:
      'Sam metraż 50 m2 nie wystarcza do doboru klimatyzacji. Dla jednej otwartej strefy orientacyjnym punktem wyjścia może być około 5,0 kW, ale nie oznacza to doboru jednego urządzenia dla całego mieszkania. Moc, liczbę jednostek i ich rozmieszczenie dobieramy indywidualnie, uwzględniając nasłonecznienie, przeszklenia, izolację, wysokość i układ pomieszczeń.'
  },
  {
    question: 'Czy wykonujecie montaż klimatyzacji w bloku?',
    answer:
      'Tak, montaż klimatyzacji w bloku to duża część naszych realizacji - m.in. Gree i Kaisai na gdańskim Przymorzu, Zaspie, Chełmie i we Wrzeszczu czy na Fordonie w Bydgoszczy. Miejsce montażu jednostek dobieramy do układu mieszkania i warunków technicznych, uwzględniając przepływ powietrza, odprowadzenie skroplin oraz dostęp serwisowy.'
  },
  {
    question: 'Czy klimatyzacja może grzać dom zimą?',
    answer:
      'Tak. Nowoczesna klimatyzacja pracuje jako pompa ciepła powietrze-powietrze: latem chłodzi, a zimą efektywnie dogrzewa pomieszczenia - często taniej niż grzejniki elektryczne.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---

<section class="section section-gray" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Najczęstsze pytania</p>
      <h2>Montaż klimatyzacji bez znaków zapytania</h2>
      <p>
        Gdańsk, Gdynia, Sopot czy Bydgoszcz - pytania klientów są podobne. Oto najkrótsze odpowiedzi;
        pełną listę znajdziesz w naszym FAQ.
      </p>
    </div>

    <div class="faq-list">
      {
        faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
            {'priceDetailsLink' in item && item.priceDetailsLink && (
              <a class="price-details-link" href={PRICING.startingPriceDetailsHref}>
                {PRICING.startingPriceLinkLabel}
              </a>
            )}
          </details>
        ))
      }
    </div>

    <a class="text-link" href={routes.faq}>Zobacz wszystkie pytania i odpowiedzi</a>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
