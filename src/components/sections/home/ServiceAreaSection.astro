---
import { BUSINESS } from '../../../config/site';
import type { Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.serviceArea;
const areasLine = BUSINESS.serviceArea.regions.map((region) => region.label[lang]).join(' · ');
---

<section class="section" data-reveal>
  <div class="container plain-stack">
    <div class="plain-stack">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{BUSINESS.serviceArea.summary[lang]}</h2>
      <p>{copy.description}</p>
      <p class="tiny-note">{copy.note}</p>
    </div>
    <p class="plain-area-line">{areasLine}</p>
  </div>
</section>
