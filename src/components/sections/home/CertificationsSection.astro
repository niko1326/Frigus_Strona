---
import { BUSINESS } from '../../../config/site';
import type { Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.certifications;

const certificateImages = BUSINESS.certifications.scans.publicationApproved
  ? BUSINESS.certifications.scans.items
  : [];
---

<section class="section-sm" data-reveal>
  <div class="container plain-stack">
    <p class="eyebrow">{copy.eyebrow}</p>
    <p class="plain-highlight plain-highlight-sm">{BUSINESS.certifications.summary[lang]}</p>
    <p class="tiny-note">{BUSINESS.warranty.description[lang]}</p>
  </div>

  <div class="container gallery-grid" data-reveal>
    {certificateImages.map((image) => (
      <figure class="certificate-card">
        <img src={image.src} alt={image.alt[lang]} loading="lazy" />
      </figure>
    ))}
  </div>
</section>
