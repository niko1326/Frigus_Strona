---
import { BUSINESS, CONTACT_PHONE } from '../../../config/site';
import CTAButton from '../../CTAButton.astro';
import { commonLabels, routeMap, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.certifications;
const credentials = BUSINESS.credentials;
const greeAuthorization = credentials.manufacturerAuthorizations.gree;
const kaisaiAuthorization = credentials.manufacturerAuthorizations.kaisai;
const labels = commonLabels[lang];
const credentialItems = [
  credentials.fGasPersonnel,
  credentials.fGasEntrepreneur,
  greeAuthorization,
  kaisaiAuthorization
] as const;
---

<section class="section-sm" aria-labelledby="credentials-title" data-reveal>
  <div class="container home-closing-grid">
    <div class="home-credentials">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="credentials-title">{copy.title}</h2>
      <ul class="credentials-summary-list">
        {credentialItems.map((item) => <li>{item.title[lang]}</li>)}
      </ul>
      <a class="text-link" href={routeMap.certifications[lang]}>
        {copy.linkLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
    <aside class="home-contact-card" aria-labelledby="home-contact-title">
      <h2 id="home-contact-title">{copy.contactTitle}</h2>
      <a class="home-contact-phone" href={CONTACT_PHONE.href}>{CONTACT_PHONE.display}</a>
      <a href={BUSINESS.contact.email.href}>{BUSINESS.contact.email.address}</a>
      <CTAButton href={CONTACT_PHONE.href} label={labels.callNow} ariaLabel={labels.callNow} />
    </aside>
  </div>
</section>
