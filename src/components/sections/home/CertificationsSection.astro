---
import CertificateCard from '../../CertificateCard.astro';
import CTAButton from '../../CTAButton.astro';
import { GREE_CERTIFICATES, KAISAI_CERTIFICATE } from '../../../config/certificates';

const featuredCertificates = [
  ...GREE_CERTIFICATES.filter((certificate) => certificate.id === 'gree-nikodem'),
  KAISAI_CERTIFICATE
];
---

<section class="section section-gray" data-reveal aria-labelledby="home-certificates-title">
  <div class="container plain-stack">
    <p class="eyebrow">Certyfikaty</p>
    <h2 id="home-certificates-title">Uprawnienia, które możesz sprawdzić</h2>
    <p>
      Posiadamy certyfikaty autoryzacyjne GREE oraz certyfikat Autoryzowanego Partnera Serwisowego KAISAI.
      Poznaj nasze kwalifikacje i dokumenty potwierdzające przygotowanie do montażu klimatyzacji.
    </p>
  </div>
  <div class="container gallery-grid certificate-grid certificate-grid-spaced">
    {featuredCertificates.map((certificate) => <CertificateCard certificate={certificate} />)}
  </div>
  <div class="container certificates-action">
    <CTAButton href="/certyfikaty" label="Zobacz wszystkie certyfikaty i uprawnienia" variant="secondary" />
  </div>
</section>

<style>
  .certificate-grid :global(.document-preview) { aspect-ratio: 1.414; }
  .certificates-action { margin-top: 1.5rem; }
  .certificates-action :global(.cta-button) { white-space: normal; text-align: center; max-width: 100%; }
</style>
