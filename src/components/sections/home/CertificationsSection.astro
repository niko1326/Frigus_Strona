---
import { BUSINESS } from '../../../config/site';

const certificateImages = [
  {
    src: '/photos/certyfikat-1.jpg',
    alt: 'Certyfikat F-gazowy dla personelu FRIGAC'
  },
  {
    src: '/photos/certyfikat-2.jpg',
    alt: 'Certyfikat F-gazowy dla przedsiębiorcy FRIGAC'
  }
];
---

<section class="section section-gray" data-reveal>
  <div class="container plain-stack">
    <p class="eyebrow">Certyfikaty</p>
    <h2>Uprawnienia, które możesz sprawdzić</h2>
    <p>
      Posiadamy certyfikaty F-gazowe dla personelu i przedsiębiorcy, wymagane przy pracy z
      urządzeniami chłodniczymi. Na każdy montaż udzielamy {BUSINESS.warrantyYears} lat gwarancji.
    </p>
  </div>

  <div class="container gallery-grid certificate-grid certificate-grid-spaced" data-reveal>
    {certificateImages.map((image) => (
      <figure class="certificate-card">
        <img src={image.src} alt={image.alt} width="1754" height="1241" loading="lazy" />
      </figure>
    ))}
  </div>
</section>
