---
import { BUSINESS } from '../../../config/site';
import { routeMap, type Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.certifications;
const credentials = BUSINESS.credentials;
const greeAuthorization = credentials.manufacturerAuthorizations.gree;
const kaisaiAuthorization = credentials.manufacturerAuthorizations.kaisai;
const credentialItems = [
  credentials.fGasPersonnel,
  credentials.fGasEntrepreneur,
  greeAuthorization,
  kaisaiAuthorization
] as const;
---

<section class="section-sm" aria-labelledby="credentials-title" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="credentials-title">{copy.title}</h2>
    </div>

    <p class="credentials-intro">{copy.description}</p>
    <ul class="credentials-summary-list">
      {credentialItems.map((item) => <li>{item.title[lang]}</li>)}
    </ul>
    <div class="credentials-link-row">
      <a class="text-link" href={routeMap.certifications[lang]}>
        {copy.linkLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
