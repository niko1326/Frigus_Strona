---
import { BUSINESS } from '../../../config/site';
import type { Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.certifications;
const credentials = BUSINESS.credentials;
const greeAuthorization = credentials.manufacturerAuthorizations.gree;
const authorizationDocuments = greeAuthorization.documents.publicationApproved
  ? greeAuthorization.documents.items
  : [];
---

<section class="section-sm" aria-labelledby="credentials-title" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="credentials-title">{copy.title}</h2>
    </div>

    <div class="card-grid card-grid-3">
      <article class="info-card">
        <h3>{credentials.fGasPersonnel.title[lang]}</h3>
        <p>{credentials.fGasPersonnel.description[lang]}</p>
      </article>

      <article class="info-card">
        <h3>{credentials.fGasEntrepreneur.title[lang]}</h3>
        <p>{credentials.fGasEntrepreneur.description[lang]}</p>
      </article>

      <article class="info-card">
        <h3>{greeAuthorization.title[lang]}</h3>
        <p>{greeAuthorization.description[lang]}</p>
        <p>{greeAuthorization.productSeriesDescription[lang]}</p>
        <p>{greeAuthorization.scopeDescription[lang]}</p>

        {
          authorizationDocuments.length > 0 && (
            <div>
              <p class="plain-list-title">{copy.documentsTitle}</p>
              <p class="tiny-note">{copy.documentsDescription}</p>
              <ul class="bullet-list">
                {authorizationDocuments.map((document) => (
                  <li>
                    <a class="text-link" href={document.src}>
                      {document.label[lang]}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </article>
    </div>
  </div>
</section>
