---
import type { Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.trust;
---

<section class="trust-strip section-sm" data-reveal>
  <div class="container">
    <ul class="trust-inline-list">
      {
        copy.items.map((item) => (
          <li>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
