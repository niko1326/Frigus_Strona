---
import type { Locale } from '../../../i18n/content';
import { pageContent } from '../../../i18n/page-content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].home.services;
---

<section class="section" id="services" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
    </div>

    <ul class="plain-text-list service-list">
      {
        copy.cards.map((card) => (
          <li>
            <h3 class="plain-list-title">{card.title}</h3>
            <p>{card.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
