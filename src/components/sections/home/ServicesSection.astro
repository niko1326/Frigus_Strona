---
import IconIndoor from '../../icons/IconIndoor.astro';
import IconOutdoor from '../../icons/IconOutdoor.astro';
import IconWind from '../../icons/IconWind.astro';
import { routes } from '../../../i18n/content';

const cards = [
  {
    Icon: IconIndoor,
    title: 'Dobór i montaż klimatyzacji',
    description:
      'Pomagamy wybrać urządzenie dopasowane do metrażu i budżetu, a następnie montujemy je z estetycznym poprowadzeniem instalacji.'
  },
  {
    Icon: IconOutdoor,
    title: 'Jednostka zewnętrzna i uruchomienie',
    description:
      'Bezpieczny montaż jednostki zewnętrznej, próżnia, napełnienie układu i pełne uruchomienie z testem działania.'
  },
  {
    Icon: IconWind,
    title: 'Przeglądy i czyszczenie',
    description:
      'Okresowy serwis klimatyzacji: czyszczenie filtrów i wymiennika, kontrola parametrów i higieniczna praca urządzenia.'
  }
];
---

<section class="section" id="services" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Usługi</p>
      <h2>Czym zajmujemy się na co dzień</h2>
    </div>

    <div class="card-grid card-grid-3">
      {
        cards.map(({ Icon, title, description }) => (
          <article class="info-card">
            <Icon class="service-icon" />
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))
      }
    </div>

    <a class="text-link" href={routes.services}>Zobacz pełny zakres usług</a>
  </div>
</section>
