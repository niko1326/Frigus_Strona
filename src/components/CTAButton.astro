---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  ariaLabel?: string;
  fullWidth?: boolean;
  size?: 'sm' | 'md' | 'lg';
}

const {
  href,
  label,
  variant = 'primary',
  ariaLabel,
  fullWidth = false
  ,
  size = 'md'
} = Astro.props;

const sizeClass = size === 'md' ? '' : `cta-${size}`;
const classNames = ['cta-button', `cta-${variant}`, sizeClass, fullWidth ? 'cta-full' : ''].join(' ').trim();
---

<a class={classNames} href={href} aria-label={ariaLabel ?? label}>
  {label}
</a>
