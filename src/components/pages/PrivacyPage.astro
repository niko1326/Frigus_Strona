---
import { pageMeta, routeMap, type Locale } from '../../i18n/content';
import { pageContent } from '../../i18n/page-content';
import Layout from '../Layout.astro';
import PageHero from '../PageHero.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].privacy;
const meta = pageMeta[lang].privacy;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routeMap.privacy[lang]}
>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} description={copy.hero.description} />

  <section class="section">
    <div class="container highlight-card" data-reveal>
      <ul class="bullet-list">
        {copy.items.map((item) => <li>{item}</li>)}
      </ul>
      <p class="tiny-note">{copy.note}</p>
    </div>
  </section>
</Layout>
