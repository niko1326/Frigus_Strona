---
import { BUSINESS, CONTACT_PHONE } from '../../config/site';
import { commonLabels, pageMeta, routeMap, type Locale } from '../../i18n/content';
import { pageContent } from '../../i18n/page-content';
import CTAButton from '../CTAButton.astro';
import Layout from '../Layout.astro';
import PageHero from '../PageHero.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].contact;
const labels = commonLabels[lang];
const meta = pageMeta[lang].contact;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
  currentPath={routeMap.contact[lang]}
>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} description={copy.hero.description} />

  <section class="section">
    <div class="container contact-panel" data-reveal>
      <p>
        <a class="phone-big" href={CONTACT_PHONE.href} aria-label={labels.phoneAria}>{CONTACT_PHONE.display}</a>{' '}
        — {CONTACT_PHONE.contactName}
      </p>
      <a href={BUSINESS.contact.email.href} aria-label={labels.emailAria}>{BUSINESS.contact.email.address}</a>
      <ul class="bullet-list">
        <li>{copy.availabilityLabel}: {BUSINESS.availability.label[lang]}</li>
        <li>{copy.areaLabel}: {BUSINESS.serviceArea.summary[lang]}</li>
      </ul>
      <p class="tiny-note">{copy.note}</p>
      <CTAButton href={CONTACT_PHONE.href} label={labels.callNow} ariaLabel={labels.callNow} />
    </div>
  </section>
</Layout>
