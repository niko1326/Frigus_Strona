---
import { CONTACT_PHONE } from '../../config/site';
import { commonLabels, pageMeta, routeMap, type Locale } from '../../i18n/content';
import { pageContent } from '../../i18n/page-content';
import CTAButton from '../CTAButton.astro';
import Layout from '../Layout.astro';
import PageHero from '../PageHero.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].faq;
const labels = commonLabels[lang];
const meta = pageMeta[lang].faq;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routeMap.faq[lang]}
>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} description={copy.hero.description} />

  <section class="section">
    <div class="container faq-list" data-reveal>
      {
        copy.items.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal>
      <CTAButton href={CONTACT_PHONE.href} label={labels.callNow} ariaLabel={labels.callNow} />
    </div>
  </section>
</Layout>
