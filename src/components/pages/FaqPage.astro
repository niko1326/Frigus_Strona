---
import { CONTACT_PHONE } from '../../config/site';
import { commonLabels, pageMeta, routeMap, type Locale } from '../../i18n/content';
import { pageContent } from '../../i18n/page-content';
import CTAButton from '../CTAButton.astro';
import Layout from '../Layout.astro';
import PageHero from '../PageHero.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].faq;
const labels = commonLabels[lang];
const meta = pageMeta[lang].faq;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
  currentPath={routeMap.faq[lang]}
>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} description={copy.hero.description} />

  <section class="section">
    <div class="container faq-list" data-reveal>
      {
        copy.items.map((item) => (
          <details class="faq-item" name="faq">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
            {'links' in item && item.links && (
              <ul class="faq-links">
                {item.links.map((link) => (
                  <li><a class="text-link" href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </details>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal>
      <CTAButton
        href={CONTACT_PHONE.href}
        label={labels.selectAirConditioner}
        ariaLabel={`${labels.phoneActionPrefix} — ${labels.selectAirConditioner}`}
      />
    </div>
  </section>
</Layout>
