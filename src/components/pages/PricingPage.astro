---
import { BUSINESS, CONTACT_PHONE } from '../../config/site';
import { commonLabels, pageMeta, routeMap, type Locale } from '../../i18n/content';
import { pageContent } from '../../i18n/page-content';
import CTAButton from '../CTAButton.astro';
import Layout from '../Layout.astro';
import PageHero from '../PageHero.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = pageContent[lang].pricing;
const labels = commonLabels[lang];
const meta = pageMeta[lang].pricing;
const installationService = BUSINESS.pricing.installationService;
const baseScope = installationService.baseVariantScope;
const condensateDrainage = installationService.condensateDrainage;
const maintenanceService = BUSINESS.pricing.maintenanceService;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
  currentPath={routeMap.pricing[lang]}
>
  <PageHero eyebrow={copy.hero.eyebrow} title={copy.hero.title} description={copy.hero.description} />

  <section class="section">
    <div class="container pricing-content" data-reveal>
      <div class="pricing-layout">
        <article class="pricing-panel pricing-main-card">
          <p class="eyebrow">{installationService.baseVariantLabel[lang]}</p>
          <p class="price-main">{BUSINESS.pricing.label[lang]}</p>
          <p>{baseScope.description[lang]}</p>

          <h2>{copy.includedTitle}</h2>
          <ul class="pricing-included-list">
            {baseScope.includedItems.map((item) => <li>{item[lang]}</li>)}
          </ul>
        </article>

        <aside class="pricing-details-card">
          <section>
            <h2>{copy.conditionsTitle}</h2>
            <p>{baseScope.electricalCondition[lang]}</p>
            <p>{BUSINESS.travel.note[lang]}</p>
          </section>

          <section>
            <h2>{copy.projectQuoteTitle}</h2>
            <p>{baseScope.priceSubject[lang]}</p>
            <p>{baseScope.devicePricingDescription[lang]}</p>
            <p>{installationService.complexPriceDescription[lang]}</p>
          </section>

          <section>
            <h2>{condensateDrainage.title[lang]}</h2>
            <p>{condensateDrainage.pumpOption.description[lang]}</p>
          </section>

          <p class="tiny-note">{BUSINESS.pricing.taxNote[lang]}</p>
        </aside>
      </div>

      <article class="pricing-panel pricing-maintenance-card">
        <div>
          <h2>{maintenanceService.name[lang]}</h2>
          <p class="price-main price-service">{maintenanceService.label[lang]}</p>
        </div>
        <div class="pricing-maintenance-details">
          <h3>{copy.maintenanceIncludedTitle}</h3>
          <ul class="pricing-included-list">
            {maintenanceService.includedItems.map((item) => <li>{item[lang]}</li>)}
          </ul>
          <p class="tiny-note">{maintenanceService.priceNote[lang]}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container pricing-contact" data-reveal>
      <div>
        <h2>{copy.contactTitle}</h2>
        <p>{copy.phoneNote}</p>
      </div>
      <CTAButton href={CONTACT_PHONE.href} label={labels.callNow} ariaLabel={labels.callNow} />
    </div>
  </section>
</Layout>
