---
import type { Locale } from '../i18n/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isPL = lang === 'pl';
---

<section class="section" data-reveal>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{isPL ? 'Realizacje' : 'Portfolio'}</p>
      <h2>{isPL ? 'Miejsce na zdjęcia z montaży' : 'Space for installation photos'}</h2>
      <p>
        {isPL
          ? 'Na etapie startu używamy minimalistycznych placeholderów. Zdjęcia można podmienić później bez zmian układu.'
          : 'At launch we use minimal placeholders. Real photos can be dropped in later without layout changes.'}
      </p>
    </div>
    <div class="gallery-grid">
      <div class="gallery-placeholder" aria-hidden="true"></div>
      <div class="gallery-placeholder" aria-hidden="true"></div>
      <div class="gallery-placeholder" aria-hidden="true"></div>
    </div>
  </div>
</section>
