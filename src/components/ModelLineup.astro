---
import { routes } from '../i18n/content';

export type LineupModel = {
  /** Nazwa serii tak, jak nazywa ją producent. */
  name: string;
  /** Jednozdaniowy opis: dla kogo i po co ta seria. */
  tagline: string;
  /** Plik zdjęcia w /photos/modele/. */
  image: string;
  /** Tekst alternatywny obrazu. */
  alt: string;
  /** Warianty mocy chłodniczej w kW, np. ['2,6', '3,5', '5,3']. */
  capacities: string[];
  /** Klasa energetyczna, np. 'A+++ / A++'. */
  energyClass?: string;
  /** Poziom hałasu jednostki wewnętrznej, np. 'od 19 dB(A)'. */
  noise?: string;
  /** Krótkie cechy wyróżniające serię. */
  features: string[];
  /** Etykieta wyróżnienia, np. 'Najczęściej wybierana'. */
  badge?: string;
};

interface Props {
  brand: string;
  models: LineupModel[];
}

const { brand, models } = Astro.props;
---

<ul class="lineup-grid" role="list">
  {
    models.map((model) => (
      <li>
        <a
          class="lineup-card"
          href={routes.contact}
          aria-label={`${brand} ${model.name} - zapytaj o wycenę`}
        >
          <span class="lineup-media">
            {model.badge && <span class="lineup-badge">{model.badge}</span>}
            <img
              src={model.image}
              alt={model.alt}
              width="640"
              height="420"
              loading="lazy"
              decoding="async"
            />
          </span>

          <span class="lineup-body">
            <span class="lineup-name">
              <span class="lineup-brand">{brand}</span> {model.name}
            </span>
            <span class="lineup-tagline">{model.tagline}</span>

            <span class="lineup-specs">
              <span class="lineup-spec">
                <span class="lineup-spec-key">Warianty mocy</span>
                <span class="lineup-spec-val">{model.capacities.join(' / ')} kW</span>
              </span>
              {model.energyClass && (
                <span class="lineup-spec">
                  <span class="lineup-spec-key">Klasa energetyczna</span>
                  <span class="lineup-spec-val">{model.energyClass}</span>
                </span>
              )}
              {model.noise && (
                <span class="lineup-spec">
                  <span class="lineup-spec-key">Głośność</span>
                  <span class="lineup-spec-val">{model.noise}</span>
                </span>
              )}
            </span>

            <span class="lineup-features">
              {model.features.map((feature) => (
                <span class="lineup-feature">{feature}</span>
              ))}
            </span>

            <span class="lineup-cta">
              Zapytaj o wycenę
              <svg class="lineup-cta-arrow" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M4 12h15M13 6l6 6-6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
