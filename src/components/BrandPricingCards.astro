---
import { getLowestInstalledPrice, type LineupModel } from '../config/lineups';

type BrandPricingItem = {
  name: string;
  href: string;
  models: LineupModel[];
};

interface Props {
  brands: BrandPricingItem[];
}

const { brands } = Astro.props;
const priceFormatter = new Intl.NumberFormat('pl-PL');
---

<div class="content-grid brand-pricing-grid">
  {
    brands.map((brand) => {
      const lowestPrice = getLowestInstalledPrice(brand.models);

      return (
        <article class="info-card brand-pricing-card">
          <p class="eyebrow">{brand.name}</p>
          <h3>
            {lowestPrice
              ? `Klimatyzatory z montażem od ${priceFormatter.format(lowestPrice)} zł`
              : `Aktualne ceny urządzeń z montażem znajdziesz w kategorii ${brand.name}.`}
          </h3>
          <a class="text-link" href={brand.href}>Zobacz modele i ceny {brand.name}</a>
        </article>
      );
    })
  }
</div>

<style>
  .brand-pricing-grid {
    margin-top: 1.5rem;
  }

  .brand-pricing-card .eyebrow {
    margin: 0;
  }

  .brand-pricing-card .text-link {
    align-self: end;
    margin-top: 0.35rem;
  }
</style>
