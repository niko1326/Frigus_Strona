---
type BrandPricingItem = {
  name: string;
  href: string;
};

interface Props {
  brands: BrandPricingItem[];
}

const { brands } = Astro.props;
---

<div class="content-grid brand-pricing-grid">
  {
    brands.map((brand) => (
        <article class="info-card brand-pricing-card">
          <p class="eyebrow">{brand.name}</p>
          <h3>Modele {brand.name} z cenami urządzeń i standardowego montażu</h3>
          <a class="text-link" href={brand.href}>Zobacz modele i ceny {brand.name}</a>
        </article>
      ))
  }
</div>

<style>
  .brand-pricing-grid {
    margin-top: 1.5rem;
  }

  .brand-pricing-card .eyebrow {
    margin: 0;
  }

  .brand-pricing-card .text-link {
    align-self: end;
    margin-top: 0.35rem;
  }
</style>
