---
import type { PageHeroContent } from '../i18n/page-content';

type Props = PageHeroContent;

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero">
  <div class="container" data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
