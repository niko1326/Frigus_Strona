---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { POWER_CALCULATOR_CONFIG } from '../config/powerCalculator';
import { PHONE_DISPLAY, PHONE_TEL, SITE } from '../config/site';
import { labels, pageMeta, routes } from '../i18n/content';

const meta = pageMeta.calcPower;

const powerTable = [
  { area: 'do 25 m²', kw: 'około 2,5 kW', btu: 'około 9 000 BTU' },
  { area: '26-35 m²', kw: 'około 3,5 kW', btu: 'około 12 000 BTU' },
  { area: '36-50 m²', kw: 'około 5,0 kW', btu: 'około 18 000 BTU' },
  { area: '51-70 m²', kw: 'około 7,0 kW', btu: 'około 24 000 BTU' },
  { area: 'powyżej 70 m²', kw: 'indywidualny dobór', btu: 'możliwe zastosowanie kilku jednostek' }
];

const faqItems = [
  {
    question: 'Ile kW klimatyzacji potrzeba na m2?',
    answer:
      'Przyjmuje się około 100 W (0,1 kW) mocy chłodniczej na 1 m2 pomieszczenia o standardowej wysokości. To tylko punkt wyjścia: ostateczny dobór zależy również od nasłonecznienia, przeszkleń, izolacji, położenia i układu pomieszczeń.'
  },
  {
    question: 'Ile BTU na m2 pomieszczenia?',
    answer:
      '1 kW mocy chłodniczej to około 3 412 BTU/h. Reguła 100 W na m2 przekłada się więc na około 340 BTU na 1 m2. To przelicznik orientacyjny, a nie dobór urządzenia. Moc dobieramy indywidualnie do nasłonecznienia, przeszkleń, izolacji i układu pomieszczeń.'
  },
  {
    question: 'Jaki klimatyzator do 50 m2?',
    answer:
      'Wynik dla 50 m2 jest orientacyjny i nie przesądza o mocy ani liczbie jednostek. Dobieramy je indywidualnie, uwzględniając nasłonecznienie, przeszklenia, izolację, wysokość i układ pomieszczeń. Jedna otwarta przestrzeń wymaga innego podejścia niż kilka oddzielnych pokoi.'
  },
  {
    question: 'Czy wynik kalkulatora wystarczy do zakupu klimatyzacji?',
    answer:
      'Kalkulator daje rzetelne przybliżenie, ale ostateczny dobór mocy warto potwierdzić z instalatorem, który uwzględni układ pomieszczeń i miejsce montażu jednostek. W FRIGAC taka weryfikacja i wycena są bezpłatne.'
  },
  {
    question: 'Jaka moc klimatyzacji do domu z poddaszem?',
    answer:
      'Poddasze zwykle nagrzewa się mocniej niż pomieszczenie na środkowym piętrze. Kalkulator stosuje umiarkowaną korektę, ale rzeczywisty dobór nadal zależy od izolacji dachu, przeszkleń i nasłonecznienia.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator mocy klimatyzacji FRIGAC',
  url: new URL(routes.calcPower, SITE.siteUrl).toString(),
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  provider: { '@type': 'Organization', name: SITE.brandName, url: SITE.siteUrl }
};
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routes.calcPower}
  extraSchema={[appSchema, faqSchema]}
>
  <Breadcrumbs items={[{ label: 'Narzędzia', href: routes.tools }, { label: 'Kalkulator mocy klimatyzacji' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Darmowe narzędzie</p>
      <h1>Kalkulator mocy klimatyzacji</h1>
      <p>
        Oszacuj moc klimatyzatora dla jednej strefy na podstawie powierzchni, wysokości,
        nasłonecznienia, położenia i przeszkleń. Wynik jest wstępną wskazówką, a nie projektem
        obciążenia cieplnego.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container tool-layout" data-reveal>
      <form class="tool-form" id="power-form">
        <div class="tool-step">
          <p class="tool-step-title"><span class="tool-step-num">1</span>Powierzchnia pomieszczenia</p>
          <div class="range-row">
            <input type="range" id="area" min={POWER_CALCULATOR_CONFIG.area.min} max={POWER_CALCULATOR_CONFIG.area.max} step="1" value={POWER_CALCULATOR_CONFIG.area.default} aria-label="Powierzchnia w metrach kwadratowych" />
            <output class="range-value" id="area-out" for="area">{POWER_CALCULATOR_CONFIG.area.default} m²</output>
          </div>
          <p class="tool-hint">Metraż jednej strefy chłodzenia (np. salon z aneksem), nie całego domu.</p>
        </div>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">2</span>Wysokość pomieszczenia</legend>
          <div class="seg">
            {Object.entries(POWER_CALCULATOR_CONFIG.height).map(([value, item], index) => (
              <>
                <input type="radio" name="height" id={`height-${value}`} value={value} checked={index === 0} />
                <label for={`height-${value}`}>{item.label}</label>
              </>
            ))}
          </div>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">3</span>Nasłonecznienie</legend>
          <div class="seg">
            {Object.entries(POWER_CALCULATOR_CONFIG.sun).map(([value, item]) => (
              <>
                <input type="radio" name="sun" id={`sun-${value}`} value={value} checked={value === 'standard'} />
                <label for={`sun-${value}`}>{item.label}</label>
              </>
            ))}
          </div>
          <p class="tool-hint">Duże oznacza pomieszczenie mocno nagrzewające się od słońca przez znaczną część dnia.</p>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">4</span>Położenie pomieszczenia</legend>
          <div class="seg">
            {Object.entries(POWER_CALCULATOR_CONFIG.location).map(([value, item], index) => (
              <>
                <input type="radio" name="location" id={`location-${value}`} value={value} checked={index === 0} />
                <label for={`location-${value}`}>{item.label}</label>
              </>
            ))}
          </div>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">5</span>Czy pomieszczenie ma duże przeszklenia?</legend>
          <div class="seg">
            {Object.entries(POWER_CALCULATOR_CONFIG.glazing).map(([value, item], index) => (
              <>
                <input type="radio" name="glazing" id={`glazing-${value}`} value={value} checked={index === 0} />
                <label for={`glazing-${value}`}>{item.label}</label>
              </>
            ))}
          </div>
          <p class="tool-hint">Chodzi o szerokie okna, przeszklenia od podłogi lub dużą przeszkloną część ściany.</p>
        </fieldset>
      </form>

      <div class="tool-result-wrap">
        <div class="tool-result" role="status" aria-live="polite">
          <p class="eyebrow">Orientacyjny dobór</p>
          <p class="result-main"><strong id="res-kw">około 3,5 kW</strong></p>
          <p class="result-sub" id="res-btu">typowy wariant około 12 000 BTU/h</p>
          <dl class="result-rows">
            <div class="result-row">
              <dt>Szacunkowe zapotrzebowanie</dt>
              <dd id="res-need">około 3,5 kW</dd>
            </div>
            <div class="result-row" id="res-devices-row">
              <dt>Przykładowe urządzenia</dt>
              <dd><a href={routes.gree} id="res-gree">GREE około 3,5 kW</a>{' lub '}<a href={routes.kaisai} id="res-kaisai">KAISAI około 3,5 kW</a></dd>
            </div>
            <div class="result-row">
              <dt>Co dalej</dt>
              <dd id="res-system">Potwierdzimy moc i model po sprawdzeniu warunków montażu.</dd>
            </div>
          </dl>
          <CTAButton href={`tel:${PHONE_TEL}`} label="Potwierdź bezpłatny dobór" ariaLabel={labels.phoneAria} />
          <button type="button" class="btn-report" id="btn-report">
            Pobierz raport (PDF)
          </button>
          <p class="tool-disclaimer">
            To wstępny dobór. Ostateczna moc zależy również od układu pomieszczeń, przeszkleń,
            nasłonecznienia i warunków na miejscu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container article-content" data-reveal>
      <h2>Ile kW klimatyzacji na m²?</h2>
      <p>
        Podstawowa reguła doboru mocy klimatyzacji jest prosta: <strong>około 100 W (0,1 kW) mocy
        chłodniczej na 1 m²</strong> pomieszczenia o wysokości 2,5-2,7 m. To punkt wyjścia, który
        kalkulator umiarkowanie koryguje o wysokość, nasłonecznienie, duże przeszklenia oraz położenie
        na ostatnim piętrze lub poddaszu. Nie zastępuje to obliczeń obciążenia cieplnego.
      </p>

      <h2>Jaka moc klimatyzacji na 20, 30, 50 czy 100 m²?</h2>
      <div class="table-wrap">
        <table class="tool-table">
          <caption class="visually-hidden">Orientacyjna moc klimatyzacji według metrażu</caption>
          <thead>
            <tr>
              <th scope="col">Metraż</th>
              <th scope="col">Orientacyjna moc</th>
              <th scope="col">Ile BTU</th>
            </tr>
          </thead>
          <tbody>
            {
              powerTable.map((row) => (
                <tr>
                  <td>{row.area}</td>
                  <td>{row.kw}</td>
                  <td>{row.btu}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="tiny-note">
        Wartości orientacyjne dla pojedynczej, otwartej strefy o standardowej wysokości i przeciętnym
        nasłonecznieniu. Powyżej 70 m² nie zakładamy automatycznie jednego klimatyzatora. Ostateczną
        moc i liczbę jednostek dobieramy do przeszkleń, izolacji i układu pomieszczeń.
        Opracowanie własne FRIGAC na podstawie praktyki montażowej.
      </p>

      <h2>Ile BTU na m²?</h2>
      <p>
        BTU/h to jednostka używana głównie w krajach anglosaskich: <strong>1 kW ≈ 3 412 BTU/h</strong>.
        Reguła 100 W/m² odpowiada więc około 340 BTU na metr kwadratowy. Popularne moce urządzeń to
        9 000 BTU (2,5 kW), 12 000 BTU (3,5 kW) i 18 000 BTU (5 kW).
      </p>

      <h2>Za mała czy za duża - dlaczego moc musi być trafiona?</h2>
      <p>
        Zbyt słaby klimatyzator pracuje bez przerwy na pełnej mocy: głośno, energochłonnie i bez
        osiągnięcia zadanej temperatury w upał. Zbyt mocny taktuje - włącza się i wyłącza w krótkich
        cyklach, gorzej osusza powietrze i szybciej się zużywa. Dlatego dobór mocy to najważniejsza
        decyzja przy zakupie klimatyzacji - ważniejsza niż marka czy dodatkowe funkcje.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Kalkulator mocy klimatyzacji - pytania</h2>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Przydatne przy wyborze:</p>
      <a class="text-link" href={routes.calcCost}>Kalkulator kosztów klimatyzacji</a>
      <a class="text-link" href={routes.calcEnergy}>Ile prądu zużywa klimatyzacja</a>
      <a class="text-link" href="/porady/jaka-klimatyzacja-do-mieszkania">Jaka klimatyzacja do mieszkania</a>
      <a class="text-link" href={routes.pricing}>Cennik montażu</a>
    </div>
  </section>

  <div class="print-report" id="print-report" aria-hidden="true">
    <p class="print-heading">RAPORT DOBORU KLIMATYZACJI - FRIGAC</p>
    <p>frigac.pl · tel. {PHONE_DISPLAY} · raport orientacyjny wygenerowany przez kalkulator online</p>
    <table>
      <tbody>
        <tr><th>Powierzchnia</th><td id="rp-area">-</td></tr>
        <tr><th>Wysokość</th><td id="rp-height">-</td></tr>
        <tr><th>Nasłonecznienie</th><td id="rp-sun">-</td></tr>
        <tr><th>Położenie</th><td id="rp-location">-</td></tr>
        <tr><th>Duże przeszklenia</th><td id="rp-glazing">-</td></tr>
        <tr><th>Szacowane zapotrzebowanie</th><td id="rp-need">-</td></tr>
        <tr><th>Rekomendowana moc</th><td id="rp-kw">-</td></tr>
        <tr><th>Ile BTU</th><td id="rp-btu">-</td></tr>
        <tr><th>Proponowane urządzenia</th><td id="rp-devices">-</td></tr>
      </tbody>
    </table>
    <p>
      Chcesz dokładny dobór? FRIGAC wykona bezpłatną wycenę - zadzwoń: {PHONE_DISPLAY}.
      Działamy w Bydgoszczy, Toruniu i Trójmieście. Wynik kalkulatora jest orientacyjny
      i nie stanowi oferty handlowej.
    </p>
  </div>
</Layout>

<script>
  import {
    POWER_CALCULATOR_CONFIG,
    calculatePowerEstimate,
    type PowerCalculatorInput
  } from '../config/powerCalculator';

  const $ = (id: string) => document.getElementById(id);
  const area = $('area') as HTMLInputElement;
  const form = $('power-form') as HTMLFormElement;

  const radioVal = (name: string): string => {
    const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    return el?.value ?? '';
  };

  const radioLabel = (name: string): string => {
    const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    if (!el) return '-';
    const label = document.querySelector<HTMLLabelElement>(`label[for="${el.id}"]`);
    return label ? label.textContent!.trim() : '-';
  };

  const fmt1 = (value: number) => value.toFixed(1).replace('.', ',');

  let last = {
    needKw: 3.5,
    kwText: 'około 3,5 kW',
    btuText: 'około 12 000 BTU/h',
    devices: 'GREE lub KAISAI około 3,5 kW'
  };

  function compute() {
    if (!area || !form) return;
    const a = Math.min(
      Math.max(parseFloat(area.value) || POWER_CALCULATOR_CONFIG.area.min, POWER_CALCULATOR_CONFIG.area.min),
      POWER_CALCULATOR_CONFIG.area.max
    );
    const input: PowerCalculatorInput = {
      area: a,
      height: radioVal('height') as PowerCalculatorInput['height'],
      sun: radioVal('sun') as PowerCalculatorInput['sun'],
      location: radioVal('location') as PowerCalculatorInput['location'],
      glazing: radioVal('glazing') as PowerCalculatorInput['glazing']
    };
    const estimate = calculatePowerEstimate(input);
    ($('area-out') as HTMLElement).textContent = `${a} m²`;
    ($('res-need') as HTMLElement).textContent = `około ${fmt1(estimate.needKw)} kW`;

    if (estimate.kind === 'individual') {
      ($('res-kw') as HTMLElement).textContent = 'Indywidualny dobór';
      ($('res-btu') as HTMLElement).textContent = estimate.reason === 'area'
        ? 'Ta przestrzeń wymaga indywidualnego doboru lub zastosowania kilku jednostek.'
        : 'W tej przestrzeni warto rozważyć kilka jednostek lub indywidualny dobór instalacji.';
      ($('res-system') as HTMLElement).textContent = 'Sprawdzimy układ pomieszczeń i dobierzemy liczbę oraz moc jednostek.';
      ($('res-devices-row') as HTMLElement).hidden = true;
      last = {
        needKw: estimate.needKw,
        kwText: 'indywidualny dobór',
        btuText: 'dobór po sprawdzeniu układu pomieszczeń',
        devices: 'dobór indywidualny lub kilka jednostek'
      };
      return;
    }

    const kwText = `około ${estimate.powerKw} kW`;
    const btuText = `typowy wariant około ${estimate.btu} BTU/h`;
    ($('res-kw') as HTMLElement).textContent = kwText;
    ($('res-btu') as HTMLElement).textContent = btuText;
    ($('res-system') as HTMLElement).textContent = 'Potwierdzimy moc i model po sprawdzeniu warunków montażu.';
    ($('res-devices-row') as HTMLElement).hidden = false;
    ($('res-gree') as HTMLElement).textContent = `GREE około ${estimate.powerKw} kW`;
    ($('res-kaisai') as HTMLElement).textContent = `KAISAI około ${estimate.powerKw} kW`;
    last = {
      needKw: estimate.needKw,
      kwText,
      btuText: `około ${estimate.btu} BTU/h`,
      devices: `GREE lub KAISAI około ${estimate.powerKw} kW`
    };
  }

  form?.addEventListener('input', compute);
  compute();

  // wypełniona część ścieżki suwaka
  document.querySelectorAll<HTMLInputElement>('.range-row input[type="range"]').forEach((r) => {
    const setFill = () => {
      const min = parseFloat(r.min) || 0;
      const max = parseFloat(r.max) || 100;
      const pct = ((parseFloat(r.value) - min) / (max - min)) * 100;
      r.style.setProperty('--fill', `${pct.toFixed(1)}%`);
    };
    r.addEventListener('input', setFill);
    setFill();
  });

  $('btn-report')?.addEventListener('click', () => {
    ($('rp-area') as HTMLElement).textContent = `${area.value} m²`;
    ($('rp-height') as HTMLElement).textContent = radioLabel('height');
    ($('rp-sun') as HTMLElement).textContent = radioLabel('sun');
    ($('rp-location') as HTMLElement).textContent = radioLabel('location');
    ($('rp-glazing') as HTMLElement).textContent = radioLabel('glazing');
    ($('rp-need') as HTMLElement).textContent = `około ${fmt1(last.needKw)} kW`;
    ($('rp-kw') as HTMLElement).textContent = last.kwText;
    ($('rp-btu') as HTMLElement).textContent = last.btuText;
    ($('rp-devices') as HTMLElement).textContent = last.devices;

    document.documentElement.classList.add('printing-report');
    const cleanup = () => {
      document.documentElement.classList.remove('printing-report');
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  });
</script>
