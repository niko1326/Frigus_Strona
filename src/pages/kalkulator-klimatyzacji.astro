---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { PHONE_DISPLAY, PHONE_TEL, SITE } from '../config/site';
import { labels, pageMeta, routes } from '../i18n/content';

const meta = pageMeta.calcPower;

const powerTable = [
  { area: '20 m²', kw: '2,0-2,5 kW', btu: '7 000-9 000 BTU' },
  { area: '30 m²', kw: '2,5-3,5 kW', btu: '9 000-12 000 BTU' },
  { area: '40 m²', kw: '3,5 kW', btu: '12 000 BTU' },
  { area: '50 m²', kw: '3,5-4,2 kW', btu: '12 000-14 000 BTU' },
  { area: '60 m²', kw: '4,2-5,0 kW', btu: '14 000-17 000 BTU' },
  { area: '70 m²', kw: '5,0-6,0 kW', btu: '17 000-20 000 BTU' },
  { area: '100 m²', kw: 'multisplit 2 × 3,5 kW', btu: '2 × 12 000 BTU' }
];

const faqItems = [
  {
    question: 'Ile kW klimatyzacji potrzeba na m2?',
    answer:
      'Przyjmuje się około 100 W (0,1 kW) mocy chłodniczej na 1 m2 pomieszczenia o standardowej wysokości 2,5-2,7 m. Do mieszkania 35 m2 potrzeba więc około 3,5 kW. Przy dużym nasłonecznieniu, poddaszu lub dużych przeszkleniach zapotrzebowanie rośnie nawet o 20-30%.'
  },
  {
    question: 'Ile BTU na m2 pomieszczenia?',
    answer:
      '1 kW mocy chłodniczej to około 3 412 BTU/h. Reguła 100 W na m2 przekłada się więc na około 340 BTU na 1 m2. Pokój 25 m2 potrzebuje około 8 500 BTU, a salon 40 m2 - około 12 000 BTU.'
  },
  {
    question: 'Jaki klimatyzator do 50 m2?',
    answer:
      'Do otwartej przestrzeni około 50 m2 zwykle rekomendujemy klimatyzator 3,5-4,2 kW (12 000-14 000 BTU), np. jednostkę Gree lub Kaisai o mocy nominalnej 3,5 kW przy przeciętnym nasłonecznieniu. Jeśli 50 m2 to dwa oddzielne pokoje, lepszym wyborem są dwie mniejsze jednostki lub multisplit.'
  },
  {
    question: 'Czy wynik kalkulatora wystarczy do zakupu klimatyzacji?',
    answer:
      'Kalkulator daje rzetelne przybliżenie, ale ostateczny dobór mocy warto potwierdzić z instalatorem, który uwzględni układ pomieszczeń i miejsce montażu jednostek. W FRIGAC taka weryfikacja i wycena są bezpłatne.'
  },
  {
    question: 'Jaka moc klimatyzacji do domu z poddaszem?',
    answer:
      'Poddasze nagrzewa się najmocniej - przez dach dociera do niego znacznie więcej ciepła niż przez strop. W kalkulatorze wybierz "ostatnie piętro / poddasze", a zapotrzebowanie zostanie powiększone o około 25%. Dla poddasza 30 m2 zamiast 2,5 kW zwykle potrzebne będzie 3,5 kW.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator mocy klimatyzacji FRIGAC',
  url: new URL(routes.calcPower, SITE.siteUrl).toString(),
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  provider: { '@type': 'Organization', name: SITE.brandName, url: SITE.siteUrl }
};
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routes.calcPower}
  extraSchema={[appSchema, faqSchema]}
>
  <Breadcrumbs items={[{ label: 'Narzędzia', href: routes.tools }, { label: 'Kalkulator mocy klimatyzacji' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Darmowe narzędzie</p>
      <h1>Kalkulator mocy klimatyzacji</h1>
      <p>
        Policz, jaka moc klimatyzacji pasuje do Twojego pomieszczenia: w kW i BTU, z poprawką na
        nasłonecznienie, piętro, okna i liczbę osób. Na końcu dostaniesz rekomendację urządzenia,
        orientacyjny koszt montażu i raport do pobrania.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container tool-layout" data-reveal>
      <form class="tool-form" id="power-form">
        <fieldset class="tool-step">
          <legend><span class="tool-step-num">1</span>Co chcesz klimatyzować?</legend>
          <div class="seg">
            <input type="radio" name="ptype" id="pt-flat" value="1" checked />
            <label for="pt-flat">Mieszkanie</label>
            <input type="radio" name="ptype" id="pt-house" value="1.05" />
            <label for="pt-house">Dom</label>
            <input type="radio" name="ptype" id="pt-office" value="1.15" />
            <label for="pt-office">Biuro</label>
            <input type="radio" name="ptype" id="pt-shop" value="1.25" />
            <label for="pt-shop">Lokal usługowy</label>
          </div>
        </fieldset>

        <div class="tool-step">
          <p class="tool-step-title"><span class="tool-step-num">2</span>Powierzchnia pomieszczenia</p>
          <div class="range-row">
            <input type="range" id="area" min="10" max="120" step="1" value="52" aria-label="Powierzchnia w metrach kwadratowych" />
            <output class="range-value" id="area-out" for="area">52 m²</output>
          </div>
          <p class="tool-hint">Metraż jednej strefy chłodzenia (np. salon z aneksem), nie całego domu.</p>
        </div>

        <div class="tool-step">
          <p class="tool-step-title"><span class="tool-step-num">3</span>Wysokość pomieszczenia</p>
          <div class="range-row">
            <input type="range" id="height" min="2.4" max="4" step="0.1" value="2.7" aria-label="Wysokość pomieszczenia w metrach" />
            <output class="range-value" id="height-out" for="height">2,7 m</output>
          </div>
        </div>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">4</span>Nasłonecznienie</legend>
          <div class="seg">
            <input type="radio" name="sun" id="sun-low" value="0.9" />
            <label for="sun-low">Małe</label>
            <input type="radio" name="sun" id="sun-mid" value="1" checked />
            <label for="sun-mid">Średnie</label>
            <input type="radio" name="sun" id="sun-high" value="1.2" />
            <label for="sun-high">Duże</label>
          </div>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">5</span>Które piętro?</legend>
          <div class="seg">
            <input type="radio" name="floor" id="fl-ground" value="0.95" />
            <label for="fl-ground">Parter</label>
            <input type="radio" name="floor" id="fl-mid" value="1" checked />
            <label for="fl-mid">Piętro</label>
            <input type="radio" name="floor" id="fl-top" value="1.25" />
            <label for="fl-top">Ostatnie piętro / poddasze</label>
          </div>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">6</span>Okna</legend>
          <div class="seg">
            <input type="radio" name="win" id="win-s" value="0.95" />
            <label for="win-s">Małe</label>
            <input type="radio" name="win" id="win-m" value="1" checked />
            <label for="win-m">Standardowe</label>
            <input type="radio" name="win" id="win-l" value="1.15" />
            <label for="win-l">Duże przeszklenia</label>
          </div>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">7</span>Strona świata (główne okna)</legend>
          <div class="seg">
            <input type="radio" name="dir" id="dir-n" value="0.9" />
            <label for="dir-n">Północ</label>
            <input type="radio" name="dir" id="dir-e" value="1" checked />
            <label for="dir-e">Wschód</label>
            <input type="radio" name="dir" id="dir-w" value="1.05" />
            <label for="dir-w">Zachód</label>
            <input type="radio" name="dir" id="dir-s" value="1.15" />
            <label for="dir-s">Południe</label>
          </div>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">8</span>Ile osób zwykle przebywa w pomieszczeniu?</legend>
          <div class="seg">
            <input type="radio" name="people" id="pp-1" value="0" checked />
            <label for="pp-1">1-2</label>
            <input type="radio" name="people" id="pp-3" value="0.3" />
            <label for="pp-3">3-4</label>
            <input type="radio" name="people" id="pp-5" value="0.6" />
            <label for="pp-5">5+</label>
          </div>
        </fieldset>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">9</span>Czy klimatyzacja ma również grzać zimą?</legend>
          <div class="seg">
            <input type="radio" name="heat" id="heat-yes" value="1.05" />
            <label for="heat-yes">Tak</label>
            <input type="radio" name="heat" id="heat-no" value="1" checked />
            <label for="heat-no">Nie</label>
          </div>
          <p class="tool-hint">
            Przy grzaniu zimą warto wybrać model o dobrej sprawności w niskich temperaturach (SCOP).
          </p>
        </fieldset>
      </form>

      <div class="tool-result-wrap">
        <div class="tool-result" role="status" aria-live="polite">
          <p class="eyebrow">Twoje zapotrzebowanie</p>
          <p class="result-main"><strong id="res-kw">3,5-4,0 kW</strong></p>
          <p class="result-sub" id="res-btu">≈ 12 000-14 000 BTU/h</p>
          <dl class="result-rows">
            <div class="result-row">
              <dt>Rekomendowany system</dt>
              <dd id="res-system">Split (1 jednostka)</dd>
            </div>
            <div class="result-row">
              <dt>FRIGAC rekomenduje</dt>
              <dd><a href={routes.gree} id="res-gree">GREE 3,5 kW</a>{' lub '}<a href={routes.kaisai} id="res-kaisai">KAISAI 3,5 kW</a></dd>
            </div>
            <div class="result-row">
              <dt>Koszt z montażem</dt>
              <dd id="res-cost">3 599-4 900 zł</dd>
            </div>
          </dl>
          <CTAButton href={`tel:${PHONE_TEL}`} label="Umów bezpłatną wycenę" ariaLabel={labels.phoneAria} />
          <button type="button" class="btn-report" id="btn-report">
            Pobierz raport (PDF)
          </button>
          <p class="tool-disclaimer">
            Wynik jest orientacyjny i nie stanowi oferty handlowej. Dokładny dobór mocy i wycenę
            potwierdzamy bezpłatnie podczas rozmowy telefonicznej.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container article-content" data-reveal>
      <h2>Ile kW klimatyzacji na m²?</h2>
      <p>
        Podstawowa reguła doboru mocy klimatyzacji jest prosta: <strong>około 100 W (0,1 kW) mocy
        chłodniczej na 1 m²</strong> pomieszczenia o wysokości 2,5-2,7 m. To punkt wyjścia, który
        nasz kalkulator koryguje o nasłonecznienie, piętro, wielkość przeszkleń, stronę świata
        i liczbę osób - dokładnie tak, jak robimy to przy telefonicznej wycenie montażu.
      </p>

      <h2>Jaka moc klimatyzacji na 20, 30, 50 czy 100 m²?</h2>
      <div class="table-wrap">
        <table class="tool-table">
          <caption class="visually-hidden">Orientacyjna moc klimatyzacji według metrażu</caption>
          <thead>
            <tr>
              <th scope="col">Metraż</th>
              <th scope="col">Orientacyjna moc</th>
              <th scope="col">Ile BTU</th>
            </tr>
          </thead>
          <tbody>
            {
              powerTable.map((row) => (
                <tr>
                  <td>{row.area}</td>
                  <td>{row.kw}</td>
                  <td>{row.btu}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="tiny-note">
        Wartości dla standardowej wysokości 2,5-2,7 m i przeciętnego nasłonecznienia. Opracowanie
        własne FRIGAC na podstawie praktyki montażowej.
      </p>

      <h2>Ile BTU na m²?</h2>
      <p>
        BTU/h to jednostka używana głównie w krajach anglosaskich: <strong>1 kW ≈ 3 412 BTU/h</strong>.
        Reguła 100 W/m² odpowiada więc około 340 BTU na metr kwadratowy. Popularne moce urządzeń to
        9 000 BTU (2,5 kW), 12 000 BTU (3,5 kW) i 18 000 BTU (5 kW).
      </p>

      <h2>Za mała czy za duża - dlaczego moc musi być trafiona?</h2>
      <p>
        Zbyt słaby klimatyzator pracuje bez przerwy na pełnej mocy: głośno, energochłonnie i bez
        osiągnięcia zadanej temperatury w upał. Zbyt mocny taktuje - włącza się i wyłącza w krótkich
        cyklach, gorzej osusza powietrze i szybciej się zużywa. Dlatego dobór mocy to najważniejsza
        decyzja przy zakupie klimatyzacji - ważniejsza niż marka czy dodatkowe funkcje.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Kalkulator mocy klimatyzacji - pytania</h2>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Przydatne przy wyborze:</p>
      <a class="text-link" href={routes.calcCost}>Kalkulator kosztów klimatyzacji</a>
      <a class="text-link" href={routes.calcEnergy}>Ile prądu zużywa klimatyzacja</a>
      <a class="text-link" href="/porady/jaka-klimatyzacja-do-mieszkania">Jaka klimatyzacja do mieszkania</a>
      <a class="text-link" href={routes.pricing}>Cennik montażu</a>
    </div>
  </section>

  <div class="print-report" id="print-report" aria-hidden="true">
    <p class="print-heading">RAPORT DOBORU KLIMATYZACJI - FRIGAC</p>
    <p>frigac.pl · tel. {PHONE_DISPLAY} · raport orientacyjny wygenerowany przez kalkulator online</p>
    <table>
      <tbody>
        <tr><th>Typ pomieszczenia</th><td id="rp-type">-</td></tr>
        <tr><th>Powierzchnia</th><td id="rp-area">-</td></tr>
        <tr><th>Wysokość</th><td id="rp-height">-</td></tr>
        <tr><th>Nasłonecznienie</th><td id="rp-sun">-</td></tr>
        <tr><th>Szacowane zapotrzebowanie</th><td id="rp-need">-</td></tr>
        <tr><th>Rekomendowana moc</th><td id="rp-kw">-</td></tr>
        <tr><th>Ile BTU</th><td id="rp-btu">-</td></tr>
        <tr><th>Rekomendowany system</th><td id="rp-system">-</td></tr>
        <tr><th>Proponowane urządzenia</th><td id="rp-devices">-</td></tr>
        <tr><th>Szacowany koszt z montażem</th><td id="rp-cost">-</td></tr>
      </tbody>
    </table>
    <p>
      Chcesz dokładny dobór? FRIGAC wykona bezpłatną wycenę - zadzwoń: {PHONE_DISPLAY}.
      Działamy w Bydgoszczy, Toruniu i Trójmieście. Wynik kalkulatora jest orientacyjny
      i nie stanowi oferty handlowej.
    </p>
  </div>
</Layout>

<script>
  const nf = new Intl.NumberFormat('pl-PL');
  const $ = (id: string) => document.getElementById(id);

  const area = $('area') as HTMLInputElement;
  const height = $('height') as HTMLInputElement;
  const form = $('power-form') as HTMLFormElement;

  const radioVal = (name: string): number => {
    const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    return el ? parseFloat(el.value) : 1;
  };

  const radioLabel = (name: string): string => {
    const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    if (!el) return '-';
    const label = document.querySelector<HTMLLabelElement>(`label[for="${el.id}"]`);
    return label ? label.textContent!.trim() : '-';
  };

  const fmt1 = (v: number) => v.toFixed(1).replace('.', ',');

  const COSTS: Record<string, [number, number]> = {
    '2.5': [3499, 4400],
    '3.5': [3599, 4900],
    '5': [4600, 6500],
    '7': [6200, 8900]
  };

  const MULTI_COSTS: Record<number, [number, number]> = {
    2: [8500, 11500],
    3: [11500, 15500],
    4: [14500, 19500]
  };

  let last = {
    needLow: 0,
    needHigh: 0,
    nominal: '3.5',
    system: '',
    kwText: '',
    btuText: '',
    costText: '',
    devices: ''
  };

  function compute() {
    if (!area || !height || !form) return;
    const a = Math.min(Math.max(parseFloat(area.value) || 10, 10), 120);
    const h = Math.min(Math.max(parseFloat(height.value) || 2.4, 2.4), 4);

    const base = a * 0.1 * (h / 2.6);
    const mult =
      radioVal('ptype') * radioVal('sun') * radioVal('floor') * radioVal('win') * radioVal('dir');
    const need = (base * mult + radioVal('people')) * radioVal('heat');

    const low = Math.round(need * 0.95 * 10) / 10;
    const high = Math.round(need * 1.15 * 10) / 10;

    let nominal = '';
    for (const n of [2.5, 3.5, 5, 7]) {
      if (need <= n + 0.2) {
        nominal = String(n);
        break;
      }
    }

    const isMulti = nominal === '';
    let system: string;
    let devName: string;
    let cLow: number;
    let cHigh: number;

    if (isMulti) {
      // duże zapotrzebowanie: multisplit z jednostkami ~3,5 kW
      const units = Math.min(Math.max(Math.ceil(need / 3.5), 2), 4);
      const unitWord = units === 2 ? 'jednostki' : 'jednostki';
      system = `Multisplit (${units} ${unitWord} wewnętrzne)`;
      devName = `multisplit ${units} × 3,5 kW`;
      [cLow, cHigh] = MULTI_COSTS[units];
      nominal = 'multi';
    } else {
      system = 'Split (1 jednostka)';
      devName = `${nominal.replace('.', ',')} kW`;
      [cLow, cHigh] = COSTS[nominal];
    }
    const kwText = `${fmt1(low)}-${fmt1(high)} kW`;
    const btuText = `≈ ${nf.format(Math.round((low * 3412) / 500) * 500)}-${nf.format(Math.round((high * 3412) / 500) * 500)} BTU/h`;
    const costText = `${nf.format(cLow)}-${nf.format(cHigh)} zł`;

    ($('res-kw') as HTMLElement).textContent = kwText;
    ($('res-btu') as HTMLElement).textContent = btuText;
    ($('res-system') as HTMLElement).textContent = system;
    ($('res-gree') as HTMLElement).textContent = `GREE ${devName}`;
    ($('res-kaisai') as HTMLElement).textContent = `KAISAI ${devName}`;
    ($('res-cost') as HTMLElement).textContent = costText;

    ($('area-out') as HTMLElement).textContent = `${a} m²`;
    ($('height-out') as HTMLElement).textContent = `${fmt1(h)} m`;

    last = {
      needLow: low,
      needHigh: high,
      nominal,
      system,
      kwText,
      btuText,
      costText,
      devices: `GREE ${devName} lub KAISAI ${devName}`
    };
  }

  form?.addEventListener('input', compute);
  compute();

  // wypełniona część ścieżki suwaka
  document.querySelectorAll<HTMLInputElement>('.range-row input[type="range"]').forEach((r) => {
    const setFill = () => {
      const min = parseFloat(r.min) || 0;
      const max = parseFloat(r.max) || 100;
      const pct = ((parseFloat(r.value) - min) / (max - min)) * 100;
      r.style.setProperty('--fill', `${pct.toFixed(1)}%`);
    };
    r.addEventListener('input', setFill);
    setFill();
  });

  $('btn-report')?.addEventListener('click', () => {
    ($('rp-type') as HTMLElement).textContent = radioLabel('ptype');
    ($('rp-area') as HTMLElement).textContent = `${area.value} m²`;
    ($('rp-height') as HTMLElement).textContent = `${fmt1(parseFloat(height.value))} m`;
    ($('rp-sun') as HTMLElement).textContent = radioLabel('sun').replace(/☀️/g, '').trim();
    ($('rp-need') as HTMLElement).textContent = `${fmt1((last.needLow + last.needHigh) / 2)} kW`;
    ($('rp-kw') as HTMLElement).textContent = last.kwText;
    ($('rp-btu') as HTMLElement).textContent = last.btuText;
    ($('rp-system') as HTMLElement).textContent = last.system;
    ($('rp-devices') as HTMLElement).textContent = last.devices;
    ($('rp-cost') as HTMLElement).textContent = last.costText;

    document.documentElement.classList.add('printing-report');
    const cleanup = () => {
      document.documentElement.classList.remove('printing-report');
      window.removeEventListener('afterprint', cleanup);
    };
    window.addEventListener('afterprint', cleanup);
    window.print();
  });
</script>
