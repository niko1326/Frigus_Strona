---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { COST_CALCULATOR_CONFIG } from '../config/costCalculator';
import { PHONE_TEL, SITE } from '../config/site';
import { labels, pageMeta, routes } from '../i18n/content';

const meta = pageMeta.calcCost;

const costTable = [
  { config: '1 pomieszczenie do 25 m², około 2,5 kW', cost: '3 499-4 500 zł' },
  { config: '1 pomieszczenie 26-35 m², około 3,5 kW', cost: '3 499-4 500 zł' },
  { config: '1 pomieszczenie 36-50 m², około 5,0 kW', cost: '4 500-6 000 zł' },
  { config: '1 pomieszczenie 51-70 m², około 7,0 kW', cost: '5 500-7 500 zł' },
  { config: '2-3 pomieszczenia', cost: 'suma widełek dobranych osobno dla każdej strefy' }
];

const faqItems = [
  {
    question: 'Ile kosztuje klimatyzacja do mieszkania 50 m2?',
    answer:
      'Dla jednej strefy o powierzchni około 50 m2 kalkulator przyjmuje orientacyjnie urządzenie około 5,0 kW i bazowe widełki 4 500-6 000 zł ze standardowym montażem. Przy kilku pomieszczeniach każdą strefę liczymy osobno, a ostateczny układ urządzeń potwierdzamy po sprawdzeniu możliwości montażu.'
  },
  {
    question: 'Co najbardziej wpływa na cenę montażu klimatyzacji?',
    answer:
      'Największe znaczenie mają metraż poszczególnych pomieszczeń, wybrany model urządzenia i rzeczywista długość instalacji. Kalkulator podaje orientacyjne widełki, a warunki techniczne potwierdzamy przed realizacją.'
  },
  {
    question: 'Split czy multisplit - co wychodzi taniej?',
    answer:
      'Przy dwóch pomieszczeniach dwa osobne splity są zwykle nieco tańsze i prostsze w serwisie. Multisplit wygrywa, gdy na elewacji lub balkonie jest miejsce tylko na jedną jednostkę zewnętrzną albo gdy chłodzisz 3-4 pomieszczenia.'
  },
  {
    question: 'Czy do ceny trzeba doliczyć coś jeszcze?',
    answer:
      'Wynik obejmuje urządzenie, dostawę, standardowy montaż, uruchomienie i dojazd. Ostateczna cena zależy od wybranego modelu, rzeczywistej długości instalacji i warunków technicznych na miejscu; potwierdzamy ją przed rozpoczęciem realizacji.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator kosztów klimatyzacji FRIGAC',
  url: new URL(routes.calcCost, SITE.siteUrl).toString(),
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  provider: { '@type': 'Organization', name: SITE.brandName, url: SITE.siteUrl }
};
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routes.calcCost}
  extraSchema={[appSchema, faqSchema]}
>
  <Breadcrumbs items={[{ label: 'Narzędzia', href: routes.tools }, { label: 'Kalkulator kosztów klimatyzacji' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Darmowe narzędzie</p>
      <h1>Ile kosztuje klimatyzacja? Kalkulator kosztów</h1>
      <p>
        W 20-30 sekund oszacuj koszt klimatyzacji ze standardowym montażem. Podaj liczbę
        pomieszczeń, ich metraż, priorytet przy wyborze urządzenia i przybliżoną długość instalacji,
        a otrzymasz realistyczne orientacyjne widełki.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container tool-layout" data-reveal>
      <form class="tool-form" id="cost-form">
        <fieldset class="tool-step">
          <legend><span class="tool-step-num">1</span>Ile pomieszczeń chcesz klimatyzować?</legend>
          <div class="seg">
            <input type="radio" name="rooms" id="rm-1" value="1" checked />
            <label for="rm-1">1</label>
            <input type="radio" name="rooms" id="rm-2" value="2" />
            <label for="rm-2">2</label>
            <input type="radio" name="rooms" id="rm-3" value="3" />
            <label for="rm-3">3</label>
            <input type="radio" name="rooms" id="rm-4" value="4+" />
            <label for="rm-4">4+</label>
          </div>
        </fieldset>

        <div class="tool-step" id="areas-step">
          <p class="tool-step-title"><span class="tool-step-num">2</span>Metraż pomieszczeń</p>
          <div class="room-areas">
            {[20, 30, 35].map((value, index) => (
              <div class="room-area" data-room-area={index + 1} hidden={index > 0}>
                <label class="room-area-label" for={`room-area-${index + 1}`} data-room-label={index + 1}>
                  {index === 0 ? 'Metraż pomieszczenia' : `Pomieszczenie ${index + 1}`}
                </label>
                <div class="range-row">
                  <input
                    type="range"
                    id={`room-area-${index + 1}`}
                    min={COST_CALCULATOR_CONFIG.roomArea.min}
                    max={COST_CALCULATOR_CONFIG.roomArea.max}
                    step={COST_CALCULATOR_CONFIG.roomArea.step}
                    value={value}
                    aria-label={`Metraż pomieszczenia ${index + 1}`}
                    data-area-input
                  />
                  <output class="range-value" id={`room-area-${index + 1}-out`} for={`room-area-${index + 1}`}>
                    {value} m²
                  </output>
                </div>
                <p class="tool-hint" data-power-hint>Orientacyjnie około 2,5 kW.</p>
              </div>
            ))}
          </div>
          <p class="tool-hint">
            Moc jest tu wyłącznie orientacyjnym elementem wyceny. Ostateczny dobór uwzględnia także
            nasłonecznienie, przeszklenia i układ pomieszczeń.
          </p>
        </div>

        <fieldset class="tool-step" id="priority-step">
          <legend><span class="tool-step-num">3</span>Czego oczekujesz od klimatyzatora?</legend>
          <div class="seg">
            {Object.entries(COST_CALCULATOR_CONFIG.priorities).map(([value, item], index) => (
              <>
                <input type="radio" name="priority" id={`priority-${value}`} value={value} checked={index === 0} />
                <label for={`priority-${value}`}>{item.label}</label>
              </>
            ))}
          </div>
        </fieldset>

        <div class="tool-step" id="installation-step">
          <p class="tool-step-title"><span class="tool-step-num">4</span>Przybliżona długość instalacji</p>
          <div class="range-row">
            <input type="range" id="clen" min="1" max={COST_CALCULATOR_CONFIG.maxInstallationMeters} step="1" value={COST_CALCULATOR_CONFIG.defaultInstallationMeters} aria-label="Długość instalacji w metrach bieżących" />
            <output class="range-value" id="clen-out" for="clen">{COST_CALCULATOR_CONFIG.defaultInstallationMeters} mb</output>
          </div>
          <p class="tool-hint" id="installation-hint">Do 5 mb w cenie standardowego montażu.</p>
          <p class="tool-hint">Dłuższa trasa instalacji wymaga potwierdzenia indywidualnej wyceny.</p>
        </div>

        <div class="tool-step individual-room-note" id="individual-room-note" hidden>
          <p class="tool-step-title">Przy czterech lub większej liczbie pomieszczeń przygotowujemy indywidualną wycenę.</p>
          <p class="tool-hint">Skontaktuj się z nami, aby dobrać układ urządzeń i potwierdzić możliwości montażu.</p>
        </div>
      </form>

      <div class="tool-result-wrap">
        <div class="tool-result" role="status" aria-live="polite">
          <p class="eyebrow">Szacunkowy koszt</p>
          <p class="result-main"><strong id="cres-cost">3 500–4 500 zł</strong></p>
          <p class="result-sub" id="cres-sub">z urządzeniem i standardowym montażem</p>
          <dl class="result-rows">
            <div class="result-row">
              <dt>Orientacyjna konfiguracja</dt>
              <dd id="cres-config">1 × klimatyzator split</dd>
              <dd id="cres-powers">około 2,5 kW</dd>
              <dd id="cres-installation">instalacja do 5 mb</dd>
            </div>
            <div class="result-row" id="layout-note" hidden>
              <dt>Układ urządzeń</dt>
              <dd>Ostatecznie dobierzemy układ osobnych klimatyzatorów split lub multisplit po sprawdzeniu możliwości montażu.</dd>
            </div>
            <div class="result-row">
              <dt>W cenie</dt>
              <dd>urządzenie<br />dostawa<br />standardowy montaż<br />uruchomienie<br />dojazd</dd>
            </div>
            <div class="result-row">
              <dt>Gwarancja</dt>
              <dd>5 lat gwarancji producenta</dd>
            </div>
          </dl>
          <CTAButton href={`tel:${PHONE_TEL}`} label="Potwierdź bezpłatną wycenę" ariaLabel={labels.phoneAria} />
          <p class="tool-disclaimer">
            Wynik ma charakter orientacyjny i nie stanowi oferty handlowej. Ostateczna cena zależy
            m.in. od wybranego modelu, rzeczywistej długości instalacji oraz warunków technicznych
            na miejscu. Cenę potwierdzamy przed rozpoczęciem realizacji.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container article-content" data-reveal>
      <h2>Ile kosztuje klimatyzacja z montażem w 2026?</h2>
      <p>
        Najczęstszy scenariusz - jeden klimatyzator split do salonu lub sypialni - to u nas koszt
        <strong>od 3 499 zł z urządzeniem i montażem</strong>. Poniżej typowe konfiguracje, które
        montujemy w Bydgoszczy, Toruniu i Trójmieście:
      </p>
      <div class="table-wrap">
        <table class="tool-table">
          <caption class="visually-hidden">Orientacyjne koszty klimatyzacji z montażem</caption>
          <thead>
            <tr>
              <th scope="col">Konfiguracja</th>
              <th scope="col">Orientacyjny koszt</th>
            </tr>
          </thead>
          <tbody>
            {
              costTable.map((row) => (
                <tr>
                  <td>{row.config}</td>
                  <td>{row.cost}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="tiny-note">
        Widełki obejmują urządzenie, dostawę, standardowy montaż do 5 mb, uruchomienie i dojazd.
        Opracowanie własne FRIGAC, 2026.
      </p>
      <h2>Koszt zakupu to nie wszystko - policz też prąd</h2>
      <p>
        Nowoczesny klimatyzator inwerterowy z SEER powyżej 6 kosztuje w typowym mieszkaniu
        <strong>200-500 zł za cały sezon chłodzenia</strong>. Dokładny koszt dla swojego urządzenia
        policzysz w naszym <a class="inline-link" href={routes.calcEnergy}>kalkulatorze zużycia prądu</a>.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Koszt klimatyzacji - pytania</h2>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Zobacz też:</p>
      <a class="text-link" href={routes.calcPower}>Kalkulator mocy klimatyzacji</a>
      <a class="text-link" href={routes.pricing}>Pełny cennik montażu</a>
      <a class="text-link" href="/porady/ile-kosztuje-montaz-klimatyzacji">Artykuł: ile kosztuje montaż klimatyzacji</a>
    </div>
  </section>
</Layout>

<script>
  import {
    COST_CALCULATOR_CONFIG,
    calculateCostEstimate,
    getRoomEstimate,
    type DevicePriority
  } from '../config/costCalculator';

  const $ = (id: string) => document.getElementById(id);
  const clen = $('clen') as HTMLInputElement;
  const form = $('cost-form') as HTMLFormElement;
  const areaInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-area-input]'));
  const roomAreas = Array.from(document.querySelectorAll<HTMLElement>('[data-room-area]'));

  const radioVal = (name: string): string => {
    const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    return el ? el.value : '';
  };

  const formatPrice = (value: number): string =>
    String(value).replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0');

  const setFill = (range: HTMLInputElement) => {
    const min = parseFloat(range.min) || 0;
    const max = parseFloat(range.max) || 100;
    const pct = ((parseFloat(range.value) - min) / (max - min)) * 100;
    range.style.setProperty('--fill', `${pct.toFixed(1)}%`);
  };

  const showIndividual = (message: string) => {
    ($('cres-cost') as HTMLElement).textContent = 'Indywidualna wycena';
    ($('cres-sub') as HTMLElement).textContent = message;
    ($('cres-config') as HTMLElement).textContent = 'Skontaktuj się z nami, aby dobrać właściwy układ urządzeń.';
    ($('cres-powers') as HTMLElement).textContent = '';
    ($('cres-installation') as HTMLElement).textContent = '';
    ($('layout-note') as HTMLElement).hidden = true;
  };

  function compute() {
    if (!clen || !form) return;
    const roomsValue = radioVal('rooms');
    const isFourPlus = roomsValue === '4+';
    const rooms = isFourPlus ? 4 : parseInt(roomsValue, 10) || 1;
    const installationMeters = parseInt(clen.value, 10) || COST_CALCULATOR_CONFIG.defaultInstallationMeters;

    ($('areas-step') as HTMLElement).hidden = isFourPlus;
    ($('priority-step') as HTMLElement).hidden = isFourPlus;
    ($('installation-step') as HTMLElement).hidden = isFourPlus;
    ($('individual-room-note') as HTMLElement).hidden = !isFourPlus;

    roomAreas.forEach((row, index) => {
      row.hidden = isFourPlus || index >= rooms;
      const label = row.querySelector<HTMLElement>('[data-room-label]');
      if (label) label.textContent = rooms === 1 ? 'Metraż pomieszczenia' : `Pomieszczenie ${index + 1}`;
    });

    if (isFourPlus) {
      showIndividual('Przy czterech lub większej liczbie pomieszczeń przygotowujemy indywidualną wycenę.');
      return;
    }

    const activeAreas = areaInputs.slice(0, rooms).map((input) => parseInt(input.value, 10));
    activeAreas.forEach((area, index) => {
      const input = areaInputs[index];
      const row = roomAreas[index];
      const estimate = getRoomEstimate(area);
      ($(`${input.id}-out`) as HTMLElement).textContent = `${area} m²`;
      const hint = row.querySelector<HTMLElement>('[data-power-hint]');
      if (hint) {
        hint.textContent = estimate
          ? `Orientacyjnie około ${estimate.powerKw} kW.`
          : 'Powyżej 70 m² potrzebny jest indywidualny dobór.';
      }
    });

    ($('clen-out') as HTMLElement).textContent = `${installationMeters} mb`;
    ($('installation-hint') as HTMLElement).textContent =
      installationMeters <= COST_CALCULATOR_CONFIG.standardInstallationMeters
        ? 'Do 5 mb w cenie standardowego montażu.'
        : 'Dodatkowa długość została uwzględniona w orientacyjnych widełkach.';

    const estimate = calculateCostEstimate({
      areas: activeAreas,
      priority: radioVal('priority') as DevicePriority,
      installationMeters
    });

    if (estimate.kind === 'individual') {
      showIndividual('Strefa powyżej 70 m² wymaga indywidualnego doboru i wyceny.');
      return;
    }

    ($('cres-cost') as HTMLElement).textContent = `${formatPrice(estimate.range.low)}–${formatPrice(estimate.range.high)} zł`;
    ($('cres-sub') as HTMLElement).textContent = rooms === 1
      ? 'z urządzeniem i standardowym montażem'
      : 'z urządzeniami i standardowym montażem';
    ($('cres-config') as HTMLElement).textContent = rooms === 1
      ? '1 × klimatyzator split'
      : `${rooms} jednostki wewnętrzne • moce dobierane do poszczególnych pomieszczeń`;
    ($('cres-powers') as HTMLElement).textContent = estimate.rooms
      .map((room) => `około ${room.powerKw} kW`)
      .join(' • ');
    ($('cres-installation') as HTMLElement).textContent = installationMeters <= COST_CALCULATOR_CONFIG.standardInstallationMeters
      ? 'instalacja do 5 mb'
      : `instalacja około ${installationMeters} mb`;
    ($('layout-note') as HTMLElement).hidden = rooms === 1;
  }

  form?.addEventListener('input', compute);
  document.querySelectorAll<HTMLInputElement>('.range-row input[type="range"]').forEach((range) => {
    range.addEventListener('input', () => setFill(range));
    setFill(range);
  });
  compute();
</script>

<style>
  .room-areas {
    display: grid;
  }

  .room-area {
    display: grid;
    gap: 0.45rem;
    padding-block: 0.75rem;
  }

  .room-area + .room-area {
    border-top: 1px solid var(--line);
  }

  .room-area-label {
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .room-area .tool-hint {
    margin-top: -0.3rem;
  }

  .individual-room-note {
    border-radius: 0;
  }

  .tool-step[hidden],
  .room-area[hidden],
  .result-row[hidden] {
    display: none !important;
  }

  #cres-config,
  #cres-powers,
  #cres-installation {
    overflow-wrap: anywhere;
  }

  .result-main {
    font-size: clamp(1.85rem, 8.5vw, 2.1rem);
  }

  .result-main strong {
    white-space: nowrap;
  }

  @media (max-width: 479.98px) {
    .room-area {
      padding-block: 0.65rem;
    }

    .range-row {
      gap: 0.75rem;
    }

    .range-value {
      min-width: 4.5rem;
    }
  }
</style>
