---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { CONTACTS, EMAIL, HOURS, PHONE_TEL, SERVICE_AREAS } from '../config/site';
import { labels, pageMeta } from '../i18n/content';

const meta = pageMeta.contact;
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/kontakt"
>
  <Breadcrumbs items={[{ label: 'Kontakt' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Kontakt</p>
      <h1>Darmowa wycena przez telefon</h1>
      <p>
        Bez formularzy i czekania na odpowiedź. Zadzwoń, opisz lokal, a od ręki podamy orientacyjną
        cenę i najbliższy możliwy termin montażu.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel" data-reveal>
      <div class="phone-list">
        {
          CONTACTS.map((contact) => (
            <div class="phone-entry">
              <span class="phone-person">{contact.name}</span>
              <a class="phone-big" href={`tel:${contact.tel}`} aria-label={`Zadzwoń do ${contact.name}a: ${contact.display}`}>
                {contact.display}
              </a>
            </div>
          ))
        }
      </div>
      <p class="contact-email">
        E-mail: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
      <ul class="bullet-list">
        <li>{HOURS.dailyLabel}: {HOURS.daily}, także w weekendy</li>
        <li>Obszar działania: {SERVICE_AREAS.join(', ')}</li>
      </ul>
      <p class="tiny-note">
        Nie odbieramy? Prawdopodobnie jesteśmy w trakcie montażu. Oddzwonimy najszybciej, jak to możliwe.
      </p>
      <CTAButton href={`tel:${PHONE_TEL}`} label={labels.callNow} ariaLabel={labels.callNow} />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Po telefonie</p>
        <h2>Co dzieje się po Twoim zgłoszeniu</h2>
      </div>
      <ol class="timeline">
        <li class="timeline-item">
          <span class="timeline-marker">1</span>
          <div class="timeline-body">
            <h3>Rozmawiamy 5 minut</h3>
            <p>Pytamy o metraż, piętro i miejsce na jednostkę zewnętrzną. Od ręki podajemy orientacyjną cenę.</p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-marker">2</span>
          <div class="timeline-body">
            <h3>Ustalamy termin</h3>
            <p>Proponujemy najbliższy dogodny dzień - montaże realizujemy także w weekendy.</p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-marker">3</span>
          <div class="timeline-body">
            <h3>Montujemy w 1 dzień</h3>
            <p>Przyjeżdżamy z urządzeniem i kompletem materiałów. Wieczorem klimatyzacja już chłodzi.</p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-marker">4</span>
          <div class="timeline-body">
            <h3>Zostajemy w kontakcie</h3>
            <p>Masz 5 lat gwarancji na montaż, a w kolejnych sezonach przypomnimy o przeglądzie.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Zanim zadzwonisz, możesz sprawdzić:</p>
      <a class="text-link" href="/cennik">Cennik montażu klimatyzacji</a>
      <a class="text-link" href="/faq">Najczęstsze pytania</a>
      <a class="text-link" href="/uslugi">Zakres usług</a>
    </div>
  </section>
</Layout>
