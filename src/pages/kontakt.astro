---
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { BUSINESS, CONTACT_PHONE } from '../config/site';
import { commonLabels, pageMeta } from '../i18n/content';

const meta = pageMeta.pl.contact;
const labels = commonLabels.pl;
---

<Layout
  lang="pl"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/kontakt"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Kontakt</p>
      <h1>Telefon to najszybsza wycena</h1>
      <p>
        Bez formularzy i bez kolejek. Zadzwoń, opisz lokal i urządzenie, a szybko wrócimy z propozycją
        zakresu i terminu.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel" data-reveal>
      <p>
        <a class="phone-big" href={CONTACT_PHONE.href} aria-label={labels.phoneAria}>{CONTACT_PHONE.display}</a>{' '}
        — {CONTACT_PHONE.contactName}
      </p>
      <a href={BUSINESS.contact.email.href} aria-label={labels.emailAria}>{BUSINESS.contact.email.address}</a>
      <ul class="bullet-list">
        <li>Dostępność: {BUSINESS.availability.label.pl}</li>
        <li>Obszar: {BUSINESS.serviceArea.summary.pl}</li>
      </ul>
      <p class="tiny-note">Skontaktuj się telefonicznie lub mailowo.</p>
      <CTAButton href={CONTACT_PHONE.href} label="Zadzwoń po wycenę" ariaLabel="Zadzwoń po wycenę" />
    </div>
  </section>
</Layout>
