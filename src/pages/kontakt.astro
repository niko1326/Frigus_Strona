---
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { BUSINESS, PRIMARY_PHONE } from '../config/site';
import { pageMeta } from '../i18n/content';

const meta = pageMeta.pl.contact;
---

<Layout
  lang="pl"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/kontakt"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Kontakt</p>
      <h1>Telefon to najszybsza wycena</h1>
      <p>
        Bez formularzy i bez kolejek. Zadzwoń, opisz lokal i urządzenie, a szybko wrócimy z propozycją
        zakresu i terminu.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel" data-reveal>
      {
        BUSINESS.contact.phones.map((phone) => (
          <p>
            <a class="phone-big" href={phone.href} aria-label={`Zadzwoń do ${phone.contactName}`}>
              {phone.display}
            </a>{' '}
            — {phone.contactName}
          </p>
        ))
      }
      <a href={BUSINESS.contact.email.href}>{BUSINESS.contact.email.address}</a>
      <ul class="bullet-list">
        <li>Dostępność: {BUSINESS.availability.label.pl}</li>
        <li>Zespół: {BUSINESS.teamSize} osoby</li>
        <li>Obszar: {BUSINESS.serviceArea.summary.pl}</li>
      </ul>
      <p class="tiny-note">Skontaktuj się telefonicznie lub mailowo.</p>
      <CTAButton href={PRIMARY_PHONE.href} label="Zadzwoń po darmową wycenę" ariaLabel="Zadzwoń po darmową wycenę" />
    </div>
  </section>
</Layout>
