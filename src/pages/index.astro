---
import Layout from '../components/Layout.astro';
import CTABand from '../components/sections/home/CTABand.astro';
import CertificationsSection from '../components/sections/home/CertificationsSection.astro';
import HeroSection from '../components/sections/home/HeroSection.astro';
import HowItWorksSection from '../components/sections/home/HowItWorksSection.astro';
import PricingTeaser from '../components/sections/home/PricingTeaser.astro';
import ServiceAreaSection from '../components/sections/home/ServiceAreaSection.astro';
import ServicesSection from '../components/sections/home/ServicesSection.astro';
import TrustStrip from '../components/sections/home/TrustStrip.astro';
import { pageMeta } from '../i18n/content';

const meta = pageMeta.pl.home;
---

<Layout
  lang="pl"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/"
>
  <HeroSection lang="pl" />
  <TrustStrip lang="pl" />
  <CertificationsSection lang="pl" />
  <ServicesSection lang="pl" />
  <HowItWorksSection lang="pl" />
  <PricingTeaser lang="pl" />
  <ServiceAreaSection lang="pl" />
  <CTABand lang="pl" />
</Layout>
