---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import ModelLineup from '../components/ModelLineup.astro';
import SizingTable from '../components/SizingTable.astro';
import IconIndoor from '../components/icons/IconIndoor.astro';
import IconShield from '../components/icons/IconShield.astro';
import IconWind from '../components/icons/IconWind.astro';
import { getLowestInstalledPrice, KAISAI_MODELS, KAISAI_UNAVAILABLE_MODELS } from '../config/lineups';
import { PHONE_TEL, SITE } from '../config/site';
import { calculatorNavLabels, labels, pageMeta, routes } from '../i18n/content';

const meta = pageMeta.kaisai;
const featuredKaisaiSlug = 'kaisai-pro-heat-plus';
const lowestInstalledPrice = getLowestInstalledPrice(KAISAI_MODELS);
const kaisaiModelsForDisplay = [...KAISAI_MODELS, ...KAISAI_UNAVAILABLE_MODELS].sort((first, second) => {
  if (first.slug === featuredKaisaiSlug) return -1;
  if (second.slug === featuredKaisaiSlug) return 1;
  if (first.slug === 'kaisai-konsola') return 1;
  if (second.slug === 'kaisai-konsola') return -1;
  return (first.product?.priceFromPLN ?? Infinity) - (second.product?.priceFromPLN ?? Infinity);
});

const highlights = [
  {
    Icon: IconIndoor,
    title: 'Grzanie także przy mrozie',
    description:
      'Wybrane serie, w tym PRO HEAT+, są przygotowane do ogrzewania przy temperaturze zewnętrznej do -25°C.'
  },
  {
    Icon: IconWind,
    title: 'Funkcje zależne od serii',
    description:
      'W zależności od serii: lampa UVC, filtr Bio HEPA, jony srebra i samoczyszczenie parownika.'
  },
  {
    Icon: IconShield,
    title: 'Marka z polskim zapleczem',
    description:
      'Kaisai należy do grupy Klima-Therm z Warszawy i posiada krajowe zaplecze dystrybucyjne oraz serwisowe.'
  }
];

const lineupSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Klimatyzatory Kaisai montowane przez FRIGAC',
  itemListElement: kaisaiModelsForDisplay.filter((model) => model.product).map((model, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: `Kaisai ${model.name}`,
      brand: { '@type': 'Brand', name: 'Kaisai' },
      category: model.slug === 'kaisai-konsola' ? 'Klimatyzator konsolowy split' : 'Klimatyzator ścienny split',
      description: model.tagline,
      url: new URL(`${routes.kaisai}/${model.product!.slug}`, SITE.siteUrl).toString()
    }
  }))
};
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routes.kaisai}
  extraSchema={[lineupSchema]}
>
  <Breadcrumbs items={[{ label: 'Klimatyzatory Kaisai' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <h1>Klimatyzatory Kaisai z montażem</h1>
      <p>
        Poznaj ścienne i konsolowe klimatyzatory Kaisai do mieszkań, domów i biur. Dobierzemy serię i moc
        urządzenia do metrażu, układu pomieszczenia oraz tego, czy klimatyzacja ma również ogrzewać.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container lineup-container">
      <ModelLineup
        brand="Kaisai"
        models={kaisaiModelsForDisplay}
        detailBasePath={routes.kaisai}
        showPrice={true}
        featuredSlug={featuredKaisaiSlug}
      />
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Dobór mocy</p>
        <h2>Którą moc wybrać do swojego pomieszczenia</h2>
        <p>
          Moce w seriach Kaisai układają się w cztery typowe wielkości. Poniżej orientacyjne przypisanie
          do metrażu - dokładny dobór potwierdzamy telefonicznie, bo liczy się też nasłonecznienie,
          piętro i wysokość pomieszczenia.
        </p>
      </div>
      <SizingTable />
      <p class="tiny-note lineup-note">
        Chcesz policzyć samodzielnie? Otwórz{' '}
        <a class="text-link text-link-inline" href={routes.calcPower}>{calculatorNavLabels.power}</a>
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container content-grid" data-reveal>
      <div class="plain-stack">
        <h2>Dla kogo polecamy Kaisai</h2>
        <ul class="bullet-list">
          <li>Do domów, gdzie klimatyzacja ma realnie dogrzewać zimą: między innymi serie GEO i PRO HEAT+.</li>
          <li>Do wnętrz, w których jednostka ma być ozdobą: seria ART w bieli lub czerni.</li>
          <li>Pod okno, na poddasze lub przy niskiej ścianie: jednostka konsolowa KKGB.</li>
          <li>Dla osób szukających dodatkowych funkcji: wybrane serie z lampą UVC, filtrem Bio HEPA lub jonami srebra.</li>
          {lowestInstalledPrice && <li>Kaisai z montażem od {lowestInstalledPrice} zł - dojazd i uruchomienie w cenie.</li>}
        </ul>
      </div>
      <div class="plain-stack">
        <h2>Czym Kaisai różni się od Gree</h2>
        <p>
          Gree produkuje własne sprężarki i ma szerszą ofertę wariantów kolorystycznych. Kaisai mocniej
          stawia na serie grzewcze i wybrane funkcje wspierające jakość powietrza, a zaplecze serwisowe ma w Polsce. W praktyce obie marki
          montujemy równie często i przy wycenie proponujemy tę, która lepiej pasuje do pomieszczenia
          i budżetu.
        </p>
        <p class="tiny-note">
          Zobacz również ofertę <a class="inline-link" href={routes.gree}>Gree</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container card-grid card-grid-3" data-reveal>
      {
        highlights.map(({ Icon, title, description }) => (
          <article class="info-card">
            <Icon class="service-icon" />
            <h2 class="card-heading">{title}</h2>
            <p>{description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container plain-stack" data-reveal>
      <p>
        Kaisai to marka stworzona w 2011 roku przez warszawską grupę Klima-Therm, obecna dziś
        w ponad dwudziestu krajach Europy. Montujemy ścienne i konsolowe jednostki split Kaisai,
        z pełnym uruchomieniem układu i 5-letnią gwarancją producenta.
      </p>
      <div class="cta-inline">
        <p class="plain-highlight plain-highlight-sm">Wyceń klimatyzator Kaisai z montażem w 5 minut.</p>
        <CTAButton href={`tel:${PHONE_TEL}`} label={labels.callNow} ariaLabel={labels.callNow} />
        <CTAButton href={routes.pricing} label={labels.readPricing} variant="secondary" />
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Zobacz też:</p>
      <a class="text-link" href={routes.gree}>Klimatyzatory Gree z montażem</a>
      <a class="text-link" href={routes.services}>Co dokładnie obejmuje montaż</a>
      <a class="text-link" href={routes.pricing}>Cennik montażu klimatyzacji</a>
    </div>
  </section>
</Layout>
