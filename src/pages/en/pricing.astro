---
import CTAButton from '../../components/CTAButton.astro';
import Layout from '../../components/Layout.astro';
import { BUSINESS, CONTACT_PHONE } from '../../config/site';
import { pageMeta } from '../../i18n/content';

const meta = pageMeta.en.pricing;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/pricing"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Pricing</p>
      <h1>{BUSINESS.pricing.installationService.name.en}</h1>
      <p>{BUSINESS.pricing.installationService.fullDescription.en}</p>
    </div>
  </section>

  <section class="section">
    <div class="container pricing-panel" data-reveal>
      <p class="price-main">
        {BUSINESS.pricing.installationService.name.en}: {BUSINESS.pricing.label.en} — {BUSINESS.pricing.installationService.baseVariantLabel.en}
      </p>
      <ul class="bullet-list">
        <li>{BUSINESS.pricing.installationService.complexPriceDescription.en}</li>
        <li>{BUSINESS.travel.note.en}</li>
        <li>No forms or widgets. Phone call is the fastest quote path.</li>
      </ul>
      <p class="tiny-note">{BUSINESS.pricing.taxNote.en}</p>
      <CTAButton href={CONTACT_PHONE.href} label="Call for a quote" ariaLabel="Call for a quote" />
    </div>
  </section>
</Layout>
