---
import CTAButton from '../../components/CTAButton.astro';
import Layout from '../../components/Layout.astro';
import { BUSINESS, PRIMARY_PHONE } from '../../config/site';
import { pageMeta } from '../../i18n/content';

const meta = pageMeta.en.pricing;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/pricing"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Pricing</p>
      <h1>Clear starting price</h1>
      <p>
        We share a starting price first. Final pricing depends on line length, mounting conditions,
        and technical layout.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container pricing-panel" data-reveal>
      <p class="price-main">Installation price: {BUSINESS.pricing.label.en}</p>
      <ul class="bullet-list">
        <li>{BUSINESS.pricing.includedInstallation.description.en}</li>
        <li>{BUSINESS.travel.note.en}</li>
        <li>No forms or widgets. Phone call is the fastest quote path.</li>
      </ul>
      <p class="tiny-note">{BUSINESS.pricing.taxNote.en}</p>
      <CTAButton href={PRIMARY_PHONE.href} label="Call for a free quote" ariaLabel="Call for a free quote" />
    </div>
  </section>
</Layout>
