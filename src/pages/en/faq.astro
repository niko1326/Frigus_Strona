---
import CTAButton from '../../components/CTAButton.astro';
import Layout from '../../components/Layout.astro';
import { BUSINESS, PRIMARY_PHONE } from '../../config/site';
import { pageMeta } from '../../i18n/content';

const meta = pageMeta.en.faq;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/faq"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h1>Frequently asked questions</h1>
      <p>Quick answers about quotes, installation timeline, and maintenance.</p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-list" data-reveal>
      <details class="faq-item">
        <summary>How long does a split installation take?</summary>
        <p>Usually around one working day, depending on technical conditions and line length.</p>
      </details>

      <details class="faq-item">
        <summary>Is travel charged separately?</summary>
        <p>{BUSINESS.travel.note.en}</p>
      </details>

      <details class="faq-item">
        <summary>Do you perform full electrical work?</summary>
        <p>{BUSINESS.pricing.includedInstallation.description.en} Complex electrical upgrades are not included.</p>
      </details>

      <details class="faq-item">
        <summary>What warranty do you provide?</summary>
        <p>{BUSINESS.warranty.description.en}</p>
      </details>

      <details class="faq-item">
        <summary>Do you offer maintenance cleaning?</summary>
        <p>Yes, we offer basic maintenance and cleaning for split systems.</p>
      </details>

      <details class="faq-item">
        <summary>What is the fastest way to get a quote?</summary>
        <p>Call us directly. In some cases we suggest a short on-site visit.</p>
      </details>
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal>
      <CTAButton href={PRIMARY_PHONE.href} label="Call for a free quote" ariaLabel="Call for a free quote" />
    </div>
  </section>
</Layout>
