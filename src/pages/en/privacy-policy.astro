---
import Layout from '../../components/Layout.astro';
import { BUSINESS } from '../../config/site';
import { pageMeta } from '../../i18n/content';

const meta = pageMeta.en.privacy;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/privacy-policy"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Privacy Policy</p>
      <h1>Basic data information</h1>
      <p>
        {BUSINESS.legalName} handles contact data shared when contacting us to provide quote communication and service
        delivery.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container highlight-card" data-reveal>
      <ul class="bullet-list">
        <li>Data scope: name, phone number, email address, installation address (if provided).</li>
        <li>Purpose: quote communication and service delivery.</li>
        <li>Storage period: no longer than needed for accounting and service communication.</li>
        <li>Data questions: use the contact details listed on this website.</li>
      </ul>
      <p class="tiny-note">This is a concise informational version and can be expanded into a full GDPR policy.</p>
    </div>
  </section>
</Layout>
