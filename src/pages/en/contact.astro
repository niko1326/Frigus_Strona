---
import CTAButton from '../../components/CTAButton.astro';
import Layout from '../../components/Layout.astro';
import { BUSINESS, HOURS, PHONE_DISPLAY, PHONE_TEL, SERVICE_AREAS_EN } from '../../config/site';
import { pageMeta } from '../../i18n/content';

const meta = pageMeta.en.contact;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/contact"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Contact</p>
      <h1>Phone call is the fastest quote</h1>
      <p>
        No forms, no booking widgets. Call us, share your location and unit plan, and we will return with a
        practical next step.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel" data-reveal>
      <a class="phone-big" href={`tel:${PHONE_TEL}`} aria-label="Call CLIM-PRO">
        {PHONE_DISPLAY}
      </a>
      <ul class="bullet-list">
        <li>Mon-Fri: {HOURS.weekdays}</li>
        <li>Saturday: {HOURS.saturday}</li>
        <li>Sunday: {HOURS.sundayEN}</li>
        <li>Team: {BUSINESS.teamSize} people</li>
        <li>Area: {SERVICE_AREAS_EN.join(', ')}</li>
      </ul>
      <p class="tiny-note">Primary contact channel: direct phone call.</p>
      <CTAButton href={`tel:${PHONE_TEL}`} label="Call for a free quote" ariaLabel="Call for a free quote" />
    </div>
  </section>
</Layout>
