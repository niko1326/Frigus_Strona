---
import CTAButton from '../../components/CTAButton.astro';
import Layout from '../../components/Layout.astro';
import { BUSINESS, CONTACT_PHONE } from '../../config/site';
import { commonLabels, pageMeta } from '../../i18n/content';

const meta = pageMeta.en.contact;
const labels = commonLabels.en;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/contact"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Contact</p>
      <h1>Phone call is the fastest quote</h1>
      <p>
        No forms, no booking widgets. Call us, share your location and unit plan, and we will return with a
        practical next step.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel" data-reveal>
      <p>
        <a class="phone-big" href={CONTACT_PHONE.href} aria-label={labels.phoneAria}>{CONTACT_PHONE.display}</a>{' '}
        — {CONTACT_PHONE.contactName}
      </p>
      <a href={BUSINESS.contact.email.href} aria-label={labels.emailAria}>{BUSINESS.contact.email.address}</a>
      <ul class="bullet-list">
        <li>Availability: {BUSINESS.availability.label.en}</li>
        <li>Area: {BUSINESS.serviceArea.summary.en}</li>
      </ul>
      <p class="tiny-note">Contact us by phone or email.</p>
      <CTAButton href={CONTACT_PHONE.href} label="Call for a quote" ariaLabel="Call for a quote" />
    </div>
  </section>
</Layout>
