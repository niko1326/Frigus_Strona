---
import CTAButton from '../../components/CTAButton.astro';
import Layout from '../../components/Layout.astro';
import { BUSINESS, PRIMARY_PHONE } from '../../config/site';
import { pageMeta } from '../../i18n/content';

const meta = pageMeta.en.contact;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/contact"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Contact</p>
      <h1>Phone call is the fastest quote</h1>
      <p>
        No forms, no booking widgets. Call us, share your location and unit plan, and we will return with a
        practical next step.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-panel" data-reveal>
      {
        BUSINESS.contact.phones.map((phone) => (
          <p>
            <a class="phone-big" href={phone.href} aria-label={`Call ${phone.contactName}`}>
              {phone.display}
            </a>{' '}
            — {phone.contactName}
          </p>
        ))
      }
      <a href={BUSINESS.contact.email.href}>{BUSINESS.contact.email.address}</a>
      <ul class="bullet-list">
        <li>Availability: {BUSINESS.availability.label.en}</li>
        <li>Team: {BUSINESS.teamSize} people</li>
        <li>Area: {BUSINESS.serviceArea.summary.en}</li>
      </ul>
      <p class="tiny-note">Contact us by phone or email.</p>
      <CTAButton href={PRIMARY_PHONE.href} label="Call for a free quote" ariaLabel="Call for a free quote" />
    </div>
  </section>
</Layout>
