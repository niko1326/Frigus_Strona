---
import CTAButton from '../../components/CTAButton.astro';
import Layout from '../../components/Layout.astro';
import PhotoGalleryPlaceholder from '../../components/PhotoGalleryPlaceholder.astro';
import IconDrill from '../../components/icons/IconDrill.astro';
import IconIndoor from '../../components/icons/IconIndoor.astro';
import IconOutdoor from '../../components/icons/IconOutdoor.astro';
import IconSparkle from '../../components/icons/IconSparkle.astro';
import { BUSINESS, PRIMARY_PHONE } from '../../config/site';
import { pageMeta } from '../../i18n/content';

const meta = pageMeta.en.services;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/en/services"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Services</p>
      <h1>Split installation and basic maintenance</h1>
      <p>
        We focus on single split installations in apartments and houses, with tidy line routing and clean,
        reliable commissioning.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid" data-reveal>
      <article class="highlight-card">
        <IconIndoor class="service-icon" />
        <h2>What split installation includes</h2>
        <ul class="bullet-list">
          <li>indoor unit mounting</li>
          <li>wall passthrough</li>
          <li>outdoor unit mounting</li>
          <li>full refrigerant line run and commissioning</li>
        </ul>
        <p class="tiny-note">{BUSINESS.pricing.installationService.fullDescription.en}</p>
      </article>

      <article class="highlight-card">
        <IconSparkle class="service-icon" />
        <h2>Maintenance and cleaning</h2>
        <p>
          We provide recurring basic service: cleaning accessible parts and checking essential operating
          parameters.
        </p>
        <ul class="bullet-list">
          <li>indoor unit cleaning and filter service</li>
          <li>condensate drainage check</li>
          <li>post-cleaning operation check</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container card-grid card-grid-3" data-reveal>
      <article class="info-card">
        <IconDrill class="service-icon" />
        <h3>Site preparation</h3>
        <p>We plan line routing to keep the installation neat and technically sound.</p>
      </article>

      <article class="info-card">
        <IconOutdoor class="service-icon" />
        <h3>Outdoor unit setup</h3>
        <p>Stable mounting with serviceability and durability in mind.</p>
      </article>

      <article class="info-card">
        <IconSparkle class="service-icon" />
        <h3>Clean finish</h3>
        <p>After installation, we leave the workspace in order.</p>
      </article>
    </div>
  </section>

  <PhotoGalleryPlaceholder lang="en" />

  <section class="section">
    <div class="container" data-reveal>
      <CTAButton href={PRIMARY_PHONE.href} label="Call for a quote" ariaLabel="Call for a quote" />
    </div>
  </section>
</Layout>
