---
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import PhotoGalleryPlaceholder from '../components/PhotoGalleryPlaceholder.astro';
import IconDrill from '../components/icons/IconDrill.astro';
import IconIndoor from '../components/icons/IconIndoor.astro';
import IconOutdoor from '../components/icons/IconOutdoor.astro';
import IconSparkle from '../components/icons/IconSparkle.astro';
import { PHONE_TEL } from '../config/site';
import { pageMeta } from '../i18n/content';

const meta = pageMeta.pl.services;
---

<Layout
  lang="pl"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/uslugi"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Usługi</p>
      <h1>Montaż split i serwis podstawowy</h1>
      <p>
        Realizujemy pojedyncze instalacje split w mieszkaniach i domach. Skupiamy się na poprawnym
        montażu, estetyce prowadzenia instalacji i czystym zakończeniu prac.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid" data-reveal>
      <article class="highlight-card">
        <IconIndoor class="service-icon" />
        <h2>Co obejmuje montaż split</h2>
        <ul class="bullet-list">
          <li>montaż jednostki wewnętrznej</li>
          <li>przepust przez ścianę</li>
          <li>montaż jednostki zewnętrznej</li>
          <li>prowadzenie pełnej instalacji chłodniczej i uruchomienie</li>
          <li>podłączenie do istniejącej instalacji elektrycznej</li>
        </ul>
        <p class="tiny-note">Nie wykonujemy złożonych prac elektrycznych ani rozbudowy rozdzielni.</p>
      </article>

      <article class="highlight-card">
        <IconSparkle class="service-icon" />
        <h2>Przegląd i czyszczenie</h2>
        <p>
          Oferujemy serwis okresowy: czyszczenie jednostki wewnętrznej, kontrolę podstawowych parametrów
          i sprawdzenie działania układu.
        </p>
        <ul class="bullet-list">
          <li>czyszczenie filtrów i elementów dostępnych serwisowo</li>
          <li>kontrola odprowadzenia skroplin</li>
          <li>sprawdzenie pracy urządzenia po czyszczeniu</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container card-grid card-grid-3" data-reveal>
      <article class="info-card">
        <IconDrill class="service-icon" />
        <h3>Przygotowanie miejsca</h3>
        <p>Dobieramy trasę instalacji tak, aby była możliwie krótka i estetyczna.</p>
      </article>

      <article class="info-card">
        <IconOutdoor class="service-icon" />
        <h3>Montaż zewnętrzny</h3>
        <p>Stabilny montaż jednostki zewnętrznej z myślą o trwałości i dostępie serwisowym.</p>
      </article>

      <article class="info-card">
        <IconSparkle class="service-icon" />
        <h3>Porządek po montażu</h3>
        <p>Po zakończeniu prac zostawiamy miejsce montażu uporządkowane.</p>
      </article>
    </div>
  </section>

  <PhotoGalleryPlaceholder lang="pl" />

  <section class="section">
    <div class="container" data-reveal>
      <CTAButton href={`tel:${PHONE_TEL}`} label="Zadzwoń po darmową wycenę" ariaLabel="Zadzwoń po darmową wycenę" />
    </div>
  </section>
</Layout>
