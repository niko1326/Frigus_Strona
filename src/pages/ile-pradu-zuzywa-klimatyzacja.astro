---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { PHONE_TEL, SITE } from '../config/site';
import { labels, pageMeta, routes } from '../i18n/content';
import {
  calculateEnergyEstimate,
  calculateHeatingEstimate,
  formatEnergyNumber as fmt,
  HEATING_ASSUMPTIONS,
  USAGE_PROFILES
} from '../utils/energy-estimate.mjs';

const meta = pageMeta.calcEnergy;

const defaultEstimate = calculateEnergyEstimate({ power: 3.5, seer: 6.5, price: 1.2, usage: 'standard' });
const defaultHeatingEstimate = calculateHeatingEstimate({
  area: 35,
  height: 'low',
  insulation: 'standard',
  winter: 'standard',
  scop: 4.6,
  price: 1.2
});
const seerTable = [4, 5.5, 6.5, 8, 8.5].map((seer) => ({
  seer: seer.toLocaleString('pl-PL'),
  ...calculateEnergyEstimate({ power: 3.5, seer, price: 1.2, usage: 'standard' })
}));
const faqItems = [
  {
    question: 'Ile prądu zużywa klimatyzacja 3,5 kW?',
    answer: 'Dla mocy chłodniczej 3,5 kW i SEER 6,5 uproszczone referencyjne zużycie wynosi około 188 kWh na sezon. Przy przykładowej cenie 1,20 zł/kWh daje to około 226 zł. Przy SEER 8,5 wynik wynosi około 144 kWh i 173 zł. To wartości modelowe, a nie prognoza konkretnego rachunku ani pomiar poboru chwilowego.'
  },
  {
    question: 'Co to jest SEER?',
    answer: 'SEER to sezonowy współczynnik efektywności chłodzenia. Uwzględnia pracę klimatyzatora przy różnych temperaturach i częściowym obciążeniu w ciągu sezonu. Im wyższy SEER, tym mniej energii urządzenie potrzebuje do zapewnienia tej samej ilości chłodzenia w warunkach testowych. Nie jest to chwilowy współczynnik poboru prądu.'
  },
  {
    question: 'Czy klimatyzacja mocno podnosi rachunki za prąd?',
    answer: 'Koszt zależy od konkretnego urządzenia, ceny energii i warunków użytkowania. Roczne zużycie energii w chłodzeniu podane na etykiecie energetycznej jest dobrym punktem odniesienia dla danego modelu. Rzeczywiste zużycie zależy też od pogody, nastawy temperatury, izolacji, nasłonecznienia, wielkości pomieszczenia oraz modulacji sprężarki.'
  },
  {
    question: 'Jak obniżyć koszt pracy klimatyzacji?',
    answer: 'Niższa nastawa zwykle zwiększa zużycie energii. Wybierz komfortową temperaturę bez nadmiernego wychładzania, zamykaj okna podczas chłodzenia i osłaniaj je przed słońcem. Czyść filtry i serwisuj urządzenie zgodnie z instrukcją producenta. Nie ma jednego dokładnego procentowego wzrostu zużycia na każdy stopień zmiany nastawy.'
  },
  {
    question: 'Ile prądu zużywa klimatyzacja podczas grzania?',
    answer: 'Zużycie zależy od zapotrzebowania cieplnego ogrzewanej strefy i SCOP urządzenia. Kalkulator szacuje widełki na podstawie powierzchni, wysokości, izolacji i warunków zimowych. Wynik jest orientacyjny i nie zastępuje obliczenia OZC.'
  },
  {
    question: 'Co oznacza SCOP?',
    answer: 'SCOP określa sezonową efektywność klimatyzatora podczas ogrzewania. Im wyższy SCOP, tym mniej energii elektrycznej potrzeba do dostarczenia tej samej ilości ciepła w warunkach sezonowych.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator zużycia prądu przez klimatyzację FRIGAC',
  url: new URL(routes.calcEnergy, SITE.siteUrl).toString(),
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  provider: { '@type': 'Organization', name: SITE.brandName, url: SITE.siteUrl }
};
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routes.calcEnergy}
  extraSchema={[appSchema, faqSchema]}
>
  <Breadcrumbs items={[{ label: 'Narzędzia', href: routes.tools }, { label: 'Ile prądu zużywa klimatyzacja' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Darmowe narzędzie</p>
      <h1>Ile prądu zużywa klimatyzacja? Kalkulator</h1>
      <p>
        Oszacuj koszt chłodzenia latem lub ogrzewania klimatyzacją zimą. Wynik uwzględnia
        sezonową efektywność urządzenia i pozostaje orientacyjnym punktem odniesienia.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container tool-layout" data-reveal>
      <form class="tool-form" id="energy-form">
        <fieldset class="mode-switch">
          <legend class="visually-hidden">Tryb pracy kalkulatora</legend>
          <input type="radio" name="energy-mode" id="mode-cooling" value="cooling" aria-controls="cooling-panel" checked />
          <label for="mode-cooling">Chłodzenie</label>
          <input type="radio" name="energy-mode" id="mode-heating" value="heating" aria-controls="heating-panel" />
          <label for="mode-heating">Grzanie</label>
        </fieldset>

        <div class="mode-panel" id="cooling-panel" data-mode-panel="cooling" role="region" aria-labelledby="mode-cooling">
          <fieldset class="tool-step">
            <legend><span class="tool-step-num">1</span>Moc chłodnicza</legend>
            <div class="seg">
              <input type="radio" name="ekw" id="ekw-25" value="2.5" />
              <label for="ekw-25">2,5 kW</label>
              <input type="radio" name="ekw" id="ekw-35" value="3.5" checked />
              <label for="ekw-35">3,5 kW</label>
              <input type="radio" name="ekw" id="ekw-50" value="5" />
              <label for="ekw-50">5,0 kW</label>
              <input type="radio" name="ekw" id="ekw-70" value="7" />
              <label for="ekw-70">7,0 kW</label>
            </div>
          </fieldset>
          <div class="tool-step">
            <label class="tool-step-title" for="seer"><span class="tool-step-num">2</span>SEER</label>
            <input class="energy-input" type="number" id="seer" min="0.1" max="30" step="any" value="6.5" required inputmode="decimal" aria-describedby="seer-hint" />
            <p class="tool-hint" id="seer-hint">Sezonowa efektywność chłodzenia z danych technicznych urządzenia.</p>
          </div>
          <div class="tool-step">
            <label class="tool-step-title" for="cool-price"><span class="tool-step-num">3</span>Cena energii (zł/kWh)</label>
            <input class="energy-input" type="number" id="cool-price" min="0" max="100" step="any" value="1.2" required inputmode="decimal" aria-describedby="cool-price-hint" />
            <p class="tool-hint" id="cool-price-hint">Wpisz stawkę brutto z faktury, wraz z opłatami zależnymi od zużycia.</p>
          </div>
          <fieldset class="tool-step">
            <legend><span class="tool-step-num">4</span>Jak intensywnie korzystasz z klimatyzacji?</legend>
            <div class="seg energy-choice-grid">
              {Object.entries(USAGE_PROFILES).map(([key, profile]) => <>
                <input type="radio" name="usage" id={`usage-${key}`} value={key} checked={key === 'standard'} />
                <label for={`usage-${key}`}><span>{profile.label}</span><small>{profile.description}</small></label>
              </>)}
            </div>
          </fieldset>
        </div>

        <div class="mode-panel" id="heating-panel" data-mode-panel="heating" role="region" aria-labelledby="mode-heating" hidden>
          <div class="tool-step">
            <label class="tool-step-title" for="heat-area"><span class="tool-step-num">1</span>Powierzchnia ogrzewanej strefy</label>
            <div class="energy-input-unit"><input class="energy-input" type="number" id="heat-area" min="10" max="100" step="1" value="35" required inputmode="numeric" /><span>m²</span></div>
          </div>
          <fieldset class="tool-step">
            <legend><span class="tool-step-num">2</span>Wysokość pomieszczenia</legend>
            <div class="seg energy-choice-grid energy-choice-compact">
              {Object.entries(HEATING_ASSUMPTIONS.heights).map(([key, profile]) => <>
                <input type="radio" name="heat-height" id={`heat-height-${key}`} value={key} checked={key === 'low'} />
                <label for={`heat-height-${key}`}><span>{profile.label}</span></label>
              </>)}
            </div>
          </fieldset>
          <fieldset class="tool-step">
            <legend><span class="tool-step-num">3</span>Jak dobrze budynek trzyma ciepło?</legend>
            <div class="seg energy-choice-grid">
              {Object.entries(HEATING_ASSUMPTIONS.heatLoadWm2).map(([key, profile]) => <>
                <input type="radio" name="heat-insulation" id={`heat-insulation-${key}`} value={key} checked={key === 'standard'} />
                <label for={`heat-insulation-${key}`}><span>{profile.label}</span><small>{profile.description}</small></label>
              </>)}
            </div>
          </fieldset>
          <fieldset class="tool-step">
            <legend><span class="tool-step-num">4</span>Jak zimne są warunki zimą?</legend>
            <div class="seg energy-choice-grid">
              {Object.entries(HEATING_ASSUMPTIONS.winters).map(([key, profile]) => <>
                <input type="radio" name="heat-winter" id={`heat-winter-${key}`} value={key} checked={key === 'standard'} />
                <label for={`heat-winter-${key}`}><span>{profile.label}</span><small>{profile.description}</small></label>
              </>)}
            </div>
          </fieldset>
          <div class="tool-step">
            <label class="tool-step-title" for="scop"><span class="tool-step-num">5</span>SCOP urządzenia</label>
            <input class="energy-input" type="number" id="scop" min="0.1" max="20" step="any" value="4.6" required inputmode="decimal" aria-describedby="scop-hint" />
            <p class="tool-hint" id="scop-hint">Znajdziesz go w danych technicznych klimatyzatora. Wyższy SCOP oznacza mniejsze zużycie energii przy tej samej ilości dostarczonego ciepła.</p>
          </div>
          <div class="tool-step">
            <label class="tool-step-title" for="heat-price"><span class="tool-step-num">6</span>Cena energii (zł/kWh)</label>
            <input class="energy-input" type="number" id="heat-price" min="0" max="100" step="any" value="1.2" required inputmode="decimal" />
          </div>
        </div>
        <noscript><p class="tool-hint">Włącz JavaScript, aby zmieniać wynik. Poniżej pokazujemy przykład: 3,5 kW, SEER 6,5, 1,20 zł/kWh, użytkowanie standardowe.</p></noscript>
      </form>

      <div class="tool-result-wrap">
        <div class="tool-result" role="status" aria-live="polite">
          <p class="eyebrow" id="result-eyebrow">Orientacyjne sezonowe zużycie energii</p>
          <p class="result-main"><strong id="eres-kwh">≈ {fmt(defaultEstimate.referenceKwh)} kWh</strong></p>
          <p class="result-sub" id="eres-source">Szacunek dla sezonu chłodzenia</p>
          <dl class="result-rows">
            <div class="result-row"><dt id="eres-cost-label">Orientacyjny koszt sezonu</dt><dd id="eres-season">≈ {fmt(defaultEstimate.seasonCost)} zł / sezon</dd></div>
            <div class="result-row" id="eres-usage-row"><dt>Przy wybranym sposobie użytkowania</dt><dd id="eres-usage">Standardowo</dd></div>
            <div class="result-row" id="eres-range-kwh-row"><dt>Orientacyjne zużycie</dt><dd id="eres-range-kwh">≈ {defaultEstimate.usageKwh.map(fmt).join('–')} kWh / sezon</dd></div>
            <div class="result-row" id="eres-range-cost-row"><dt>Orientacyjny koszt</dt><dd id="eres-range-cost">≈ {defaultEstimate.usageCost.map(fmt).join('–')} zł / sezon</dd></div>
            <div class="result-row" id="eres-peak-row" hidden><dt>Orientacyjne zapotrzebowanie na moc grzewczą</dt><dd id="eres-peak">≈ {defaultHeatingEstimate.peakHeatKw.map((value) => value.toLocaleString('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 1 })).join('–')} kW</dd></div>
          </dl>
          <p id="energy-error" hidden>Uzupełnij poprawnie zaznaczone pola, aby zobaczyć wynik.</p>
          <p class="selection-warning" id="eres-selection-warning" hidden>Wymaga indywidualnego doboru.</p>
          <CTAButton href={`tel:${PHONE_TEL}`} label="Dobierz oszczędny model" ariaLabel={labels.phoneAria} />
          <p class="tool-disclaimer" id="result-disclaimer">To orientacyjne wyliczenie. SEER jest sezonowym wskaźnikiem efektywności. Rzeczywiste zużycie zależy od temperatury zewnętrznej, nastawy, izolacji, nasłonecznienia, wielkości pomieszczenia oraz sposobu użytkowania i modulacji sprężarki.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container article-content" data-reveal>
      <h2>Ile prądu bierze klimatyzacja — na czym opiera się kalkulator?</h2>
      <p>Moc chłodnicza 3,5 kW określa wydajność chłodzenia, a nie pobór elektryczny. Chwilowy pobór zmienia się wraz z obciążeniem i modulacją sprężarki. Nie można go obliczyć jako moc chłodnicza podzielona przez SEER.</p>
      <p>W uproszczonym modelu stosujemy <strong>Qseason ≈ Pdesign × 350 / SEER</strong>. Pdesign to projektowe obciążenie chłodnicze w kW; w formularzu przybliżamy je mocą chłodniczą urządzenia. Jeśli karta produktu podaje Pdesignc, jest ono właściwą wartością odniesienia. 350 oznacza referencyjne równoważne godziny aktywnego chłodzenia — nie liczbę godzin, przez które włączysz urządzenie.</p>
      <p>To podejście zbliżone do etykiety energetycznej UE dla klimatyzatorów split, a nie obliczenie poboru chwilowego ani kosztu konkretnego dnia. Podstawa: <a class="inline-link" href="https://eur-lex.europa.eu/legal-content/PL/TXT/?uri=CELEX:32011R0626">rozporządzenie UE nr 626/2011, definicje w załączniku I i tabela 4 w załączniku VII</a>.</p>
      <h2>Co oznacza SEER?</h2>
      <p>SEER to sezonowy współczynnik efektywności chłodzenia. Uwzględnia pracę klimatyzatora przy różnych temperaturach i częściowym obciążeniu w ciągu sezonu. Im wyższy SEER, tym mniej energii urządzenie potrzebuje do zapewnienia tej samej ilości chłodzenia w warunkach testowych.</p>
      <p>Na etykiecie energetycznej urządzenia można znaleźć także deklarowane roczne zużycie energii w chłodzeniu. Jeśli znasz konkretny model klimatyzatora, ta wartość jest lepszym punktem odniesienia niż sam SEER. Nadal jest to wartość referencyjna, nie pomiar w Twoim domu.</p>
      <h2>SEER a koszt sezonu — klimatyzacja 3,5 kW</h2>
      <div class="table-wrap">
        <table class="tool-table">
          <caption class="visually-hidden">Referencyjne zużycie i koszt sezonu dla mocy 3,5 kW oraz ceny 1,20 zł/kWh</caption>
          <thead><tr><th scope="col">SEER</th><th scope="col">Zużycie (kWh/sezon)</th><th scope="col">Koszt (zł/sezon)</th></tr></thead>
          <tbody>{seerTable.map(row => <tr><td>{row.seer}</td><td>≈ {fmt(row.referenceKwh)}</td><td>≈ {fmt(row.seasonCost)}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="tiny-note">Założenia: moc 3,5 kW jako przybliżenie Pdesign, 350 godzin równoważnych, przykładowa cena 1,20 zł/kWh. Koszt liczymy z niezaokrąglonego zużycia; wyniki pokazujemy w pełnych kWh i złotych.</p>
      <h2>Jak rozumieć sposób użytkowania?</h2>
      <p>Przyjmujemy orientacyjne mnożniki: sporadycznie 0,6–0,9, standardowo 0,9–1,3, intensywnie 1,3–2,0 wartości referencyjnej. To założenia kalkulatora FRIGAC, a nie współczynniki z metodologii UE. Faktyczne zużycie może znaleźć się poza tymi widełkami. Liczba godzin włączonego urządzenia nie jest równa liczbie godzin pracy z pełnym obciążeniem.</p>
      <h2>Jak kalkulator szacuje ogrzewanie klimatyzacją?</h2>
      <p>Tryb grzania najpierw szacuje przedział zapotrzebowania cieplnego ogrzewanej strefy na podstawie powierzchni, wysokości, jakości izolacji i warunków zimowych. Następnie przelicza zapotrzebowanie sezonowe na energię elektryczną, dzieląc je przez SCOP urządzenia. SCOP jest sezonowym współczynnikiem efektywności ogrzewania, dlatego lepiej nadaje się do takiego porównania niż chwilowy COP.</p>
      <p>Przyjęte przedziały obciążenia wynoszą 35–55 W/m² dla dobrej izolacji, 55–80 W/m² dla standardowej i 80–120 W/m² dla słabej. Kalkulator koryguje je proporcjonalnie do reprezentatywnej wysokości pomieszczenia, stosuje mnożnik zimy 0,8, 1,0 lub 1,25 oraz zakres 900–1300 równoważnych godzin pełnego obciążenia. Są to jawne założenia modelu orientacyjnego, a nie wartości z normy ani pełne obliczenie projektowe.</p>
      <p>W europejskiej metodologii SCOP opisuje efektywność sezonową i rozróżnia cieplejszy, umiarkowany oraz chłodniejszy sezon grzewczy. Kategorie w tym kalkulatorze pomagają opisać warunki użytkownika, ale nie odtwarzają profili badawczych jeden do jednego. Więcej informacji zawiera <a class="inline-link" href="https://eur-lex.europa.eu/legal-content/PL/TXT/?uri=CELEX:32012R0206">rozporządzenie Komisji (UE) nr 206/2012</a>.</p>
      <p class="tiny-note">Wynik ogrzewania nie zastępuje obliczenia OZC ani doboru mocy przy temperaturze projektowej. Gdy górna granica zapotrzebowania przekracza 7 kW, kalkulator sygnalizuje potrzebę indywidualnego doboru.</p>
      <h2>Czy warto dopłacić do wyższego SEER?</h2>
      <p>Wyższy SEER oznacza niższe referencyjne zużycie przy takim samym zapotrzebowaniu na chłodzenie. Opłacalność dopłaty zależy od różnicy cen urządzeń, warunków pracy i ceny energii. Porównaj deklarowane roczne zużycie na etykietach konkretnych modeli. SEER dotyczy chłodzenia; do porównania efektywności ogrzewania służy SCOP.</p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Zużycie prądu przez klimatyzację - pytania</h2>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Zobacz też:</p>
      <a class="text-link" href={routes.tools}>Wszystkie kalkulatory</a>
      <a class="text-link" href={routes.calcPower}>Kalkulator mocy klimatyzacji</a>
      <a class="text-link" href={routes.calcCost}>Kalkulator kosztów montażu</a>
      <a class="text-link" href="/porady/jak-czesto-serwisowac-klimatyzacje">Jak serwis wpływa na zużycie energii</a>
    </div>
  </section>
</Layout>

<script>
  import {
    calculateEnergyEstimate,
    calculateHeatingEstimate,
    formatEnergyNumber as fmt,
    USAGE_PROFILES
  } from '../utils/energy-estimate.mjs';
  const form = document.getElementById('energy-form') as HTMLFormElement;
  const seer = document.getElementById('seer') as HTMLInputElement;
  const coolPrice = document.getElementById('cool-price') as HTMLInputElement;
  const area = document.getElementById('heat-area') as HTMLInputElement;
  const scop = document.getElementById('scop') as HTMLInputElement;
  const heatPrice = document.getElementById('heat-price') as HTMLInputElement;
  const powers = Array.from(form.querySelectorAll<HTMLInputElement>('[name="ekw"]'));
  const panels = Array.from(form.querySelectorAll<HTMLElement>('[data-mode-panel]'));
  const resultIds = ['eres-kwh', 'eres-season', 'eres-range-kwh', 'eres-range-cost', 'eres-peak'];
  const set = (id: string, value: string) => { document.getElementById(id)!.textContent = value; };
  const show = (id: string, visible: boolean) => { (document.getElementById(id) as HTMLElement).hidden = !visible; };
  const checked = (name: string) => form.querySelector<HTMLInputElement>(`[name="${name}"]:checked`)!.value;
  const formatDecimal = (value: number) => value.toLocaleString('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

  function setValidity(inputs: HTMLInputElement[]) {
    const valid = inputs.every((input) => input.validity.valid);
    inputs.forEach((input) => input.setAttribute('aria-invalid', String(!input.validity.valid)));
    document.getElementById('energy-error')!.hidden = valid;
    if (!valid) {
      resultIds.forEach(id => set(id, '—'));
      set('eres-source', 'Uzupełnij dane formularza');
    }
    return valid;
  }

  function renderCooling() {
    show('eres-usage-row', true);
    show('eres-range-kwh-row', true);
    show('eres-range-cost-row', true);
    show('eres-peak-row', false);
    show('eres-selection-warning', false);
    set('result-eyebrow', 'Orientacyjne sezonowe zużycie energii');
    set('eres-cost-label', 'Orientacyjny koszt sezonu');
    set('result-disclaimer', 'To orientacyjne wyliczenie. SEER jest sezonowym wskaźnikiem efektywności. Rzeczywiste zużycie zależy od temperatury zewnętrznej, nastawy, izolacji, nasłonecznienia, wielkości pomieszczenia oraz sposobu użytkowania i modulacji sprężarki.');
    if (!setValidity([seer, coolPrice])) return;
    const usage = checked('usage') as keyof typeof USAGE_PROFILES;
    const result = calculateEnergyEstimate({
      power: Number(powers.find(input => input.checked)!.value),
      seer: seer.valueAsNumber,
      price: coolPrice.valueAsNumber,
      usage
    });
    set('eres-kwh', `≈ ${fmt(result.referenceKwh)} kWh`);
    set('eres-season', `≈ ${fmt(result.seasonCost)} zł / sezon`);
    set('eres-range-kwh', `≈ ${result.usageKwh.map(fmt).join('–')} kWh / sezon`);
    set('eres-range-cost', `≈ ${result.usageCost.map(fmt).join('–')} zł / sezon`);
    set('eres-usage', USAGE_PROFILES[usage].label);
    set('eres-source', 'Szacunek dla sezonu chłodzenia');
  }

  function renderHeating() {
    show('eres-usage-row', false);
    show('eres-range-kwh-row', false);
    show('eres-range-cost-row', false);
    show('eres-peak-row', true);
    set('result-eyebrow', 'Orientacyjne zużycie energii na ogrzewanie');
    set('eres-cost-label', 'Orientacyjny koszt ogrzewania');
    set('result-disclaimer', 'To uproszczone oszacowanie. Rzeczywiste zużycie zależy m.in. od izolacji budynku, temperatur zewnętrznych, nastawy temperatury, wentylacji i charakterystyki konkretnego urządzenia. Nie zastępuje obliczenia OZC ani doboru urządzenia.');
    if (!setValidity([area, scop, heatPrice])) {
      show('eres-selection-warning', false);
      return;
    }
    const result = calculateHeatingEstimate({
      area: area.valueAsNumber,
      height: checked('heat-height') as 'low' | 'standard' | 'high',
      insulation: checked('heat-insulation') as 'good' | 'standard' | 'poor',
      winter: checked('heat-winter') as 'mild' | 'standard' | 'cold',
      scop: scop.valueAsNumber,
      price: heatPrice.valueAsNumber
    });
    set('eres-kwh', `≈ ${result.electricityKwh.map(fmt).join('–')} kWh / sezon`);
    set('eres-season', `≈ ${result.cost.map(fmt).join('–')} zł / sezon`);
    set('eres-peak', `≈ ${result.peakHeatKw.map(formatDecimal).join('–')} kW`);
    set('eres-source', 'Uproszczony szacunek dla ogrzewanej strefy');
    show('eres-selection-warning', result.requiresIndividualSelection);
  }

  function activeMode() {
    return checked('energy-mode');
  }

  function compute() {
    if (activeMode() === 'heating') renderHeating();
    else renderCooling();
  }

  function syncMode() {
    const mode = activeMode();
    panels.forEach((panel) => {
      const active = panel.dataset.modePanel === mode;
      panel.hidden = !active;
      panel.setAttribute('aria-hidden', String(!active));
      panel.querySelectorAll<HTMLInputElement>('input').forEach((input) => { input.disabled = !active; });
    });
    compute();
  }

  form.addEventListener('input', (event) => {
    if ((event.target as HTMLInputElement).name === 'energy-mode') syncMode();
    else compute();
  });
  form.addEventListener('submit', event => event.preventDefault());
  syncMode();
</script>

