---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { PHONE_TEL, SITE } from '../config/site';
import { labels, pageMeta, routes } from '../i18n/content';
import {
  calculateEnergyEstimate,
  formatEnergyNumber as fmt,
  HEATING_ASSUMPTIONS,
  USAGE_PROFILES
} from '../utils/energy-estimate.mjs';

const meta = pageMeta.calcEnergy;

const seerTable = [4, 5.5, 6.5, 8, 8.5].map((seer) => ({
  seer: seer.toLocaleString('pl-PL'),
  ...calculateEnergyEstimate({ power: 3.5, seer, area: 35, price: 1.2, usage: 'standard', insulation: 'standard' })
}));
const faqItems = [
  {
    question: 'Ile prądu zużywa klimatyzacja 3,5 kW?',
    answer: 'Dla mocy chłodniczej 3,5 kW i SEER 6,5 uproszczone referencyjne zużycie wynosi około 188 kWh na sezon. Przy przykładowej cenie 1,20 zł/kWh daje to około 226 zł. Przy SEER 8,5 wynik wynosi około 144 kWh i 173 zł. To wartości modelowe, a nie prognoza konkretnego rachunku ani pomiar poboru chwilowego.'
  },
  {
    question: 'Co to jest SEER?',
    answer: 'SEER to sezonowy współczynnik efektywności chłodzenia. Uwzględnia pracę klimatyzatora przy różnych temperaturach i częściowym obciążeniu w ciągu sezonu. Im wyższy SEER, tym mniej energii urządzenie potrzebuje do zapewnienia tej samej ilości chłodzenia w warunkach testowych. Nie jest to chwilowy współczynnik poboru prądu.'
  },
  {
    question: 'Czy klimatyzacja mocno podnosi rachunki za prąd?',
    answer: 'Koszt zależy od konkretnego urządzenia, ceny energii i warunków użytkowania. Roczne zużycie energii w chłodzeniu podane na etykiecie energetycznej jest dobrym punktem odniesienia dla danego modelu. Rzeczywiste zużycie zależy też od pogody, nastawy temperatury, izolacji, nasłonecznienia, wielkości pomieszczenia oraz modulacji sprężarki.'
  },
  {
    question: 'Jak obniżyć koszt pracy klimatyzacji?',
    answer: 'Niższa nastawa zwykle zwiększa zużycie energii. Wybierz komfortową temperaturę bez nadmiernego wychładzania, zamykaj okna podczas chłodzenia i osłaniaj je przed słońcem. Czyść filtry i serwisuj urządzenie zgodnie z instrukcją producenta. Nie ma jednego dokładnego procentowego wzrostu zużycia na każdy stopień zmiany nastawy.'
  },
  {
    question: 'Ile prądu zużywa klimatyzacja podczas grzania?',
    answer: 'Zużycie zależy od zapotrzebowania cieplnego ogrzewanej strefy i SCOP urządzenia. Kalkulator szacuje widełki na podstawie powierzchni, izolacji oraz tego, czy klimatyzator służy do dogrzewania, regularnego ogrzewania czy jako główne źródło ciepła. Wynik jest orientacyjny i nie zastępuje obliczenia OZC.'
  },
  {
    question: 'Co oznacza SCOP?',
    answer: 'SCOP określa sezonową efektywność klimatyzatora podczas ogrzewania. Im wyższy SCOP, tym mniej energii elektrycznej potrzeba do dostarczenia tej samej ilości ciepła w warunkach sezonowych.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Kalkulator zużycia prądu przez klimatyzację FRIGAC',
  url: new URL(routes.calcEnergy, SITE.siteUrl).toString(),
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PLN' },
  provider: { '@type': 'Organization', name: SITE.brandName, url: SITE.siteUrl }
};
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath={routes.calcEnergy}
  extraSchema={[appSchema, faqSchema]}
>
  <Breadcrumbs items={[{ label: 'Narzędzia', href: routes.tools }, { label: 'Ile prądu zużywa klimatyzacja' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Darmowe narzędzie</p>
      <h1>Ile prądu zużywa klimatyzacja? Kalkulator</h1>
      <p>
        Oszacuj koszt chłodzenia latem lub ogrzewania klimatyzacją zimą. Wynik uwzględnia
        sezonową efektywność urządzenia i pozostaje orientacyjnym punktem odniesienia.
      </p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container tool-layout" data-reveal>
      <form class="tool-form" id="energy-form">
        <fieldset class="mode-switch">
          <legend class="visually-hidden">Tryb pracy kalkulatora</legend>
          <input type="radio" name="energy-mode" id="mode-cooling" value="cooling" aria-controls="cooling-panel" checked />
          <label for="mode-cooling">Chłodzenie</label>
          <input type="radio" name="energy-mode" id="mode-heating" value="heating" aria-controls="heating-panel" />
          <label for="mode-heating">Grzanie</label>
        </fieldset>

        <div class="tool-step">
          <label class="tool-step-title" for="energy-model"><span class="tool-step-num">1</span>Wybierz klimatyzator</label>
          <div class="seg brand-switch" aria-label="Marka klimatyzatora">
            <input type="radio" name="energy-brand" id="brand-gree" value="gree" checked />
            <label for="brand-gree">GREE</label>
            <input type="radio" name="energy-brand" id="brand-kaisai" value="kaisai" />
            <label for="brand-kaisai">KAISAI</label>
          </div>
          <select class="energy-input" id="energy-model" required>
            <option value="">Wybierz model GREE</option>
          </select>
        </div>

        <fieldset class="tool-step" id="variant-step">
          <legend><span class="tool-step-num">2</span>Wybierz wariant mocy</legend>
          <div class="seg" id="variant-options" aria-live="polite"></div>
          <p class="tool-hint" id="variant-hint">Najpierw wybierz model klimatyzatora.</p>
        </fieldset>

        <div class="tool-step">
          <label class="tool-step-title" for="energy-area"><span class="tool-step-num">3</span>Powierzchnia pomieszczenia</label>
          <div class="energy-input-unit">
            <input class="energy-input" type="number" id="energy-area" min="10" max="200" step="1" value="30" required inputmode="numeric" />
            <span>m²</span>
          </div>
        </div>

        <fieldset class="tool-step">
          <legend><span class="tool-step-num">4</span>Jak dobrze pomieszczenie jest izolowane?</legend>
          <div class="seg energy-choice-grid">
            {Object.entries(HEATING_ASSUMPTIONS.heatLoadWm2).map(([key, profile]) => <>
              <input type="radio" name="insulation" id={`insulation-${key}`} value={key} checked={key === 'standard'} />
              <label for={`insulation-${key}`}><span>{profile.label}</span><small>{profile.description}</small></label>
            </>)}
          </div>
        </fieldset>

        <div class="mode-panel" id="cooling-panel" data-mode-panel="cooling" role="region" aria-labelledby="mode-cooling">
          <fieldset class="tool-step">
            <legend><span class="tool-step-num">5</span>Jak intensywnie korzystasz z klimatyzacji?</legend>
            <div class="seg energy-choice-grid">
              {Object.entries(USAGE_PROFILES).map(([key, profile]) => <>
                <input type="radio" name="cooling-usage" id={`cooling-usage-${key}`} value={key} checked={key === 'standard'} />
                <label for={`cooling-usage-${key}`}><span>{profile.label}</span><small>{profile.description}</small></label>
              </>)}
            </div>
          </fieldset>
        </div>

        <div class="mode-panel" id="heating-panel" data-mode-panel="heating" role="region" aria-labelledby="mode-heating" hidden>
          <fieldset class="tool-step">
            <legend><span class="tool-step-num">5</span>Jak intensywnie chcesz ogrzewać klimatyzacją?</legend>
            <div class="seg energy-choice-grid">
              {Object.entries(HEATING_ASSUMPTIONS.usage).map(([key, profile]) => <>
                <input type="radio" name="heating-usage" id={`heating-usage-${key}`} value={key} checked={key === 'regular'} />
                <label for={`heating-usage-${key}`}><span>{profile.label}</span><small>{profile.description}</small></label>
              </>)}
            </div>
          </fieldset>
        </div>

        <div class="tool-step">
          <label class="tool-step-title" for="energy-price"><span class="tool-step-num">6</span>Cena energii (zł/kWh)</label>
          <input class="energy-input" type="number" id="energy-price" min="0" max="100" step="any" value="1.2" required inputmode="decimal" aria-describedby="energy-price-hint" />
          <p class="tool-hint" id="energy-price-hint">Wpisz stawkę brutto z faktury, wraz z opłatami zależnymi od zużycia.</p>
        </div>
        <noscript><p class="tool-hint">Włącz JavaScript, aby wybrać model i zobaczyć wynik.</p></noscript>
      </form>

      <div class="tool-result-wrap">
        <div class="tool-result" role="status" aria-live="polite">
          <p class="eyebrow" id="result-eyebrow">Chłodzenie</p>
          <dl class="result-selection">
            <div><dt>Model</dt><dd id="eres-model">Wybierz model</dd></div>
            <div><dt>Moc</dt><dd id="eres-power">—</dd></div>
            <div><dt>Metraż</dt><dd id="eres-area">30 m²</dd></div>
          </dl>
          <p class="result-main"><strong id="eres-kwh">—</strong></p>
          <p class="result-sub" id="eres-source">Wybierz model i wariant mocy</p>
          <dl class="result-rows">
            <div class="result-row"><dt>Orientacyjny koszt</dt><dd id="eres-season">—</dd></div>
            <div class="result-row"><dt>Założenia</dt><dd id="eres-usage">—</dd></div>
            <div class="result-row"><dt id="eres-peak-label">Orientacyjne obciążenie chłodnicze</dt><dd id="eres-peak">—</dd></div>
            <div class="result-row"><dt>Parametr urządzenia</dt><dd id="eres-efficiency">—</dd></div>
          </dl>
          <p id="energy-error">Wybierz model i wariant mocy, aby zobaczyć wynik.</p>
          <p class="selection-warning" id="eres-selection-warning" hidden>Wybrana moc wymaga sprawdzenia dla tego metrażu.</p>
          <CTAButton href={`tel:${PHONE_TEL}`} label="Dobierz oszczędny model" ariaLabel={labels.phoneAria} />
          <p class="tool-disclaimer" id="result-disclaimer">To orientacyjne wyliczenie. SEER jest sezonowym wskaźnikiem efektywności. Rzeczywiste zużycie zależy od temperatury zewnętrznej, nastawy, izolacji, nasłonecznienia, wielkości pomieszczenia oraz sposobu użytkowania i modulacji sprężarki.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container article-content" data-reveal>
      <h2>Ile prądu bierze klimatyzacja — na czym opiera się kalkulator?</h2>
      <p>Moc chłodnicza 3,5 kW określa wydajność chłodzenia, a nie pobór elektryczny. Chwilowy pobór zmienia się wraz z obciążeniem i modulacją sprężarki. Nie można go obliczyć jako moc chłodnicza podzielona przez SEER.</p>
      <p>W uproszczonym modelu stosujemy <strong>Qseason ≈ Pdesign × 350 / SEER</strong>. Pdesign to projektowe obciążenie chłodnicze w kW; w formularzu przybliżamy je mocą chłodniczą urządzenia. Jeśli karta produktu podaje Pdesignc, jest ono właściwą wartością odniesienia. 350 oznacza referencyjne równoważne godziny aktywnego chłodzenia — nie liczbę godzin, przez które włączysz urządzenie.</p>
      <p>To podejście zbliżone do etykiety energetycznej UE dla klimatyzatorów split, a nie obliczenie poboru chwilowego ani kosztu konkretnego dnia. Podstawa: <a class="inline-link" href="https://eur-lex.europa.eu/legal-content/PL/TXT/?uri=CELEX:32011R0626">rozporządzenie UE nr 626/2011, definicje w załączniku I i tabela 4 w załączniku VII</a>.</p>
      <h2>Co oznacza SEER?</h2>
      <p>SEER to sezonowy współczynnik efektywności chłodzenia. Uwzględnia pracę klimatyzatora przy różnych temperaturach i częściowym obciążeniu w ciągu sezonu. Im wyższy SEER, tym mniej energii urządzenie potrzebuje do zapewnienia tej samej ilości chłodzenia w warunkach testowych.</p>
      <p>Na etykiecie energetycznej urządzenia można znaleźć także deklarowane roczne zużycie energii w chłodzeniu. Jeśli znasz konkretny model klimatyzatora, ta wartość jest lepszym punktem odniesienia niż sam SEER. Nadal jest to wartość referencyjna, nie pomiar w Twoim domu.</p>
      <h2>SEER a koszt sezonu — klimatyzacja 3,5 kW</h2>
      <div class="table-wrap">
        <table class="tool-table">
          <caption class="visually-hidden">Referencyjne zużycie i koszt sezonu dla mocy 3,5 kW oraz ceny 1,20 zł/kWh</caption>
          <thead><tr><th scope="col">SEER</th><th scope="col">Zużycie (kWh/sezon)</th><th scope="col">Koszt (zł/sezon)</th></tr></thead>
          <tbody>{seerTable.map(row => <tr><td>{row.seer}</td><td>≈ {fmt(row.referenceKwh)}</td><td>≈ {fmt(row.seasonCost)}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="tiny-note">Założenia: moc 3,5 kW jako przybliżenie Pdesign, 350 godzin równoważnych, przykładowa cena 1,20 zł/kWh. Koszt liczymy z niezaokrąglonego zużycia; wyniki pokazujemy w pełnych kWh i złotych.</p>
      <h2>Jak rozumieć sposób użytkowania?</h2>
      <p>Przyjmujemy orientacyjne mnożniki: sporadycznie 0,6–0,9, standardowo 0,9–1,3, intensywnie 1,3–2,0 wartości referencyjnej. Kalkulator koryguje widełki także na podstawie metrażu, izolacji i relacji mocy wybranego wariantu do orientacyjnego obciążenia 80–120 W/m². To założenia kalkulatora FRIGAC, a nie współczynniki z metodologii UE. Faktyczne zużycie może znaleźć się poza tymi widełkami.</p>
      <h2>Jak kalkulator szacuje ogrzewanie klimatyzacją?</h2>
      <p>Tryb grzania najpierw szacuje przedział sezonowego zapotrzebowania na ciepło na podstawie powierzchni, jakości izolacji i planowanego sposobu ogrzewania. Następnie dzieli tę wartość przez SCOP konkretnego wariantu urządzenia. SCOP jest sezonowym współczynnikiem efektywności ogrzewania, dlatego lepiej nadaje się do takiego porównania niż chwilowy COP.</p>
      <p>Do orientacyjnej kontroli mocy przyjmujemy 35–55 W/m² dla dobrej izolacji, 55–80 W/m² dla standardowej i 80–120 W/m² dla słabej. Osobne mnożniki rozróżniają dogrzewanie, regularną pracę i użycie klimatyzatora jako głównego ogrzewania. Są to jawne założenia modelu orientacyjnego, a nie wartości z normy ani pełne obliczenie projektowe.</p>
      <p>SCOP opisuje efektywność sezonową urządzenia w warunkach badawczych. Kalkulator korzysta wyłącznie ze zweryfikowanego SCOP wybranego wariantu i nie zastępuje go maksymalnym parametrem całej serii. Więcej informacji o metodologii zawiera <a class="inline-link" href="https://eur-lex.europa.eu/legal-content/PL/TXT/?uri=CELEX:32012R0206">rozporządzenie Komisji (UE) nr 206/2012</a>.</p>
      <p class="tiny-note">Wynik ogrzewania nie zastępuje obliczenia OZC ani doboru mocy przy temperaturze projektowej. Kalkulator sygnalizuje, gdy moc grzewcza wariantu nie pokrywa górnej granicy orientacyjnego obciążenia.</p>
      <h2>Czy warto dopłacić do wyższego SEER?</h2>
      <p>Wyższy SEER oznacza niższe referencyjne zużycie przy takim samym zapotrzebowaniu na chłodzenie. Opłacalność dopłaty zależy od różnicy cen urządzeń, warunków pracy i ceny energii. Porównaj deklarowane roczne zużycie na etykietach konkretnych modeli. SEER dotyczy chłodzenia; do porównania efektywności ogrzewania służy SCOP.</p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Zużycie prądu przez klimatyzację - pytania</h2>
      </div>
      <div class="faq-list">
        {
          faqItems.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Zobacz też:</p>
      <a class="text-link" href={routes.tools}>Wszystkie kalkulatory</a>
      <a class="text-link" href={routes.calcPower}>Kalkulator mocy klimatyzacji</a>
      <a class="text-link" href={routes.calcCost}>Kalkulator kosztów montażu</a>
      <a class="text-link" href="/porady/jak-czesto-serwisowac-klimatyzacje">Jak serwis wpływa na zużycie energii</a>
    </div>
  </section>
</Layout>

<script>
  import { ENERGY_MODELS } from '../config/lineups';
  import {
    calculateEnergyEstimate,
    calculateHeatingEstimate,
    formatEnergyNumber as fmt,
    HEATING_ASSUMPTIONS,
    USAGE_PROFILES
  } from '../utils/energy-estimate.mjs';
  import {
    changeCalculatorMode,
    createCalculatorState,
    selectCalculatorModel,
    stateFromQuery
  } from '../utils/energy-calculator-state.mjs';

  const form = document.getElementById('energy-form') as HTMLFormElement;
  const modelSelect = document.getElementById('energy-model') as HTMLSelectElement;
  const variantOptions = document.getElementById('variant-options') as HTMLDivElement;
  const variantHint = document.getElementById('variant-hint') as HTMLParagraphElement;
  const areaInput = document.getElementById('energy-area') as HTMLInputElement;
  const priceInput = document.getElementById('energy-price') as HTMLInputElement;
  const panels = Array.from(form.querySelectorAll<HTMLElement>('[data-mode-panel]'));
  const set = (id: string, value: string) => { document.getElementById(id)!.textContent = value; };
  const show = (id: string, visible: boolean) => { (document.getElementById(id) as HTMLElement).hidden = !visible; };
  const formatDecimal = (value: number) => value.toLocaleString('pl-PL', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  let state = stateFromQuery(window.location.search, ENERGY_MODELS, createCalculatorState());

  function selectedModel() {
    return ENERGY_MODELS.find((model) => model.slug === state.selectedModel);
  }

  function selectedVariant() {
    return selectedModel()?.variants.find((variant) => variant.powerKw === state.selectedVariant);
  }

  function updateUrl() {
    const url = new URL(window.location.href);
    state.selectedModel ? url.searchParams.set('model', state.selectedModel) : url.searchParams.delete('model');
    state.selectedVariant !== null
      ? url.searchParams.set('power', String(state.selectedVariant))
      : url.searchParams.delete('power');
    url.searchParams.set('mode', state.mode);
    window.history.replaceState({}, '', url);
  }

  function renderModelOptions() {
    const models = ENERGY_MODELS.filter((model) => model.brand === state.selectedBrand);
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = `Wybierz model ${state.selectedBrand.toUpperCase()}`;
    modelSelect.replaceChildren(placeholder);
    models.forEach((model) => {
      const option = document.createElement('option');
      option.value = model.slug;
      option.textContent = model.name;
      modelSelect.append(option);
    });
    modelSelect.value = state.selectedModel;
  }

  function renderVariants() {
    const model = selectedModel();
    variantOptions.replaceChildren();
    if (!model) {
      variantHint.textContent = 'Najpierw wybierz model klimatyzatora.';
      return;
    }
    variantHint.textContent = model.variants.length === 1
      ? 'Ten model występuje w jednym wariancie mocy.'
      : 'Wybierz wariant dostępny dla tego modelu.';
    model.variants.forEach((variant, index) => {
      const input = document.createElement('input');
      input.type = 'radio';
      input.name = 'energy-variant';
      input.id = `energy-variant-${index}`;
      input.value = String(variant.powerKw);
      input.checked = variant.powerKw === state.selectedVariant;
      const label = document.createElement('label');
      label.htmlFor = input.id;
      label.textContent = `${variant.label} kW`;
      variantOptions.append(input, label);
    });
  }

  function renderIdentity() {
    const model = selectedModel();
    const variant = selectedVariant();
    set('eres-model', model ? `${model.brandLabel} ${model.name}` : 'Wybierz model');
    set('eres-power', variant ? `${variant.label} kW` : '—');
    set('eres-area', areaInput.validity.valid ? `${formatDecimal(areaInput.valueAsNumber)} m²` : '—');
  }

  function resultUnavailable(message: string) {
    set('eres-kwh', '—');
    set('eres-season', '—');
    set('eres-usage', '—');
    set('eres-peak', '—');
    set('eres-efficiency', '—');
    set('eres-source', message);
    set('energy-error', message);
    show('energy-error', true);
    show('eres-selection-warning', false);
  }

  function validSharedInputs() {
    const inputs = [areaInput, priceInput];
    inputs.forEach((input) => input.setAttribute('aria-invalid', String(!input.validity.valid)));
    return inputs.every((input) => input.validity.valid);
  }

  function renderCooling() {
    set('result-eyebrow', 'Chłodzenie');
    set('eres-peak-label', 'Orientacyjne obciążenie chłodnicze');
    set('result-disclaimer', 'To orientacyjne widełki. Uwzględniają SEER konkretnego wariantu, metraż, relację mocy urządzenia do szacowanego obciążenia i sposób użytkowania. Rzeczywiste zużycie zależy też od pogody, nastawy, izolacji, nasłonecznienia i modulacji sprężarki.');
    const variant = selectedVariant();
    if (!selectedModel() || !variant) return resultUnavailable('Wybierz model i wariant mocy.');
    if (!validSharedInputs()) return resultUnavailable('Uzupełnij poprawnie metraż i cenę energii.');
    if (!variant.coolingCapacityKw || !variant.seer) {
      return resultUnavailable('Brak zweryfikowanych danych SEER dla tego wariantu. Wybierz inny model lub moc.');
    }
    const usage = state.coolingUsage as keyof typeof USAGE_PROFILES;
    const result = calculateEnergyEstimate({
      power: variant.coolingCapacityKw,
      seer: variant.seer,
      area: state.area,
      price: state.electricityPrice,
      usage,
      insulation: state.insulation as keyof typeof HEATING_ASSUMPTIONS.heatLoadWm2
    });
    set('eres-kwh', `≈ ${result.usageKwh.map(fmt).join('–')} kWh / sezon`);
    set('eres-season', `≈ ${result.usageCost.map(fmt).join('–')} zł / sezon`);
    set('eres-usage', `${HEATING_ASSUMPTIONS.heatLoadWm2[state.insulation as keyof typeof HEATING_ASSUMPTIONS.heatLoadWm2].label} · ${USAGE_PROFILES[usage].label}`);
    set('eres-peak', `≈ ${result.roomLoadKw.map(formatDecimal).join('–')} kW`);
    set('eres-efficiency', `SEER ${formatDecimal(variant.seer)}`);
    set('eres-source', 'Szacunek dla sezonu chłodzenia');
    show('energy-error', false);
    show('eres-selection-warning', result.capacityStatus !== 'adequate');
  }

  function renderHeating() {
    set('result-eyebrow', 'Grzanie');
    set('eres-peak-label', 'Orientacyjne zapotrzebowanie na moc grzewczą');
    set('result-disclaimer', 'To uproszczone oszacowanie na podstawie metrażu, izolacji i sposobu ogrzewania. Zużycie energii wynika z sezonowego zapotrzebowania na ciepło podzielonego przez SCOP konkretnego wariantu. Wynik nie zastępuje OZC ani doboru mocy przy temperaturze projektowej.');
    const variant = selectedVariant();
    if (!selectedModel() || !variant) return resultUnavailable('Wybierz model i wariant mocy.');
    if (!validSharedInputs()) return resultUnavailable('Uzupełnij poprawnie metraż i cenę energii.');
    if (!variant.heatingCapacityKw || !variant.scop) {
      return resultUnavailable('Brak zweryfikowanych danych SCOP dla tego wariantu. Wybierz inny model lub moc.');
    }
    const insulation = state.insulation as keyof typeof HEATING_ASSUMPTIONS.heatLoadWm2;
    const usage = state.heatingUsage as keyof typeof HEATING_ASSUMPTIONS.usage;
    const result = calculateHeatingEstimate({
      area: state.area,
      insulation,
      usage,
      scop: variant.scop,
      heatingCapacityKw: variant.heatingCapacityKw,
      price: state.electricityPrice
    });
    set('eres-kwh', `≈ ${result.electricityKwh.map(fmt).join('–')} kWh / sezon`);
    set('eres-season', `≈ ${result.cost.map(fmt).join('–')} zł / sezon`);
    set('eres-usage', `${HEATING_ASSUMPTIONS.heatLoadWm2[insulation].label} · ${HEATING_ASSUMPTIONS.usage[usage].label}`);
    set('eres-peak', `≈ ${result.peakHeatKw.map(formatDecimal).join('–')} kW`);
    set('eres-efficiency', `SCOP ${formatDecimal(variant.scop)}`);
    set('eres-source', 'Uproszczony szacunek dla sezonu grzewczego');
    show('energy-error', false);
    show('eres-selection-warning', result.requiresIndividualSelection);
  }

  function compute() {
    renderIdentity();
    state.mode === 'heating' ? renderHeating() : renderCooling();
  }

  function syncMode() {
    form.querySelector<HTMLInputElement>(`[name="energy-mode"][value="${state.mode}"]`)!.checked = true;
    panels.forEach((panel) => {
      const active = panel.dataset.modePanel === state.mode;
      panel.hidden = !active;
      panel.setAttribute('aria-hidden', String(!active));
    });
    compute();
  }

  form.addEventListener('input', (event) => {
    const target = event.target as HTMLInputElement | HTMLSelectElement;
    if (target.name === 'energy-mode') {
      state = changeCalculatorMode(state, target.value);
      syncMode();
    } else if (target.name === 'energy-brand') {
      state = { ...state, selectedBrand: target.value, selectedModel: '' };
      renderModelOptions();
      renderVariants();
      compute();
    } else if (target.id === 'energy-model') {
      const model = ENERGY_MODELS.find((item) => item.slug === target.value);
      state = model
        ? selectCalculatorModel(state, model)
        : { ...state, selectedModel: '', selectedVariant: null };
      renderVariants();
      compute();
    } else if (target.name === 'energy-variant') {
      state = { ...state, selectedVariant: Number(target.value) };
      compute();
    } else if (target.id === 'energy-area') {
      state = { ...state, area: areaInput.valueAsNumber };
      compute();
    } else if (target.id === 'energy-price') {
      state = { ...state, electricityPrice: priceInput.valueAsNumber };
      compute();
    } else if (target.name === 'cooling-usage') {
      state = { ...state, coolingUsage: target.value };
      compute();
    } else if (target.name === 'insulation') {
      state = { ...state, insulation: target.value };
      compute();
    } else if (target.name === 'heating-usage') {
      state = { ...state, heatingUsage: target.value };
      compute();
    }
    updateUrl();
  });
  form.addEventListener('submit', event => event.preventDefault());

  form.querySelector<HTMLInputElement>(`[name="energy-brand"][value="${state.selectedBrand}"]`)!.checked = true;
  areaInput.value = String(state.area);
  priceInput.value = String(state.electricityPrice);
  form.querySelector<HTMLInputElement>(`[name="cooling-usage"][value="${state.coolingUsage}"]`)!.checked = true;
  form.querySelector<HTMLInputElement>(`[name="insulation"][value="${state.insulation}"]`)!.checked = true;
  form.querySelector<HTMLInputElement>(`[name="heating-usage"][value="${state.heatingUsage}"]`)!.checked = true;
  renderModelOptions();
  renderVariants();
  syncMode();
</script>

<style>
  .energy-input { width: 100%; min-width: 0; min-height: 48px; border: 1px solid var(--line); border-radius: 10px; padding: 0.65rem 0.8rem; font: inherit; font-size: 1rem; color: var(--ink); background: var(--canvas); }
  .energy-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .energy-input[aria-invalid="true"] { border-color: #af3333; }
  .energy-input-unit { position: relative; }
  .energy-input-unit .energy-input { padding-right: 3rem; }
  .energy-input-unit span { position: absolute; top: 50%; right: 0.9rem; transform: translateY(-50%); color: var(--muted); font-size: 0.9rem; pointer-events: none; }
  .mode-switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.3rem; min-width: 0; margin: 1rem 0 0.4rem; padding: 0.25rem; border: 1px solid var(--line); border-radius: var(--radius-pill); background: var(--parchment); }
  .mode-switch input { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .mode-switch label { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 44px; padding: 0.55rem 0.7rem; border-radius: var(--radius-pill); color: var(--muted); font-weight: 600; cursor: pointer; transition: color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease; }
  .mode-switch input:checked + label { color: #fff; background: var(--accent); box-shadow: 0 2px 8px rgba(10, 114, 194, 0.22); }
  .mode-switch input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 3px; }
  .mode-panel[hidden], .result-row[hidden], [hidden] { display: none !important; }
  .mode-panel { animation: mode-panel-in 0.18s ease-out; }
  @keyframes mode-panel-in { from { opacity: 0.4; transform: translateY(3px); } to { opacity: 1; transform: translateY(0); } }
  .brand-switch { gap: 0.4rem; }
  .brand-switch label { min-width: 6.5rem; }
  .energy-choice-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.45rem; }
  .energy-choice-grid label { display: grid; align-content: center; justify-content: start; gap: 0.1rem; width: 100%; min-height: 58px; padding: 0.55rem 0.7rem; white-space: normal; border-radius: 10px; text-align: left; }
  .energy-choice-grid small { font-size: 0.78rem; line-height: 1.35; font-weight: 400; }
  .energy-choice-compact label { min-height: 44px; }
  .selection-warning { margin: -0.25rem 0 0; padding: 0.7rem 0.8rem; border: 1px solid rgba(255, 255, 255, 0.38); border-radius: 10px; background: rgba(255, 255, 255, 0.1); color: #fff; font-weight: 700; }
  #energy-error { color: white; }
  #energy-form fieldset { min-width: 0; }
  .result-selection { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 0.7fr)); gap: 0.8rem; margin: -0.2rem 0 0; padding: 0 0 1rem; border-bottom: 1px solid rgba(255, 255, 255, 0.22); }
  .result-selection div { min-width: 0; }
  .result-selection dt { color: #bfe0f7; font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; }
  .result-selection dd { margin: 0.2rem 0 0; color: #fff; font-size: 0.9rem; font-weight: 600; line-height: 1.3; overflow-wrap: anywhere; }
  @media (min-width: 900px) {
    .energy-choice-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 359px) {
    .mode-switch label { min-height: 42px; padding-inline: 0.45rem; font-size: 0.9rem; }
    .result-selection { grid-template-columns: 1fr 1fr; }
    .result-selection div:first-child { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mode-panel { animation: none; }
  }
</style>
