---
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { BUSINESS, PRIMARY_PHONE } from '../config/site';
import { pageMeta } from '../i18n/content';

const meta = pageMeta.pl.pricing;
---

<Layout
  lang="pl"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/cennik"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Cennik</p>
      <h1>Przejrzysta cena startowa</h1>
      <p>
        Pokazujemy cenę startową, bo finalna cena zależy od długości instalacji, miejsca montażu i
        warunków technicznych.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container pricing-panel" data-reveal>
      <p class="price-main">Cena montażu: {BUSINESS.pricing.label.pl}</p>
      <ul class="bullet-list">
        <li>{BUSINESS.pricing.includedInstallation.description.pl}</li>
        <li>{BUSINESS.travel.note.pl}</li>
        <li>Brak formularzy: najkrótsza droga do wyceny to telefon.</li>
      </ul>
      <p class="tiny-note">{BUSINESS.pricing.taxNote.pl}</p>
      <CTAButton href={PRIMARY_PHONE.href} label="Zadzwoń po darmową wycenę" ariaLabel="Zadzwoń po darmową wycenę" />
    </div>
  </section>
</Layout>
