---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BrandPricingCards from '../components/BrandPricingCards.astro';
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { PHONE_TEL, PRICING } from '../config/site';
import { labels, pageMeta, routes } from '../i18n/content';

const meta = pageMeta.pricing;

type AdditionalService = {
  service: string;
  price: string;
  guideHref?: string;
  guideLabel?: string;
};

const priceFactors = [
  {
    title: 'Długość instalacji',
    description: 'Im krótsza trasa między jednostką wewnętrzną a zewnętrzną, tym niższy koszt montażu.'
  },
  {
    title: 'Miejsce montażu jednostki zewnętrznej',
    description: 'Montaż na balkonie lub przy gruncie jest tańszy niż praca na elewacji z technikami alpinistycznymi.'
  },
  {
    title: 'Klasa urządzenia',
    description: 'Cena zależy od wybranej mocy i producenta. Doradzimy urządzenie dopasowane do budżetu.'
  }
];

const additionalServices: AdditionalService[] = [
  {
    service: 'Dodatkowy metr instalacji 2,5-3,5 kW',
    price: `od ${PRICING.extraInstallationMeterFromPLN} zł brutto / mb`
  },
  {
    service: 'Dodatkowy metr instalacji od ok. 5 kW',
    price: 'od 170 zł brutto / mb'
  },
  {
    service: 'Dodatkowy metr instalacji ok. 7 kW',
    price: 'od 200 zł brutto / mb'
  },
  {
    service: 'Pompka skroplin z montażem',
    price: `od ${PRICING.condensatePumpFromPLN} zł brutto`,
    guideHref: '/porady/pompka-skroplin-do-klimatyzacji',
    guideLabel: 'Kiedy potrzebna jest pompka skroplin?'
  },
  {
    service: 'Moduł pomiaru zużycia energii Wi-Fi z montażem',
    price: `od ${PRICING.energyMeterFromPLN} zł brutto`,
    guideHref: '/porady/pomiar-zuzycia-pradu-klimatyzacji-wifi',
    guideLabel: 'Jak działa pomiar zużycia energii?'
  },
  {
    service: 'Nietypowe prace montażowe',
    price: 'wycena indywidualna'
  }
];

const brandPricing = [
  { name: 'GREE', href: routes.gree },
  { name: 'KAISAI', href: routes.kaisai }
];
---

<Layout
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/cennik"
>
  <Breadcrumbs items={[{ label: 'Cennik' }]} />

  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Cennik</p>
      <h1>Ile kosztuje montaż klimatyzacji?</h1>
      <p>
        Gramy w otwarte karty: podajemy cenę startową i tłumaczymy, co wpływa na finalną wycenę.
        Orientacyjne widełki sprawdzisz również samodzielnie w kalkulatorze kosztów.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container pricing-panel" id={PRICING.startingPriceAnchor} data-reveal>
      <p class="price-main">
        Klimatyzator z montażem od {PRICING.installFromPLN} zł
        <span class="price-note">brutto</span>
      </p>
      <ul class="bullet-list">
        <li>Standardowy montaż do {PRICING.standardInstallationMeters} mb z prowadzeniem instalacji w korytkach.</li>
        <li>{PRICING.travelIncluded}</li>
        <li>Podłączenie do istniejącej instalacji elektrycznej w cenie montażu.</li>
        <li>Ostateczną cenę potwierdzamy przed rozpoczęciem realizacji.</li>
        <li>5 lat gwarancji producenta.</li>
      </ul>
      <p class="tiny-note pricing-start-note">
        {PRICING.startingPriceDetails} Cennik aktualny od 01.10.2026 r.
      </p>
      <p class="tiny-note">{PRICING.pricingNote}</p>
      <a class="text-link pricing-models-jump" href="#modele-i-ceny">
        Zobacz konkretne modele i ceny z montażem
      </a>
      <CTAButton href={`tel:${PHONE_TEL}`} label={labels.scheduleVisit} ariaLabel={labels.scheduleVisit} />
    </div>

    <div class="container pricing-models-section" id="modele-i-ceny" data-reveal>
      <div class="section-head">
        <p class="eyebrow">GREE i KAISAI</p>
        <h2>Sprawdź konkretne modele i ceny</h2>
        <p>
          Cena zależy od wybranego urządzenia i wariantu mocy. Zobacz dostępne modele GREE
          i KAISAI wraz z cenami z urządzeniem i standardowym montażem.
        </p>
      </div>
      <BrandPricingCards brands={brandPricing} />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Standard FRIGAC</p>
        <h2>Co obejmuje standardowy montaż</h2>
      </div>
      <div class="plain-stack">
        <ul class="check-list">
          <li>dobór mocy i modelu do metrażu, nasłonecznienia i układu pomieszczeń,</li>
          <li>dostawa urządzenia,</li>
          <li>klimatyzator split z jednostką wewnętrzną i zewnętrzną,</li>
          <li>montaż jednostki wewnętrznej,</li>
          <li>przepust przez ścianę,</li>
          <li>montaż jednostki zewnętrznej,</li>
          <li>do {PRICING.standardInstallationMeters} mb instalacji chłodniczej, przewody, odpływ skroplin i prowadzenie instalacji w korytkach,</li>
          <li>podłączenie urządzenia do instalacji elektrycznej,</li>
          <li>wykonanie próżni, uruchomienie i test działania,</li>
          <li>pokazanie obsługi pilota oraz, na prośbę klienta, pomoc w pierwszym połączeniu z aplikacją mobilną w modelach z Wi-Fi,</li>
          <li>{PRICING.travelIncluded}</li>
          <li>5 lat gwarancji producenta.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Cennik</p>
        <h2>Usługi dodatkowe</h2>
      </div>
      <div class="table-wrap">
        <table class="tool-table additional-services-table">
          <caption class="visually-hidden">Cennik usług dodatkowych</caption>
          <thead>
            <tr>
              <th scope="col">Usługa</th>
              <th scope="col">Cena</th>
            </tr>
          </thead>
          <tbody>
            {
              additionalServices.map((item) => (
                <tr>
                  <td>
                    <span class="additional-service-content">
                      <span class="additional-service-name">{item.service}</span>
                      {item.guideHref && item.guideLabel && (
                        <a class="text-link text-link-inline service-guide-link" href={item.guideHref}>
                          {item.guideLabel}
                        </a>
                      )}
                    </span>
                  </td>
                  <td><strong>{item.price}</strong></td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="additional-services-description">
        W większych jednostkach stosowane są większe średnice rur chłodniczych, dlatego koszt
        dodatkowego metra instalacji jest odpowiednio wyższy.
      </p>
      <p class="tiny-note">
        Ceny dotyczą standardowych warunków montażowych. Ostateczna wycena zależy od przebiegu
        instalacji, dostępu i warunków technicznych.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band" data-reveal>
      <div>
        <h2>Sprawdź koszt swojej konfiguracji</h2>
        <p>Podaj liczbę pomieszczeń, metraż i długość instalacji, aby poznać orientacyjne widełki.</p>
      </div>
      <CTAButton
        href={routes.calcCost}
        label="Oblicz orientacyjny koszt montażu →"
        variant="inverse"
      />
    </div>
  </section>

  <section class="section section-gray">
    <div class="container" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Wycena</p>
        <h2>Co wpływa na cenę montażu klimatyzacji</h2>
        <p>
          Koszt montażu klimatyzacji zależy od długości trasy, miejsca montażu oraz wybranego
          urządzenia. Typowe usługi mają ceny wskazane wyżej, a nietypowe prace wyceniamy po
          poznaniu warunków technicznych.
        </p>
      </div>
      <div class="card-grid card-grid-3">
        {
          priceFactors.map((factor) => (
            <article class="info-card">
              <h3>{factor.title}</h3>
              <p>{factor.description}</p>
            </article>
          ))
        }
      </div>
      <div class="plain-stack individual-pricing">
        <h3>Dodatkowe koszty montażu wyceniane indywidualnie</h3>
        <ul class="bullet-list">
          <li>niestandardowy przebieg trasy instalacji wymagający dodatkowych prac,</li>
          <li>montaż jednostki zewnętrznej na elewacji z dostępem wysokościowym,</li>
          <li>konstrukcje wsporcze i nietypowe mocowania.</li>
        </ul>
        <p class="tiny-note">
          W typowych przypadkach możemy podać orientacyjny koszt wcześniej. Finalny zakres i cenę
          potwierdzamy po ustaleniu modelu i warunków montażu.
        </p>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container related-links" data-reveal>
      <p>Zobacz też:</p>
      <a class="text-link" href="/uslugi">Co dokładnie obejmuje montaż</a>
      <a class="text-link" href="/porady/ile-kosztuje-montaz-klimatyzacji">Ile kosztuje montaż klimatyzacji w 2026 - pełny poradnik</a>
      <a class="text-link" href="/faq">Najczęstsze pytania o montaż</a>
    </div>
  </section>
</Layout>

<style>
  .pricing-models-jump {
    margin-top: 0;
  }

  .pricing-models-section {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  .additional-services-table {
    min-width: 0;
    table-layout: fixed;
  }

  .additional-services-table th:last-child,
  .additional-services-table td:last-child {
    width: 36%;
  }

  .additional-services-description {
    max-width: 72ch;
    margin-top: 1.25rem;
  }

  .additional-service-content {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
  }

  .service-guide-link {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .individual-pricing {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 479.98px) {
    .additional-services-table th,
    .additional-services-table td {
      padding-inline: 0.75rem;
    }

    .additional-services-table th:last-child,
    .additional-services-table td:last-child {
      width: 42%;
    }
  }
</style>
