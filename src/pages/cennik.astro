---
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { BUSINESS, CONTACT_PHONE } from '../config/site';
import { pageMeta } from '../i18n/content';

const meta = pageMeta.pl.pricing;
---

<Layout
  lang="pl"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/cennik"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">Cennik</p>
      <h1>{BUSINESS.pricing.installationService.name.pl}</h1>
      <p>{BUSINESS.pricing.installationService.fullDescription.pl}</p>
    </div>
  </section>

  <section class="section">
    <div class="container pricing-panel" data-reveal>
      <p class="price-main">
        {BUSINESS.pricing.installationService.name.pl}: {BUSINESS.pricing.label.pl} — {BUSINESS.pricing.installationService.baseVariantLabel.pl}
      </p>
      <ul class="bullet-list">
        <li>{BUSINESS.pricing.installationService.complexPriceDescription.pl}</li>
        <li>{BUSINESS.travel.note.pl}</li>
        <li>Brak formularzy: najkrótsza droga do wyceny to telefon.</li>
      </ul>
      <p class="tiny-note">{BUSINESS.pricing.taxNote.pl}</p>
      <CTAButton href={CONTACT_PHONE.href} label="Zadzwoń po wycenę" ariaLabel="Zadzwoń po wycenę" />
    </div>
  </section>
</Layout>
