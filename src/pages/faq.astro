---
import CTAButton from '../components/CTAButton.astro';
import Layout from '../components/Layout.astro';
import { BUSINESS, CONTACT_PHONE } from '../config/site';
import { pageMeta } from '../i18n/content';

const meta = pageMeta.pl.faq;
---

<Layout
  lang="pl"
  title={meta.title}
  description={meta.description}
  keywords={meta.keywords}
  currentPath="/faq"
>
  <section class="page-hero">
    <div class="container" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h1>Najczęściej zadawane pytania</h1>
      <p>Krótko i konkretnie: jak wygląda wycena, montaż i serwis.</p>
    </div>
  </section>

  <section class="section">
    <div class="container faq-list" data-reveal>
      <details class="faq-item">
        <summary>Ile trwa montaż split?</summary>
        <p>Zwykle około 1 dnia roboczego. Czas zależy od warunków technicznych i długości instalacji.</p>
      </details>

      <details class="faq-item">
        <summary>Czy dojazd jest dodatkowo płatny?</summary>
        <p>{BUSINESS.travel.note.pl}</p>
      </details>

      <details class="faq-item">
        <summary>Jak wyceniacie bardziej złożone montaże?</summary>
        <p>{BUSINESS.pricing.installationService.complexPriceDescription.pl}</p>
      </details>

      <details class="faq-item">
        <summary>Jaka jest gwarancja?</summary>
        <p>{BUSINESS.warranty.description.pl}</p>
      </details>

      <details class="faq-item">
        <summary>Czy oferujecie przeglądy i czyszczenie?</summary>
        <p>Tak, wykonujemy serwis podstawowy i czyszczenie urządzeń split.</p>
      </details>

      <details class="faq-item">
        <summary>Jak uzyskać wycenę?</summary>
        <p>Zadzwoń, aby omówić montaż i ustalić, czy potrzebne są oględziny.</p>
      </details>
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal>
      <CTAButton href={CONTACT_PHONE.href} label="Zadzwoń po wycenę" ariaLabel="Zadzwoń po wycenę" />
    </div>
  </section>
</Layout>
